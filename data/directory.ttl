    schema:name "KiFaZ Wilde Hilde - IN VIA Kinder- und Familienzentrum";
    schema:email "Kita@invia-drs.de";
    schema:telephone "+4971122046922", "+4971124893156";
    schema:mainEntityOfPage "https://www.caritas.de/adressen/74178";
