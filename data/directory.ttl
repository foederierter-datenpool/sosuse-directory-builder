    schema:name "Katholischer Kindergarten St. Nikolaus";
    schema:email "kita.nassenfels@bistum-eichstaett.de";
    schema:telephone "+498424492";
    schema:mainEntityOfPage "https://www.caritas.de/adressen/87170";
