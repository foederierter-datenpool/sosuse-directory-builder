    schema:name "Kirchliche Sozialstation Schramberg gGmbH";
    schema:email "info@kirchl-sozialstation-schramberg.de";
    schema:telephone "+4974223134";
    schema:mainEntityOfPage "https://www.caritas.de/adressen/75678";
