    schema:name "Katholische Kindertageseinrichtung „St. Josef“";
    schema:email "birgit.gatzemeier@st-martin-caritas.de";
    schema:telephone "+493602350930";
    schema:mainEntityOfPage "https://www.caritas.de/adressen/106701";
