    schema:name "Caritas Rheine - Psychologische Beratungsstelle / Erziehungsberatungsstelle";
    schema:email "erziehungsberatung@caritas-rheine.de";
    schema:telephone "+495971862261";
    schema:mainEntityOfPage "https://www.caritas.de/adressen/91608";
