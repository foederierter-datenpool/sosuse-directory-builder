    schema:name "Caritasverband Nordhessen-Kassel e. V.";
    schema:email "johanna.kloss@caritas-kassel.de";
    schema:telephone "+495617004224";
    schema:mainEntityOfPage "https://www.caritas.de/adressen/81700";
