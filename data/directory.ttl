    schema:name "Caritas-Kindergarten Bennolino Spremberg";
    schema:email "kiga.bennolino@caritas-goerlitz.de";
    schema:telephone "+493563345969";
    schema:mainEntityOfPage "https://www.caritas.de/adressen/72499";
