    schema:name "Caritas-Region Cottbus";
    schema:email "jugendsozialarbeit.luebben@caritas-goerlitz.de";
    schema:telephone "+4935463040";
    schema:mainEntityOfPage "https://www.caritas.de/adressen/109967";
