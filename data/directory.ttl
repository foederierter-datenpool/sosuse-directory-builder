    schema:mainEntityOfPage "https://www.dhs.de/service/suchthilfeverzeichnis/?tx_wwdhseinrichtung2_fe1%5Baction%5D=show&tx_wwdhseinrichtung2_fe1%5Bcontroller%5D=Entry&tx_wwdhseinrichtung2_fe1%5Bentry%5D=5106&cHash=f8c276f28603b807ecf16261e14b5d5b";
    schema:address cdf:addr-82fd71867b78;
    dct:modified "2026-03-11T13:42:13+00:00";
    schema:alternateName "Medizinische Rehabilitationseinrichtung für Männer mit substanzbezogenen Störungen";
    foaf:homepage "http://www.fachklinik-nettetal.de", "www.fachklinik-nettetal.de";
    schema:category "Stationäre Rehabilitationseinrichtung";
    schema:openingHours "7:00 - 23:00 Uhr (Nachtruhe 23:00-7:00 Uhr, telefonische Bereitschaft gegeben)";
    schema:availableService "Beratung für Angehörige, Elternarbeit (Angebote für Eltern suchtkranker Kinder), Paartherapie, Stationäre Entwöhnungsbehandlung, Ambulante Formen des Betreuten Wohnens, Substitutionsbehandlung, Adaption, Kombibehandlung, Qualifizierung / Arbeitsförderung / Beschäftigung";
    schema:accessibilitySummary "Die Einrichtung ist barrierefrei erreichbar.";
    cdf:parentOrgClassification "Freie Wohlfahrtspflege / gemeinnütziger Träger";
    schema:audience "Illegalen Drogen";
    schema:description "Indikation:\n\n  Abhängigkeitserkrankungen (illegale Drogen, Medikamenten, Alkohol) für Männer ab 18 Jahre    \n\nBettenzahl:\n\n  37 Betten     verfügbare\nPlätze:  \n\n(wird erst revelant, wenn die Pflege der Einträge durch die Einrichtungen erfolgen kann)\n\n   \n\nBehandlungsdauer:\n\n  Je nach Indikationstellung unbefristet bzw. gem. Kostenzusage des zuständigen Sozialhilfeträgers    \n\nAufnahme-\nbedingungen:\n\n  abgeschlossene Entgiftung, gültige Kostenzusage, geklärte juristische Situation    \n\nBesonderheiten:\n\n  Psychosen, Persönlichkeits- u. Angststörungen, Depression, Trauma, Delinquenz, organische Folgeerkankungen, Cannabis-Behandlung Nikotinabhängigkeit, kognitive Defizite Individuelles Behandlungsangebot in Entwöhnungs- u. Rückfallbehandlung, Kombibehandlung, substitutionsgestützte Behandlung, Behandlung: \"Sucht und Psychose\" im Reha- Verbund, Anschlussbehandlung und Nachsorge, ambulante Weiterbehandlung, Anerkennung gemäß §35/36 BtmG, §64 StGB, zertifiziert durch proCum Cerna nach DIN EN ISO 9001: 2000    \n\nKosten- und\nLeistungsträger:\n\n  Federführung: Deutsche Rentenversicherung Braunschweig-Hannover, Deutsche Rentenversicherung Regional, Versorgungsvertrag mit den gesetzlichen Krankenkassen (GKV), Sozialhilfeträger, Beihilfeträger     Ansprechpartner:  \n\nEinrichtungsleitung:\nDirk Laßeur (Klinikmanager, Tel.: 0541/40892-)\nChefärztin: Dr. med. Elke Sylvester (Tel.: 0541/40892-0)\nAufnahmebereich: Yvonne Bietendorf (Tel.: 0541 40892-0)".
cdf:org-d956328af67c a <http://www.w3.org/ns/org#OrganizationalUnit>;
