    schema:name "Katholisches Altenpflegeheim St. Marien";
    schema:email "bitterfeld@caritas-bistum-magdeburg.de";
    schema:telephone "+49349337650";
    schema:mainEntityOfPage "https://www.caritas.de/adressen/72690";
