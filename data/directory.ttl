    schema:name "Katholisches Kinderhaus Heilige Familie Obermässing";
    schema:email "kita.obermaessing@bistum-eichstaett.de";
    schema:telephone "+498469785";
    schema:mainEntityOfPage "https://www.caritas.de/adressen/97781";
