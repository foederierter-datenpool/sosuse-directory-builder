    schema:name "Caritasverband für den Kreis Coesfeld e. V.";
    schema:email "sozialstation.senden@caritas-coesfeld.de";
    schema:telephone "+492597692546";
    schema:mainEntityOfPage "https://www.caritas.de/adressen/211792";
