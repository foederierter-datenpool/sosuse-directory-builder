,[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/72373",[]]]],["schema:address",[[["cdf:addr-6ba350166922"],[]]]],["dct:modified",[["2026-09-30T12:08:37+00:00",[]]]],["foaf:homepage",[["www.familienpflege-stuttgart.de",[]]]],["schema:openingHours",[["Montag bis Donnerstag 8.30 Uhr bis 16.00 Uhr\r\nFreitag 8.30 Uhr bis 14 Uhr",[]]]],["schema:description",[["Die Familienpflege - auch bekannt unter dem Namen Haushaltshilfe - kommt immer dann zum Einsatz, wenn die Versorgung der Kinder und die Haushaltsführung aufgrund einer Notsituation nicht mehr selbst gewährleistet werden kann. Solche Notsituationen können beispielsweise Krankheit, Rehabilitation, Tod oder Trennung, Überlastung, Überforderung oder psychosoziale Probleme der Eltern sein.\n\nWir legen besonderen Wert auf pädagogisch qualifiziertes Personal. Die Sorge um die Kinder und deren Wohlergehen sind für uns und die Familie von großer Wichtigkeit.\n\nIn folgenden Bereichen ist die Familienpflegerin eine große Entlastung für Sie:\n\n * Säuglingspflege\n * Spiel- und Freizeitgestaltung mit Kindern\n * Wegebegleitung der Kinder (z.B. Kita, Schule, Sport)\n * Reinigung der Wohnung\n * Wäschepflege\n * Einkauf\n * Zubereitung der Mahlzeiten",[]]]]]],["cdf:org-cbb1ffa1089b",0,[],[["schema:name",[["Caritas Kita St. Gotthard",[]]]],["schema:email",[["kita.kirchberg-im-wald@caritas-passau.de",[]]]],["schema:telephone",[["+4999278109",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/103109",[]]]],["schema:address",[[["cdf:addr-16262bd2a376"],[]]]],["dct:modified",[["2026-03-17T06:49:58+00:00",[]]]],["foaf:homepage",[["http://www.caritas-kita-kirchberg-im-wald.de",[]]]],["schema:description",[["Weitere Informationen zur Caritas Kita St. Gotthard in Kirchberg finden Sie bald auf unserer Internetseite.",[]]]]]],["cdf:org-cbb22ed15167",0,[],[["schema:name",[["Kirchengemeinde Maria, Hilfe der Christen",[]]]],["schema:telephone",[["+49211591295",[]]]],["schema:mainEntityOfPage",[["https:/