[["cdf:org-cb655327ee49",0,[],[["schema:name",[["Bildungsstätte St. Gunther",[]]]],["schema:email",[["Sekretariat@st-gunther-cham.de",[]]]],["schema:telephone",[["+49997185260",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/94067",[]]]],["schema:address",[[["cdf:addr-f6fbb3732e25"],[]]]],["dct:modified",[["2025-08-20T18:49:26+00:00",[]]]],["schema:alternateName",[["Schulvorbereitende Einrichtung (SVE)",[]]]],["foaf:homepage",[["http://www.st-gunther-cham.de",[]]]]]],["cdf:org-cb67bb07248a",0,[],[["schema:name",[["Psychiatrisches Pflegeheim St. Elisabeth-Stift",[]]]],["schema:email",[["zietek-a@elisabeth-stift.de",[]]]],["schema:telephone",[["+4944729500",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/98549",[]]]],["schema:address",[[["cdf:addr-847187a663bf"],[]]]],["dct:modified",[["2020-10-13T07:55:31+00:00",[]]]],["foaf:homepage",[["http://www.Elisabeth-Stift.de",[]]]],["schema:description",[["WOHNEN MIT ATMOSPHÄRE\n\nUnser Pflegeheim bietet Platz für 63 Bewohnerinnen und Bewohner. Wir verfügen überwiegend über Einzelzimmer. Bei einer Unterbringung im\n\nZweibettzimmer schauen wir sensibel genau, welche Menschen miteinander auskommen und berücksichtigen die Wünsche. Alle Zimmer sind mit direkter Sanitäranbindung. Selbstverständlich gestalten die Bewohnerinnen und Bewohner Ihr Zimmer nach Ihren Wünschen und können einzelne liebgewonnene Möbel und Gegenstände mitbringen.\n\nRundum Pflege und Betreuung\n\nUnser multiprofessionelles Mitarbeiterteam besteht aus in der Alten- und in der psychiatrischen Pflege erfahrenen Fachkräften. In einer kleinen, familienähnlichen Gemeinschaft bzw. Wohngruppe haben die Bewohnerinnen und Bewohner feste Bezugspersonen und eine 24-Stunden-Betreuung.\n\nIn der Begleitung konzentrieren wir uns auf:\n\n\n\n * die psychische und körperliche Stabilisierung\n * eine ressourcenorientierte Betreuung und Pflege\n * die Förderung und Unterstützung der Entwicklung\n\n\n\nUns ist es wichtig, den Menschen dort abzuholen, wo er gerade ist, d.h. mit Geduld und Einfühlungsvermögen auf die individuelle Situation einzugehen. Wir bieten eine umfangreiche Arbeits- und Beschäftigungstherapie und setzen zur Stärkung der Sinneswahrnehmung u.a. auch auf Fußreflexzonenmassage und Klangmassage.\n\nDie medizinische Versorgung über Fachärzte erfolgt auch in Zusammenarbeit mit der Abteilung für Psychiatrie und Psychotherapie des Christlichen Krankenhauses in Quakenbrück. Die hausärztliche Versorgung erfolgt über die Hausärzte in Lastrup und der Region. Für die Sterbebegleitung haben wir ein besonderes Konzept. Wir arbeiten eng mit den Angehörigen, gesetzlichen Betreuern und dem Sozialdienst zusammen",[]]]]]],["cdf:org-cb686b9bff7f",0,[],[["schema:name",[["Kath. Kirchenstiftung Maria unterm Kreuz",[]]]],["schema:email",[["pg.koenigsbrunn@bistum-augsburg.de",[]]]],["schema:telephone",[["+49823196510",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/108760",[]]]],["schema:address",[[["cdf:addr-a80d34738eab"],[]]]],["dct:modified",[["2018-03-16T12:07:23+00:00",[]]]],["foaf:homepage",[["www.katholisch-in-koenigsbrunn.de",[]]]]]],["cdf:org-cb6b2a41623b",0,[],[["schema:name",[["pro juve Caritas Jugendhilfe Hochrhein gemeinnützige GmbH",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/1716211",[]]]],["schema:address",[[["cdf:addr-3b4d732e2414"],[]]]],["dct:modified",[["2020-06-18T11:31:56+00:00",[]]]],["schema:alternateName",[["Außenstelle Rickenbach",[]]]]]],["cdf:org-cb6cd84ae905",0,[],[["schema:name",[["Caritasverband im Dekanat Ahaus-Vreden e. V.",[]]]],["schema:telephone",[["+4925619160",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/108406",[]]]],["schema:address",[[["cdf:addr-c0515386d879"],[]]]],["dct:modified",[["2020-05-04T10:45:25+00:00",[]]]],["schema:alternateName",[["Caritas-Seniorenheim Holthues Hoff - Betreutes Wohnen",[]]]]]],["cdf:org-cb6cf6b05c4f",0,[],[["schema:name",[["Katholisches Krankenhaus Hagen gem.GmbH",[]]