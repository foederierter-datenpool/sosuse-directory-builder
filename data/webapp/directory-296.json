"schema:email",[["cottbus@caritas-goerlitz",[]]]],["schema:telephone",[["+4935538003732",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/2947536",[]]]],["schema:address",[[["cdf:addr-6186ddf6ada1"],[]]]],["dct:modified",[["2026-01-21T06:44:33+00:00",[]]]],["schema:alternateName",[["Helferkreis Demenz",[]]]],["foaf:homepage",[["https://www.caritas-goerlitz.de/angebote/senioren-und-pflege/hilfen-bei-demenz/hilfen-bei-demenz",[]]]],["schema:description",[["Helferkreis Demenz\n\nSie pflegen einen Angehörigen, der an einer Demenz erkrankt ist?\n\nZur Entlastung können wir Ihnen geschulte ehrenamtliche Heferinnen und Helfer anbieten, die Sie bei dieser Aufgabe unterstützen, z.B. durch:\n\n * Spazieren gehen, Begleitung zum Frisör, Konzerte\n * Zeitungen vorlesen, Unterhaltungen, Fotos anschauen\n * spielen, singen, musizieren\n * gemeinsame Gartenarbeit, Plätzchen backen\n * alles, was Ihrem Angehörigen gut tut und Sie entlastet\n\nDieser Dienst ist ein gestzlich verankertes Angebot nach § 45 a SGB XI und kann über die Pflegekassen erstattet werden.\n\nAnsprechpartnerin:\n\nFrau Katja Weidmüller\nTel.Nr.: +49 355 38 00 37 32\nE-Mail: katja.weidmueller@caritas-goerlitz.de",[]]]]]],["cdf:org-ca2a11ae4e78",0,[],[["schema:name",[["Caritas Schwarzwald-Gäu Zentrum Tübingen",[]]]],["schema:email",[["tuebingen@caritas-dicvrs.de",[]]]],["schema:telephone",[["+49707179620",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/1034855",[]]]],["schema:address",[[["cdf:addr-6349a5b6ae37"],[]]]],["dct:modified",[["2025-12-03T10:50:50+00:00",[]]]],["schema:alternateName",[["Flüchtlingshilfe",[]]]],["foaf:homepage",[["www.caritas-schwarzwald-gaeu.de",[]]]]]],["cdf:org-ca2f60bb9b1e",0,[],[["schema:name",[["Kath. Kindergarten St.Klara",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/89172",[]]]],["schema:address",[[["cdf:addr-4913a6735b5e"],[]]]],["dct:modified",[["2011-11-10T11:10:37+00:00",[]]]]]],["cdf:org-ca324b300337",0,[],[["schem