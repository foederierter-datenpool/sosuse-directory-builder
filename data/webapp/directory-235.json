mainEntityOfPage",[["https://www.caritas.de/adressen/95014",[]]]],["schema:address",[[["cdf:addr-1657a52df950"],[]]]],["dct:modified",[["2018-03-11T21:06:03+00:00",[]]]]]],["cdf:org-a08e29eeec95",0,[],[["schema:name",[["Caritasverband Südniedersachsen e.V.",[]]]],["schema:email",[["info@caritas-suedniedersachsen.de",[]]]],["schema:telephone",[["+495527981384",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/1891284",[]]]],["schema:address",[[["cdf:addr-c86bb6756753"],[]]]],["dct:modified",[["2024-09-20T10:34:44+00:00",[]]]],["schema:alternateName",[["Allgemeine Lebens- und Sozialberatung",[]]]],["foaf:homepage",[["https://caritas-suedniedersachsen.de/",[]]]],["schema:description",[["Die Allgemeine Lebens- und Sozialberatung steht Menschen aller Nationalitäten, aller Glaubensrichtungen und Weltanschauungen offen.\n\nWir sind für Sie da, wenn Sie:\n\n * sich einsam und überfordert fühlen,\n * von einem lebensverändernden Ereignis aus der Bahn geworfen worden sind,\n * nicht wissen, wie Sie finanziell über die Runden kommen können,\n * Mühe haben, Ihren SGB II- oder SGB XII-Bescheid zu verstehen,\n * sozialrechtliche Unterstützung bei Anträgen oder im Umgang mit Behörden brauchen,\n * Ihre Probleme aktiv anpacken möchten.\n\nUnser kostenloses Angebot:\n\n * wir hören aufmerksam zu,\n * Sie und Ihre Situation stehen im Mittelpunkt,\n * wir suchen gemeinsam nach Ihren Zielen und möglichen Wegen dorthin,\n * wir stellen unser sozialrechtliches Fachwissen zur Verfügung,\n * wo möglich und nötig vermitteln wir finanzielle Hilfen,\n * wir bieten Ihnen unsere Begleitung und Unterstützung an,\n * wir halten uns an unsere Schweigepflicht,\n * wenn nötig, vermitteln wir an spezialisierte Beratungsdienste weiter, wie beispielsweise Migrationsberatung, Suchtberatung, Schuldnerberatung und andere.\n\nKontakt\n\nCaritas-Kotaktstelle Duderstadt\nMichaela Krebs\nTel.: 0 55 27 / 98 13-84\nMobil: 0171 / 48 77 527\nE-Mail: krebs@caritas-suedniedersachsen.de\n\nCaritas-Centrum St. Godehard Göttingen\n\nMaria Weiss\nDiplom Sozialpädagogin\nTel.: 05 51 / 999 59-14\nE-Mail: weiss@caritas-suedniedersachsen.de\n\nCaritas-Centrum Herzberg am Harz\nTina Hallemann\nTel.: 0 55 21 / 9 99 72-72\nE-Mail: hallemann@caritas-suedniedersachsen.de\n\nCaritas-Centrum Northeim - Familienbüro -\n\nMathilde Henke\n\nTel.: 0 55 51 / 9 96 83-10\n\nE-Mail: henke@caritas-suedniedersachsen.de                                                                    \n\n \n\nOnline-Beratung\n\nSie können sich auch online an die Beraterinnen unserer Beratungsstelle wenden. Über die Online-Beratung haben Sie die Möglichkeit, einen sicheren, verschlüsselten und anonymen Dialog zu beginnen.",[]]]]]],["cdf:org-a08f8b67f266",0,[],[["schema:name",[["Caritasverband für die Stadt und den Landkreis Bayreuth",[]]]],["schema:telephone",[["+49921789020",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/79335",[]]]],["schema:address",[[["cdf:addr-c7a05c4bf9d5"],[]]]],["dct:modified",[["2009-08-19T13:40:14+00:00",[]]]],["schema:description",[["Schuldnerberatung als eigenständiger (spez.) Fachdienst",[]]]]]],["cdf:org-a08ff4e93f6a",0,[],[["schema:name",[["Berufsbegleitender Dienst im Landkreis Breisgau-Hochschwarzwald",[]]]],["schema:telephone",[["+4976339580727",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/103500",[]]]],["schema:address",[[["cdf:addr-e80c1ec803e3"],[]]]],["dct:modified",[["2011-11-10T11:27:01+00:00",[]]]],["schema:alternateName",[["Fachdienst für psychisch kranke und schwerbehinderte Arbeit-nehmer(innen)",[]]]]]],["cdf:org-a0908e9da518",0,[],[["schema:name",[["Vinzenz Pflege gGmbH",[]]]],["schema:email",[["info@vinzenz-von-paul.de",[]]]],["schema:telephone",[["+4971616195130",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/84197",[]]]],["schema:address",[[["cdf:addr-0418f8ff45e5"],[]]]],["dct:modified",[["2025-03-04T08:22:08+00:00",[]]]],["foaf:homepage",[["www.vinzenz-von-paul.de",[]]]],["schema:descr