"http://www.katholische-kita-rostock.de",[]]]],["schema:description",[["Katholische Kindertagesstätte St. Martin",[]]]]]],["cdf:org-00499b270f9a",0,[],[["schema:name",[["Haus Johannes Wohnheim für Menschen mit Behinderung",[]]]],["schema:email",[["haus-johannes@caritas-freiburg.de",[]]]],["schema:telephone",[["+49 (07663) 913070",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/111030",[]]]],["dct:modified",[["2025-08-20T16:38:50+00:00",[]]]],["schema:address",[[["cdf:addr-715b93e9bc9c"],[]]]],["foaf:homepage",[["www.caritas-freiburg.de",[]]]],["schema:description",[["Haus Johannes Wohnheim für Menschen mit Behinderung",[]]]]]],["cdf:org-0049a1f88a43",0,[],[["schema:name",[["Caritasverband Trier e. V.",[]]]],["schema:email",[["suchtkrankenhilfe@caritas-region-trier.de",[]]]],["schema:telephone",[["+49 (0651) 145395-0",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/86960",[]]]],["dct:modified",[["2025-08-20T19:18:01+00:00",[]]]],["schema:address",[[["cdf:addr-ab4fb891b49e"],[]]]],["schema:alternateName",[["Frauenspezifische Suchtberatung und -behandlung",[]]]],["foaf:homepage",[["http://www.caritas-region-trier.de",[]]]],["schema:description",[["Die Ursachen einer Suchterkrankung sind so vielfältig wie das Krankheitsbild selbst. Deshalb beraten und behandeln wir in unserer Fachambulanz für Suchtkranke und Angehörige jeden Menschen individuell bei Problemen mit Suchtmitteln (wie Alkohol, Medikamente, Drogen) und mit Suchtverhalten (wie Essstörungen, Internet- /Spielsucht).\n\nSuchtmittel auszuprobieren und regelmäßig zu konsumieren, scheint in unserer Gesellschaft normal. Nicht jeder wird von ihnen abhängig. Aber es kann trotzdem zu Schwierigkeiten kommen - auf der Arbeit, in der Familie, im Freundeskreis, in Schule oder Ausbildung. Die Fahrerlaubnis kann entzogen werden oder es kommt zu unerwünschten Kontakten mit Polizei und Justiz.\n\nUnser Beratungsangebot ist offen für einzelne, Familien, Eltern, Paare, Alleinerziehende, Jugendliche sowie Fachkräfte aus dem psychosozialen und pädagogischen Bereich.\n\nUnsere Beratung ist vertraulich und anonym.\n\nAngehörige, Partner und Freunde, die sich oft lange vergeblich bemüht haben, dem Betroffenen zu helfen, sind häufig erschöpft, niedergeschlagen und selbst hilfebedürftig. Auch ihnen helfen wir.\n\nUnsere Angebote:\n\n * offene Sprechstunde\n * allgemeine Beratung\n * frauenspezifische Suchtberatung\n * ambulante Behandlung\n * Rehabiliation\n * Externe Angebote\n * Informationsveranstaltungen zur Suchtprävention",[]]]]]],["cdf:org-0049f1cbb839",0,[],[["schema:name",[["Kath. Kindergarten St. Josef",[]]]],["schema:email",[["St-Josef.Glonn@kita.ebmuc.de",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/73369",[]]]],["dct:modified",[["2025-08-20T17:49:44+00:00",[]]]],["schema:address",[[["cdf:addr-1a110e445ce8"],[]]]],["foaf:homepage",[["https://www.erzbistum-muenchen.de/kinder/kitas/kindergarten-st-josef-glonn",[]]]],["schema:description",[["Kath. Kindergarten St. Josef",[]]]]]],["cdf:org-004d231548e8",0,[],[["schema:name",[["Kath. Kirchenstiftung Zu Unserer Lieben Frau",[]]]],["schema:email",[["pg.donauwoerth@bistum-augsburg.de",[]]]],["schema:telephone",[["+49 (09067) 06280",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/91603",[]]]],["dct:modified",[["2026-07-14T05:48:29+00:00",[]]]],["schema:address",[[["cdf:addr-c59759f3467b"],[]]]]]],["cdf:org-00504b831a28",0,[],[["schema:name",[["Caritasverband Herne e. V.",[]]]],["schema:email",[["tagespflege@caritas-herne.de",[]]]],["schema:telephone",[["+49 (02323) 92960-464",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/2218244",[]]]],["dct:modified",[["2025-08-20T18:19:46+00:00",[]]]],["schema:address",[[["cdf:addr-b504b4764d4c"],[]]]],["schema:alternateName",[["Caritas-Tagespflege St. Barbara",[]]]],["foaf:homepage",[["www.caritas-herne.de",[]]]]]],["cdf:org-0051cf66a389",0,[],[["schema:name",[["Ignatius-Lötschert-Haus GmbH -  Barmherzig