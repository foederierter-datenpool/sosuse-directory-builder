df:addr-dfdf7b7ebe92"],[]]]],["dct:modified",[["2026-02-13T13:46:29+00:00",[]]]],["schema:alternateName",[["Caritas-Pflegedienst Senden",[]]]],["foaf:homepage",[["https://www.caritas-coesfeld.de/pflegedienst",[]]]],["schema:description",[["Ambulante Pflege für mehr Sicherheit zu Hause\n\nDie Caritas-Sozialstationen bieten umfassende Pflegeleistungen für alle Altersgruppen, damit Menschen in ihrer gewohnten Umgebung individuell betreut werden. Suchen Sie nach ambulanter Pflege? Wir bieten eine bestmögliche Unterstützung für Sie und Ihre Angehörigen.\n\n\nUNSER ANGEBOT\n\nWir unterstützen Pflegebedürftige und ihre Angehörigen individuell. Wer im Krankheits- oder Pflegefall in der gewohnten Umgebung bleiben möchten, Versorgungssicherheit wünscht, die eigene Selbstständigkeit erhalten oder wiedererlangen möchte, findet mit uns den richtigen Ansprechpartner:\n\n\nCARITAS-PFLEGEDIENST SENDEN\n\nDer Caritas‑Pflegedienst Senden bietet persönliche, zugewandte Pflege für pflegebedürftige Menschen in Senden und Ascheberg. Pflegebedürftige und ihre Angehörigen finden hier kompetente Ansprechpartner*innen für ambulante Pflege, Beratung und alltagsunterstützende Angebote.",[]]]]]],["cdf:org-99aec15e4c2a",0,[],[["schema:name",[["Bildungsstätte St. Gunther",[]]]],["schema:email",[["g.jobst@ifs-cham.de",[]]]],["schema:telephone",[["+499971200340",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/103475",[]]]],["schema:address",[[["cdf:addr-2e0a8d807f9f"],[]]]],["dct:modified",[["2025-08-20T18:49:01+00:00",[]]]],["schema:alternateName",[["Interdisziplinäre Frühförderstelle",[]]]],["foaf:homepage",[["www.fruehfoerderung-cham.de",[]]]]]],["cdf:org-99afec81c0ec",0,[],[["schema:name",[["Sozialdienst Kath.Männer Landsberg e. V.",[]]]],["schema:telephone",[["+49819121344",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/98039",[]]]],["schema:address",[[["cdf:addr-597c40d69d0f"],[]]]],["dct:modified",[["2009-08-19T13:51:33+00:00",[]]]]]],["cdf:org-99b1fc