nerberatung",[]]]],["schema:address",[[["cdf:addr-c1a6f635d22d"],[]]]]]],["cdf:org-6ef6ca8f96b6",0,[],[["schema:name",[["Kath. Kirchengemeinde St. Vitus Kronberg-Oberhöchstadt",[]]]],["schema:telephone",[["+49617363497",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/87892",[]]]],["schema:address",[[["cdf:addr-9b3c39ee275d"],[]]]],["dct:modified",[["2018-03-11T18:28:15+00:00",[]]]]]],["cdf:org-6ef701fcbc99",0,[],[["schema:name",[["GPZ - Wohnheim Soestenstraße CLP",[]]]],["schema:email",[["dietmar.petersen@kk-om.de",[]]]],["schema:telephone",[["+494471916544",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/83004",[]]]],["schema:address",[[["cdf:addr-0c0ede7ec748"],[]]]],["dct:modified",[["2025-06-20T10:26:55+00:00",[]]]],["schema:alternateName",[["Gemeindepsychiatrisches Zentrum",[]]]],["foaf:homepage",[["www.kh-clp.de",[]]]],["schema:description",[["Das Gemeindepsychiatrische Zentrum des St.-Josef-Stifts in Cloppenburg mit seinen insgesamt 86 Plätzen für Menschen mit einer psychischen Erkrankung hält Angebote im Bereich Wohnen und Tagesstrukturierung vor.\nDas Wohnheim bietet intensivste Betreuung für schwerstpsychisch kranke Frauen und Männer. Im Übergangs- und Langzeitwohnheim finden Menschen ein Zuhause, die unter Anleitung eine möglichst eigenverantwortliche Lebensführung erlangen möchten. Das Wohnen in der Außenwohngruppe bietet lebenspraktisches Training mit größter Eigenverantwortlichkeit. Es ist als Phase zwischen Wohnheimbetreuung und ambulanter Unterstützung gedacht.\nDie Ambulante Wohnbetreuung bietet eine begleitende Hilfe in der Privatwohnung des Betroffenen. Im Rahmen der Tagesstätte für seelisch behinderte Menschen erfahren sie Möglichkeiten der Tagesstrukturierung in Form von gezielten Beschäftigungsangeboten. Weitere Angebote des GPZ: eine ergotherapeutische Praxis, ein Tagescafe und die Möglichkeit zur Arbeitserprobung auf dem Niels-Stensen-Hof.",[]]]]]],["cdf:org-6ef762d29f51",0,[],[["schema:name",[["CAB gGm