fied",[["2025-08-20T19:07:13+00:00",[]]]],["foaf:homepage",[["www.sozialstation-jagsttal.de",[]]]],["schema:description",[["Wir erbringen Leistungen für Menschen in deren häuslicher Umgebung und tragen damit wesentlich dazu bei, Lebensqualität und vertraute Umgebung so lange wie möglich zu erhalten.\n\nDas jeweilige Pflegeprogramm stellen wir individuell nach Ihren Bedürfnissen zusammen. Dabei lassen sich unterschiedliche  Leistungsmodule miteinander kombinieren - zum Beispiel die \"Grundpflege\", die Hauswirtschaftliche Versorgung\" und die\n\"Ärztlich verordnete Behandlungspflege\".\nTragende Säulen unseres Pflegekonzepts sind neben der konsequenten Patientenorientierung der enge Austausch mit Angehörigen und Bezugspersonen und die kontinuierliche Abstimmung mit Ärzten und Krankenhäusern.\n\nGerne beraten wir Sie eingehend in einem persönlichen Gespräch.\n\nDie Abrechnung der Leistungen erfolgt größtenteils über die jeweiligen Kranken- und/oder Pflegekassen.",[]]]]]],["cdf:org-bd0f8d345832",0,[],[["schema:name",[["Schmallenbach-Verbund GmbH",[]]]],["schema:email",[["info@schmallenbach-haus.de",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/94890",[]]]],["schema:address",[[["cdf:addr-80aa1b9c604f"],[]]]],["dct:modified",[["2026-02-24T14:07:02+00:00",[]]]],["schema:alternateName",[["Ambulanter Dienst zu Hause",[]]]],["foaf:homepage",[["www.schmallenbach-haus.de",[]]]]]],["cdf:org-bd114ab3d877",0,[],[["schema:name",[["Kath. Kindertagesstätte St. Foillan",[]]]],["schema:email",[["kita@foillan-aachen.de",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/107722",[]]]],["schema:address",[[["cdf:addr-04cfe7a8eece"],[]]]],["dct:modified",[["2025-06-06T11:57:28+00:00",[]]]],["schema:description",[["Kath. Kindergarten St. Foillan",[]]]]]],["cdf:org-bd124053160b",0,[],[["schema:name",[["Caritasverband für die Regionen Aachen-Stadt und Aachen-Land e.V.",[]]]],["schema:email",[["info@caritas-aachen.de",[]]]],["schema:telephone",[["+49241477830",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/109473",[]]]],["schema:address",[[["cdf:addr-11ebb5878b04"],[]]]],["dct:modified",[["2025-05-27T09:31:04+00:00",[]]]],["foaf:homepage",[["www.caritas-aachen.de",[]]]],["schema:openingHours",[["Öffnungszeiten der Geschäftsstelle: \nmontags bis donnerstags 8.00 bis 16.00 Uhr, freitags bis 14.00 Uhr\n",[]]]],["schema:description",[["Not sehen und Handeln. Das ist unser christlicher Anspruch! Daran lassen wir uns messen!\n\nWir beobachten genau in einer Zeit von wachsender Armut, Arbeitslosigkeit sowie Heimat- und Bindungslosigkeit die soziale Landschaft in unserer StädteRegion Aachen.\n\nDieser Blick wendet sich sehr konzentriert auf die verschiedenen Notlagen betroffener Menschen und sucht nach Lösungen. Lösungen, die den Menschen Perspektiven bieten.\n\nWir pflegen Kranke ganzheitlich, möchten Schmerzen lindern und begleiten sie bis zum Lebensende.\n\nUnsere hauptamtlichen Fachkräfte und engagierten Ehrenamtlichen entwerfen kompetente Konzepte und setzen diese mit Sorgfalt, Kreativität und hohem persönlichen Einsatz um.\n\nIn unserem Regionalverband arbeiten ca. 450 Mitarbeitende für knapp 500.000 Menschen in der StädteRegion.\n\nGemeinsam mit unserer Tochter, der Aachener Caritasdienste gGmbH, die unsere stationären Pflegeeinrichtungen führt, sind wir somit Arbeitgeber von ca. 1000 Kolleginnen und Kollegen.\n\nUnsere vielfältigen Angebote finden Sie unter:\n\nwww.caritas-aachen.de",[]]]]]],["cdf:org-bd146c759aee",0,[],[["schema:name",[["Kath. Pfarramt St. Stephan",[]]]],["schema:telephone",[["+4989466819",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/87866",[]]]],["schema:address",[[["cdf:addr-d2f40b3e19de"],[]]]],["dct:modified",[["2018-03-11T19:10:56+00:00",[]]]]]],["cdf:org-bd17085b71f7",0,[],[["schema:name",[["Wolfgang-Eigemann-Haus",[]]]],["schema:address",[[["cdf:addr-5fb2845c133d"],[]]]]]],["cdf:org-bd1bdbf47caa",0,[],[["schema:name",[["Caritas-Altenzentrum Hövelho