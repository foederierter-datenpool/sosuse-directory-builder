n\nMichaela Hüttinger",[]]]]]],["cdf:org-bcd9b106ca09",0,[],[["schema:name",[["Landesverband Kath. Kindertagesstätten e. V.",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/3157635",[]]]],["schema:address",[[["cdf:addr-8d581f773ae3"],[]]]],["dct:modified",[["2025-11-11T12:02:50+00:00",[]]]],["schema:alternateName",[["Fachberatung Aalen",[]]]]]],["cdf:org-bcd9d91a9c33",0,[],[["schema:name",[["Kath. Kindergarten St. Nikolaus",[]]]],["schema:email",[["kiga.nikolausdorf@kirche-in-garrel.de",[]]]],["schema:telephone",[["+494474507770",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/72263",[]]]],["schema:address",[[["cdf:addr-8517364845fa"],[]]]],["dct:modified",[["2025-02-17T09:24:02+00:00",[]]]],["schema:description",[["Leiterin: Frau Rita Nienaber",[]]]]]],["cdf:org-bcdbab4b1ac4",0,[],[["schema:name",[["Jugendberatung und Jugendhilfe e.V.",[]]]],["schema:email",[["jj-ev@jj-ev.de",[]]]],["schema:telephone",[["+49697434800",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/97637",[]]]],["schema:address",[[["cdf:addr-fe807b6e5622"],[]]]],["dct:modified",[["2019-03-20T12:33:10+00:00",[]]]],["foaf:homepage",[["www.drogenberatung-jj.de",[]]]],["schema:description",[["Jugendberatung und Jugendhilfe e.V.",[]]]]]],["cdf:org-bcdbae3fe7a0",0,[],[["schema:name",[["Kath. Kirchengemeinde Mariä Himmelfahrt Boden",[]]]],["schema:telephone",[["+4926028447",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/87936",[]]]],["schema:address",[[["cdf:addr-7951cde39dbb"],[]]]],["dct:modified",[["2018-03-11T18:29:00+00:00",[]]]]]],["cdf:org-bcdbb7803afe",0,[],[["schema:name",[["Fachberatungsstelle für Personen mit besonderen sozialen Schwierigkeiten",[]]]],["schema:email",[["m.schallmo@caritas-aachen.de",[]]]],["schema:telephone",[["+49240486519",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/79449",[]]]],["schema:address",[[["cdf:addr-967b41cb0e4a"],[]]]],["dct:modified",[["2025-03-21T11:02:28+00:0