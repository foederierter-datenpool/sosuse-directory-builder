[],[["schema:name",[["201/2 - Am Eulenthal - Kath. Kita St. Katharina",[]]]],["schema:email",[["kita.st-katharina@st-margareta.de",[]]]],["schema:telephone",[["+49211276100",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/92097",[]]]],["schema:address",[[["cdf:addr-65343b8fbfae"],[]]]],["dct:modified",[["2023-08-29T09:08:01+00:00",[]]]],["foaf:homepage",[["http://fz.st-margareta.de/katharina.html",[]]]],["schema:description",[["Kath. Kindertagesstätte St. Katharina",[]]]]]],["cdf:org-bc9818ea911c",0,[],[["schema:name",[["St. Elisabethenverein Kirrweiler e.V.",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/106977",[]]]],["schema:address",[[["cdf:addr-5e930a94fc07"],[]]]],["dct:modified",[["2021-08-25T12:10:25+00:00",[]]]]]],["cdf:org-bca016a944d4",0,[],[["schema:name",[["Caritas-Kinderheim gGmbH",[]]]],["schema:email",[["kinderheim@caritas-rheine.de",[]]]],["schema:telephone",[["+49597140020",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/703004",[]]]],["schema:address",[[["cdf:addr-51ba0313934a"],[]]]],["dct:modified",[["2018-03-12T10:10:00+00:00",[]]]],["schema:alternateName",[["Kinder- und Jugendheim stationäre Familienarbeit",[]]]],["foaf:homepage",[["http://www.caritas-rheine.de/kinderheim",[]]]],["schema:description",[["Caritas-Kinderheim gGmbH",[]]]]]],["cdf:org-bca3680e644a",0,[],[["schema:name",[["Die Wohnungslosenhilfe",[]]]],["schema:address",[[["cdf:addr-65a6246d5262"],[]]]]]],["cdf:org-bca434aba2d3",0,[],[["schema:name",[["Caritas-Region Cottbus",[]]]],["schema:email",[["iq-faire-integration@caritas-goerlitz.de",[]]]],["schema:telephone",[["+4935538003770",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/2033739",[]]]],["schema:address",[[["cdf:addr-8b1f77cccdf2"],[]]]],["dct:modified",[["2025-08-20T19:40:57+00:00",[]]]],["schema:alternateName",[["IQ - Faire Integration",[]]]],["foaf:homepage",[["https://www.faire-integration.de/de/topic/11.beratungsstellen.html",[]]]],["schema:openingHours",[["Sprechzeiten: \t\tmontags bis donnerstags 09:00 bis 16:00 Uhr\nOffene Bürozeiten: \tmittwochs 09-12 Uhr\n\nOffice hours: Mo – Thursday 09 am – 04 pm\nOpen Office hours: Wednesdays 9 am -12 pm\n",[]]]],["schema:description",[["Faire Integration ist ein bundesweites Beratungsangebot zu sozial- und arbeitsrechtlichen Fragestellungen von Drittstaatler*innen und gehört zu dem Förderprogramm IQ – Integration durch Qualifizierung. Dieses zielt auf die nachhaltige Verbesserung der Arbeitsmarktintegration von Erwachsenen mit Migrationshintergrund ab. Daran arbeiten Landesnetzwerke, die von Fachstellen zu migrationsspezifischen Schwerpunktthemen unterstützt werden.\n\nDie Zielgruppe\n\nIn den Beratungsstellen können sowohl Personen, die sich bereits in Arbeit, Ausbildung oder Praktikum befinden, Rat zu konkreten Fragestellungen erhalten als auch solche, die sich präventiv über ihre Arbeitsbedingungen informieren möchten.\n\nDie Beratung findet in vielen Sprachen unter anderem Englisch, Farsi, Dari, Urdu, Hindi, Arabisch, Russisch, Ukrainisch, Französisch, Portugiesisch und Türkisch statt.\n\nDie Beratungsstellen bieten auch präventive Workshops und Beratungen an.\n\nIhre Ansprechpartner*innen:\n\nSusanne Riepe\nSayed Edris Rasuly\nJens Leuner\n\nKontakt:\n\nsusanne.riepe@caritas-goerlitz.de\nsayed-edris.rasuly@caritas-goerlitz.de\njens.leuner@caritas-goerlitz.de\n\n\n\n\nFaire Integration is a nationwide consulting service for third-country citizens on questions regarding social- and labour law which is funded by the program Network IQ – Integration through Qualification. Its main target is to sustainably improve integration of persons with a history of migration into the employment market. State networks and specialists departments focussing mainly on migration-specific topics are continuously collaborating to acheive this goal.\n\nOur target group\n\nOur consultation service offers advice to employees, apprentices, as well interns. Furthermore it provides council to people who are still searching for access to the employment market and wish to inform themselves preemptively about working conditions. When needed, Faire Integration organises preventive workshops and consultations for employees of relevant institutions.\n\n\n\nWe speak: English, Farsi, Dari, Urdu, Hindi, Arabic, Russian, Ukrainian, French, Portuguese and Turkish\n\nYour contact persons:\nEdris Rasuly, Susanne Riepe und Jens Leuner\n\nOffice hours: Mo – Thursday 09 am – 04 pm\n\nOpen Office hours: Wednesdays 9 am -12 pm\n\nContact:         \nsusanne.riepe@caritas-goertlitz.de\nsayed-edris.rasuly@caritas-goerlitz.de\n\njens.leuner@caritas-goerlitz.de",[]]]]]],["cdf:org-bca53e002bb6",0,[],[["schema:name",[["Kath. Pfarramt St. Korbinian",[]]]],["schema:telephone",[["+4980413912",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/108440",[]]]],["schema:address",[[["cdf:addr-f233b0020f7a"],[]]]],["dct:modified",[["2018-03-11T19:11:03+00:00",[]]]]]],["cdf:org-bca6afb4daa8",0,[],[["schema:name",[["Kath. Pfarramt St. Leonhard",[]]]],["schema:telephone",[["+4980391495",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/89153",[]]]],["schema:address",[[["cdf:addr-752e9d34ac54"],[]]]],["dct:modified",[["2018-03-11T19:10:57+00:00",[]]]]]],["cdf:org-bca7c42a1b36",0,[],[["schema:name",[["Newman-Verein München Newman-Haus",[]]]],["schema:email",[["heimleitung@newman-haus.de",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/94621",[]]]],["schema:address",[[["cdf:addr-dedb756293d3"],[]]]],["dct:modified",[["2018-03-11T19:08:53+00:00",[]]]],["foaf:homepage",[["www.newman-haus.mhn.de",[]]]]]],["cdf:org-bca92478fc50",0,[],[["schema:name",[["Diakonisches Werk Rhein-Neckar - Schuldnerberatung",[]]]],["schema:address",[[["cdf:addr-9c42d1e0994c"],[]]]]]],["cdf:org-bca9e6d7ee40",0,[],[["schema:name",[["Ambulante Suchthilfe",[]]]],["schema:address",[[["cdf:addr-46d5c3bb66f2"],[]]]]]],["cdf:org-bcaaa0758171",0,[],[["schema:na