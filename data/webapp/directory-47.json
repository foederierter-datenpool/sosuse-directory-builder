ess",[[["cdf:addr-90ccaf55b5c8"],[]]]],["dct:modified",[["2025-08-20T13:46:52+00:00",[]]]],["schema:description",[["Kath. Kindergarten St. Michael",[]]]]]],["cdf:org-2006a0eeea3b",0,[],[["schema:name",[["Kath.Kindergarten St.Margareta Gutenberg",[]]]],["schema:email",[["kita.st.margareta.gutenberg@bistum-augsburg.de",[]]]],["schema:telephone",[["+498344412",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/77212",[]]]],["schema:address",[[["cdf:addr-51a3a306a10e"],[]]]],["dct:modified",[["2026-07-09T11:28:27+00:00",[]]]],["schema:description",[["Kath.Kindergarten St.Margareta Herrn Fischer Gutenberg",[]]]]]],["cdf:org-2008bc344b53",0,[],[["schema:name",[["Caritas-Region Görlitz",[]]]],["schema:email",[["hoyerswerda@caritas-goerlitz.de",[]]]],["schema:telephone",[["+493571979256",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/86765",[]]]],["schema:address",[[["cdf:addr-cc7f1e18c867"],[]]]],["dct:modified",[["2019-06-19T15:01:58+00:00",[]]]],["schema:alternateName",[["Betreutes Seniorenwohnen Lauta",[]]]],["schema:description",[["Im Geschäftszentrum Leippe-Torno entstanden sechs seniorengerechte Wohnungen (eine Zweiraum-Wohnung, vier Eineinhalb-Raumwohnungen und ein Appartement). Die Wohnungsgrößen liegen zwischen 36 und 60 Quadratmeter.\nHier, mitten drin im Leben, finden Seniorinnen und Senioren einen Ort, an dem sie mit der notwendigen Unterstützung so lange wie möglich selbstständig leben können.\nDas direkte Umfeld bietet dafür wichtige Voraussetzungen:\n\n * Arztpraxen im Haus,\n * Krankenkasse / Hörgeräteservice,\n * Friseur,\n * verschiedene Lebensmittelgeschäfte,\n * Bushaltestelle vor dem Haus.\n\nIn einem eigenen Gartenbereich und im grünen Umfeld finden Sie einen guten Ausgleich. Darüber hinaus bietet Ihnen der Caritasverband Hilfe und Unterstützung durch seine Beratungs- und Betreuungsdienste. Die Leistungsangebote der Caritas im betreuten Seniorenwohnen richten sich ausschließlich an die Bewohnerinnen und Bewohner der Seniorenwohnanlage. Die im Zusammenhang mit dem Mietvertrag vereinbarten Grundleistungen beinhalten zum Beispiel:\n\n * Soziale Beratung und Betreuung,\n * vorübergehende pflegerische Versorgung,\n * Servicetelefon,\n * Angebote der Freizeitgestaltung,\n * Hausmeisterservice,\n * Vermittlung anderer Dienstleistungen\n * und andere.\n\nZu den Grundleistungen gibt es ein umfassendes Angebot an Wahlleistungen, wie zum Beispiel:\n\n * ambulante Kranken- und Altenpflege,\n * hauswirtschaftliche Versorgung,\n * Essen auf Rädern,\n * Boten- und Begleitdienste,\n * Versorgung der Wohnung bei Abwesenheit\n * und andere.\n\nIhre Ansprechpartnerinnen:\nUrsula Wilkowski, Leiterin der Caritas-Region Görlitz\nKornelia Maltan (vor Ort)",[]]]]]],["cdf:org-200d63e4427f",0,[],[["schema:name",[["Caritasverband für Stuttgart - Bereich Armut, Wohnungsnot, Schulden",[]]]],["schema:email",[["jakobus@caritas-stuttgart.de",[]]]],["schema:telephone",[["+4971124897761",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/87309",[]]]],["schema:address",[[["cdf:addr-a594742ae694"],[]]]],["dct:modified",[["2025-08-20T19:08:26+00:00",[]]]],["schema:alternateName",[["Haus Jakobus, Betreutes Übergangswohnen",[]]]],["foaf:homepage",[["https://www.caritas-stuttgart.de/hilfe-beratung/wohnungslos/wohnangebote/maenner/haus-jakobus/haus-jakobus-betreutes-uebergangswohnen",[]]]]]],["cdf:org-200efd39b002",0,[],[["schema:name",[["St.-Antonius-Hospital",[]]]],["schema:email",[["Sekretariat@antonius-hospital.de",[]]]],["schema:telephone",[["+4928214900",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/90762",[]]]],["schema:address",[[["cdf:addr-d623294e771d"],[]]]],["dct:modified",[["2012-12-14T10:38:33+00:00",[]]]],["schema:alternateName",[["Krankenpflegeschule",[]]]]]],["cdf:org-200fa46e4e21",0,[],[["schema:name",[["Kath. Kirchengemeinde St. Petrus und Paulus",[]]]],["schema:telephone",[["+4967252481",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/85