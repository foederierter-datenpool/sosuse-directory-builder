/www.caritas.de/adressen/2179641",[]]]],["schema:address",[[["cdf:addr-b8cdb75967c3"],[]]]],["dct:modified",[["2022-04-06T13:24:07+00:00",[]]]]]],["cdf:org-a8a5ec5f789f",0,[],[["schema:name",[["Sozialstation St. Josef Altshausen gGmbH",[]]]],["schema:email",[["info@sst-josef.de",[]]]],["schema:telephone",[["+497584924444",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/85422",[]]]],["schema:address",[[["cdf:addr-f9f3bbd7142e"],[]]]],["dct:modified",[["2025-08-20T19:06:55+00:00",[]]]],["foaf:homepage",[["Steinacherstraße 70",[]]]],["schema:description",[["Wir erbringen Leistungen für Menschen in deren häuslicher Umgebung und tragen damit wesentlich dazu bei, Lebensqualität und vertraute Umgebung so lange wie möglich zu erhalten.\n\nDas jeweilige Pflegeprogramm stellen wir individuell nach Ihren Bedürfnissen zusammen. Dabei lassen sich unterschiedliche  Leistungsmodule miteinander kombinieren - zum Beispiel die \"Grundpflege\", die Hauswirtschaftliche Versorgung\" und die\n\"Ärztlich verordnete Behandlungspflege\".\nTragende Säulen unseres Pflegekonzepts sind neben der konsequenten Patientenorientierung der enge Austausch mit Angehörigen und Bezugspersonen und die kontinuierliche Abstimmung mit Ärzten und Krankenhäusern.\n\nGerne beraten wir Sie eingehend in einem persönlichen Gespräch.\n\nDie Abrechnung der Leistungen erfolgt größtenteils über die jeweiligen Kranken- und/oder Pflegekassen.",[]]]]]],["cdf:org-a8a776241d86",0,[],[["schema:name",[["Pfarrkirchenstiftung St. Kilian",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/73686",[]]]],["schema:address",[[["cdf:addr-8645be22b09f"],[]]]],["dct:modified",[["2018-03-11T15:10:43+00:00",[]]]],["schema:description",[["Pfarrkirchenstiftung St. Kilian",[]]]]]],["cdf:org-a8aa9f164e0f",0,[],[["schema:name",[["St. Josefspflege Mulfingen",[]]]],["schema:telephone",[["+49793890310",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/1035179",[]]]],["schema:address",[[["cdf