essen/95066",[]]]],["schema:address",[[["cdf:addr-c640cab0df7c"],[]]]],["dct:modified",[["2023-08-29T09:08:22+00:00",[]]]],["schema:alternateName",[["FB Kinder-, Jugend- und Familienhilfe FD Kindertagesstätten",[]]]],["foaf:homepage",[["http://www.caritas-rheinberg.de",[]]]],["schema:description",[["Die Angebote der Kindertagesstätte sind sehr breit gefächert. Im Hinblick auf das „Life-Model“ von Germain und Gitterman wird individuell auf jedes Kind geschaut und entsprechend des vorhandenen Potentials, die Ressourcen für die Weiterentwicklung genutzt. So wird neben der Sprachtherapie, Motopädie und Krankengymnastik, viel Wert auf Bewegung und Kreativität sowie Selbständigkeit und Sozialkompetenz gelegt. Die Persönlichkeit jedes einzelnen Kindes hat einen großen Stellenwert!\nEin wichtiger Aspekt unserer Arbeit ist auch die Kooperation und Vernetzung mit anderen Institutionen. So arbeiten wir u.a. intensiv mit den hiesigen Grund – und Sonderschulen, der Erziehungsberatungsstelle, dem Frühförderzentrum, Kinderärzten und dem SPZ zusammen. Ebenso legen wir großen Wert darauf, uns für die Verbesserung der Perspektiven von Kindern einzusetzen. Daher nehmen wir regelmäßig an Gremien, Arbeitskreisen und Fortbildungen teil und bieten somit die bestmöglichste Unterstützung für Eltern und Kinder.",[]]]]]],["cdf:org-490a5b7bfd46",0,[],[["schema:name",[["Kath. Pfarramt St. Michael",[]]]],["schema:telephone",[["+4986523682",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/81109",[]]]],["schema:address",[[["cdf:addr-c3d1ca5ee973"],[]]]],["dct:modified",[["2018-03-11T19:12:05+00:00",[]]]]]],["cdf:org-490afbf3bb51",0,[],[["schema:name",[["Caritas Kita St. Laurentius Denkhof",[]]]],["schema:email",[["kita.denkhof@caritas-passau.de",[]]]],["schema:telephone",[["+4985828659",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/80637",[]]]],["schema:address",[[["cdf:addr-52b35941ab6d"],[]]]],["dct:modified",[["2026-02-26T13:24:30+00:00",[]]]],["foaf:hom