.",[]]]],["schema:email",[["pflegesued@caritas-frankfurt.de",[]]]],["schema:telephone",[["+49 (069) 2982-1260",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/83091",[]]]],["dct:modified",[["2026-08-06T09:06:52+00:00",[]]]],["schema:address",[[["cdf:addr-9aa466579d56"],[]]]],["schema:alternateName",[["Caritas ambulanter Pflegedienst Frankfurt - \r\nTeam West/Team Mitte/Team Süd",[]]]],["foaf:homepage",[["http://www.caritas-frankfurt.de",[]]]],["schema:openingHours",[["Montag bis Freitag von 08:00 bis 17:00 Uhr",[]]]],["schema:description",[["Caritas Ambulanter Pflegedienst Frankfurt - Team West\n\nWir sind für Sie da in den Stadtteilen Griesheim, Höchst, Nied, Sindlingen, Sossenheim, Unterliederbach und Zeilsheim\nIhre Bedürfnisse und Wünsche entscheiden über den Umfang und Zeitpunkt unserer Leistungen. Wir besprechen ausführlich mit Ihnen, welche Hilfen/Dienste Sie benötigen. Dabei beraten wir Sie auch zur Finanzierung der Pflege. Selbstverständlich sind unsere Leistungen von den Krankenkassen anerkannt. Für Pflegerisiken wie zum Beispiel Sturzvermeidung oder Inkontinenz haben wir geschulte Experten.\nWir arbeiten zusammen mit den behandelnden Ärzten, Krankengymnasten und Krankenhäusern. Wir stehen in Kontakt mit Seelsorgern und den Institutionen des Gesundheitswesens. Wir sind schnell bei Ihnen, wenn Sie uns brauchen. Bei nächtlichem Pflegebedarf erreichen Sie uns über unsere Rufbereitschaft.\n\n\nWas wir für Sie tun können:\n\n * Körperpflege: Unterstützung oder vollständige Übernahme\n * Unterstützung im hauswirtschaftlichen Bereich\n * aktivierende Maßnahmen zur Erhaltung der Selbstständigkeit\n * medizinische Behandlungspflege, zum Beispiel Medikamentengabe, Kompressionsverbände, Wundbehandlung durch Wundexperten\n * Sterbebegleitung\n * und vieles mehr\n\nAnsprechpartner*in:\nSandra Schäckel, Koordinatorin Team West",[]]]]]],["cdf:org-9b0ca5976dc8",0,[],[["schema:name",[["Martinus Trägergesellschaft für soziale Dienste m.b.H.",[]]]],["sche