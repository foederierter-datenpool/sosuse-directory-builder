],["(069) 2982169",[]],["(069) 91331626",[]],["+49 (069) 2982-1171",[]],["+49 (069) 2982-1240",[]],["+49 (069) 2982-1442",[]],["069254931-22",[]],["06929821442",[]],["06992870467",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/2692085",[]]]],["dct:modified",[["2009-08-19T13:34:31+00:00",[]]]],["schema:address",[[["cdf:addr-a6ee99456748"],[]]]],["schema:alternateName",[["Fachstelle Engagement - Ehrenamt, Sozialpastoral, Youngcaritas",[]]]],["foaf:homepage",[["http://www.caritas-frankfurt.de",[]]]],["schema:openingHours",[["Telefonische Erstinformation erteilt das Sekretariat:\r\nmontags bis freitags von 09:00 - 13:00 Uhr.\r\n\r\nOffene Sprechstunde:\r\nmontags von 10:00 - 12:00 Uhr ohne Voranmeldung",[]]]],["schema:description",[["\"Menschen stärken. Wege finden.\" – unter diesem Leitwort steht die Arbeit des Caritasverbands Frankfurt e. V. Mit rund 100 Einrichtungen und Diensten in den verschiedenen Feldern der sozialen Arbeit gehört der Caritasverband Frankfurt e. V. zu den großen Trägern der freien Wohlfahrtspflege in Frankfurt am Main.\n\nAls kompetenter und moderner Dienstleister, dessen Handeln auf christlichen Werten aufbaut, bieten wir gemeinsam mit katholischen Kirchengemeinden in Frankfurt, ein einzigartiges Netzwerk sozialer Angebote und Hilfen. Mehr als 1.600 Beschäftigte sowie rund 1.400 Ehrenamtliche und Helfer/-innen setzen sich bei uns täglich für die Beteiligung aller Bürger/-innen an einer solidarischen und sozialen Stadtgesellschaft ein und bieten Menschen Unterstützung für ein selbstbestimmtes und selbstverantwortetes Leben.\n\nDer Caritasverband Frankfurt e. V. ist die vom Bischof von Limburg anerkannte institutionelle Zusammenfassung aller der Caritas dienenden Einrichtungen und Dienste einschließlich der der Kirchengemeinden. Er steht unter der Aufsicht des Bischofs von Limburg.",[]]]]]],["cdf:org-564196b44059",0,[],[["schema:name",[["Kath. Kindertagesstätte Maria Himmelskron",[]]]],["schema:email",[["kita.goethe@maria-himm