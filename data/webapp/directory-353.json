tyOfPage",[["https://www.caritas.de/adressen/92287",[]]]],["schema:address",[[["cdf:addr-a743668b6930"],[]]]],["dct:modified",[["2009-08-19T13:52:12+00:00",[]]]]]],["cdf:org-f2522365efa0",0,[],[["schema:name",[["Stationäre Jugendhilfe Villa Anna in Eppstein",[]]]],["schema:address",[[["cdf:addr-b4683702bdc3"],[]]]]]],["cdf:org-f254b431d3ee",0,[],[["schema:name",[["Pfarrkindergarten St. Peter",[]]]],["schema:email",[["st-peter.dachau@kita.ebmuc.de",[]]]],["schema:telephone",[["+4981316119690",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/85577",[]]]],["schema:address",[[["cdf:addr-f7111a3c472a"],[]]]],["dct:modified",[["2021-07-02T11:23:56+00:00",[]]]]]],["cdf:org-f254bdab48dc",0,[],[["schema:name",[["Caritasverband für die Region Düren-Jülich e.V.",[]]]],["schema:email",[["migrationsdienst@caritas-dn.de",[]]]],["schema:telephone",[["+49242148147",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/93013",[]]]],["schema:address",[[["cdf:addr-6ce05e872b21"],[]]]],["dct:modified",[["2025-05-07T10:34:55+00:00",[]]]],["schema:alternateName",[["Fachdienst Integration und Migration - Flüchtlingsberatung, Rückkehrberatung",[]]]],["foaf:homepage",[["http://www.caritasverband-dueren.de",[]]]],["schema:openingHours",[["Offene Sprechstunden:\nDienstag und Donnerstag ab 9.00 Uhr.",[]]]],["schema:description",[["Der Fachdienst ist eine Anlaufstelle für Flüchtlinge, ehemaligen Flüchtlinge, Mitbürger ausländischer Herkunft mit und ohne (gesichertem) Aufenthaltsstatus, Mitbürger aus den EU-Staaten sowie deutsche Bürgerinnen und Bürger zu Fragen rund um das Thema Migration.\n\nWir bieten allen Menschen eine religionsunabhängige, kostenlose und vertrauliche Beratung bei folgen Fragen:\n\n * zum Asylverfahren\n * zum Aufenthalt\n * zur Einbürgerung\n * zur Familienzusammenführung\n * zu Rückkehr und Weiterwanderung\n * zur Arbeitserlaubnis\n * zu Sprachkursen und Bildungsangeboten\n * zu sozialrechtlichen Ansprüchen nach dem Asylbewerberleistungsgesetz, SGB II(Arbeitslosengeld II), SGB XII (Grundsicherung), Kindergeld, Kinderzuschlag, Elterngeld, Wohngeld und anderen staatlichen Unterstützungen\n * in psychosozialen Situationen\n\nDer Fachdienst berät nicht nur sondern unterstützt Sie auch im Umgang mit den zuständigen Ämtern und Behörden auf vielfältige Weise. Das kann die inhaltliche Übersetzung eines Briefes sein, die Ausfüllhilfe eines Formulares, aber auch die praktische Hilfestellung bei der Durchsetzung rechtlicher Ansprüche. Wir vermitteln natürlich auch an andere Beratungsstellen.\n\nUnser Mitarbeiter berät Sie in Deutsch und Englisch. Bei anderen Sprachen müssen Dolmetscher zum Gespräch mitgebracht werden.",[]]]]]],["cdf:org-f255135eb4bb",0,[],[["schema:name",[["Betreuungsverein",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/86253",[]]]],["schema:address",[[["cdf:addr-aceee887dae8"],[]]]],["dct:modified",[["2009-08-19T14:24:16+00:00",[]]]],["schema:alternateName",[["Caritasverband Wetzlar/Lahn-Dill-Eder e.V.",[]]]]]],["cdf:org-f25ded65c8f0",0,[],[["schema:name",[["Kath. Kita St. Benediktus",[]]]],["schema:email",[["StBenediktusVarensell@kath-kitas-mirali.de",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/87336",[]]]],["schema:address",[[["cdf:addr-4363b00e8aa4"],[]]]],["dct:modified",[["2026-04-09T12:24:23+00:00",[]]]],["schema:alternateName",[["Kath. Kindergarten St. Benediktus",[]]]],["foaf:homepage",[["https://kiga-varensell.jimdofree.com/",[]]]]]],["cdf:org-f25ef7756d11",0,[],[["schema:name",[["SKFM-Sozialdienst Katholischer Frauen und Männer in Cloppenburg e. V.",[]]]],["schema:email",[["info@skfm-cloppenburg.de",[]]]],["schema:telephone",[["+49447181444",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/90956",[]]]],["schema:address",[[["cdf:addr-104d0f8e786c"],[]]]],["dct:modified",[["2025-02-19T08:36:30+00:00",[]]]],["schema:alternateName",[["Ambulante Hilfe für alleinstehende Wohnungslose u. Tageseinr. mit Übernachtst.",[]]]],["fo