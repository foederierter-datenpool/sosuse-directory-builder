ainEntityOfPage",[["https://www.caritas.de/adressen/108404",[]]]],["schema:address",[[["cdf:addr-5ac8a76646c3"],[]]]],["dct:modified",[["2019-08-06T11:41:22+00:00",[]]]],["schema:alternateName",[["Integration",[]]]],["foaf:homepage",[["www.st-michael-paulus-velbert.de",[]]]],["schema:description",[["Begegnungsstätte St. Michael",[]]]]]],["cdf:org-f2731dae82bc",0,[],[["schema:name",[["Suchtberatung und Suchtprävention",[]]]],["schema:address",[[["cdf:addr-a51d42f97371"],[]]]]]],["cdf:org-f274ba329b42",0,[],[["schema:name",[["Caritasverband für den Kreis Coesfeld e.V.",[]]]],["schema:email",[["ambulante.erziehungshilfe@caritas-coesfeld.de",[]]]],["schema:telephone",[["+4925949504225",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/211790",[]]]],["schema:address",[[["cdf:addr-50f84db4e3a8"],[]]]],["dct:modified",[["2026-02-16T10:47:16+00:00",[]]]],["schema:alternateName",[["Ambulante Erziehungshilfe",[]]]],["foaf:homepage",[["https://www.caritas-coesfeld.de/hilfen/kinderjugendundfamilie/ambulanteerziehungshilfe/ambulante-erziehungshilfe",[]]]],["schema:description",[["Der Familienalltag kann manchmal ganz schön herausfordernd sein. Wenn Sie das Gefühl haben, dass Ihnen alles über den Kopf wächst – sei es durch Erziehungsfragen, Stress im Alltag oder Konflikte – sind wir an Ihrer Seite. Unsere ambulante Erziehungshilfe unterstützt Sie durch persönliche Begleitung und Beratung – bei Ihnen zu Hause.\n\n\nUNSER ANGEBOT\n\nWir sind für Sie und Ihre Familie da!\n\nUnser Ziel ist es, Sie als Eltern zu stärken und gemeinsam mit Ihnen Wege zu finden, wie das Zusammenleben in Ihrer Familie wieder leichter und harmonischer wird.\n\n\nSOZIALPÄDAGOGISCHE FAMILIENHILFE\n\nSie fühlen sich im Alltag überfordert oder gestresst - mit der Erziehung, dem Haushalt, der Organisation oder im Kontakt mit Schule, Kindergarten oder Behörden? Wir kommen zu Ihnen nach Hause und unterstützen Sie ganz praktisch und individuell - so lange, wie Sie es brauchen.\n\n\nERZIEHUNGSBEISTANDSCHAFT\n\nIhr Kind oder Teenager hat Schwierigkeiten im Umgang mit sich selbst oder anderen - sei es in der Schule, mit Freunden*innen oder in der Familie? Wir begleiten Ihr Kind dabei, sich besser zurechtzufinden, Verantwortung zu übernehmen und Beziehungen positiv zu gestalten. Und wir beziehen Sie als Eltern aktiv mit ein.",[]]]]]],["cdf:org-f276b81f63a7",0,[],[["schema:name",[["Katholische Pfarrkirchenstiftung Mariä Verkündigung Leeder",[]]]],["schema:email",[["kita.fuchstal@bistum-augsburg.de",[]]]],["schema:telephone",[["+498243680",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/97589",[]]]],["schema:address",[[["cdf:addr-2c6c894a5a9e"],[]]]],["dct:modified",[["2026-07-09T11:12:21+00:00",[]]]],["schema:alternateName",[["Kindertagesstätte Fuchstal",[]]]],["foaf:homepage",[["www.kita-fuchstal.de",[]]]],["schema:description",[["Kath. Kindergarten Fuchstal",[]]]]]],["cdf:org-f276ead3889a",0,[],[["schema:name",[["Vorstand der Ökum. Sozialstation im Sulzbach und Fischbachtal e. V.",[]]]],["schema:email",[["sozialstation-quierschied@t-online.de",[]]]],["schema:telephone",[["+49689765555",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/94319",[]]]],["schema:address",[[["cdf:addr-02751badb71d"],[]]]],["dct:modified",[["2018-03-08T04:43:11+00:00",[]]]],["foaf:homepage",[["http://www.sozialstation-quierschied.de",[]]]],["schema:description",[["Vorstand der Ökum. Sozialstation im Sulzbach und Fischbachtal e. V.",[]]]]]],["cdf:org-f278155abf3d",0,[],[["schema:name",[["Kath. Kindertagesstätte Sternenzelt",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/98764",[]]]],["schema:address",[[["cdf:addr-ded80996fb06"],[]]]],["dct:modified",[["2013-02-08T19:23:33+00:00",[]]]]]],["cdf:org-f27866aa6b45",0,[],[["schema:name",[["Malteserstift St. Marien",[]]]],["schema:email",[["altenhilfe.drensteinfurt.org",[]]]],["schema:telephone",[["+49250899070",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/95415