e",[["https://www.caritas.de/adressen/78137",[]]]],["dct:modified",[["2026-04-01T11:50:20+00:00",[]]]],["schema:address",[[["cdf:addr-b5b99a40700b"],[]]]],["foaf:homepage",[["Hauptkanal rechts 74 - 75",[]]]],["schema:description",[["Marienkrankenhaus Papenburg-Aschendorf GmbH",[]]]]]],["cdf:org-949ba626f34a",0,[],[["schema:name",[["Katholische Sozialstation Stuttgart",[]]]],["schema:email",[["pgnord@sozialstationen-stuttgart.de",[]]]],["schema:telephone",[["+0049 (0711) 852843",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/450608",[]]]],["dct:modified",[["2014-07-21T14:37:49+00:00",[]]]],["schema:address",[[["cdf:addr-599b8a39bf35"],[]]]],["schema:alternateName",[["Pflegegruppe Stuttgart-Nord",[]]]],["foaf:homepage",[["http://www.sozialstationen-stuttgart.de/",[]]]],["schema:description",[["Beraten:\nSie suchen Informationen zur häuslichen Pflege?\nSie wollen wissen, welche Leistungen der Kassen Ihnen zustehen?\nSie benötigen Anleitung und Beratung bei der Pflege von Angehörigen?\nSie finden sich in der Vielzahl der Angebote von Pflegedienste nicht mehr zurecht?\nSie erhalten Pflegegeld und suchen eine Fachkraft für den Beratungsbesuch?\n\nHelfen\nSie brauchen Hilfe beim Einkaufen, Essen zubereiten, Wäsche waschen\noder sonst im Haushalt?\nSie wollen zum Arzt oder zu Behörden und suchen eine Begleitperson?\nSie benötigen sehne ll einen Toi lettenstuhl, ein Krankenbett oder sonst\nein Hilfsmittel?\nSie fühlen sich manchmal nicht ganz wohl und wären sicherer, wenn\ngelegentlich einfach nur jemand anruft oder vorbeischaut?\n\nPflegen\nSie wollen, dass Sie oder Ihre Angehörigen in der vertrauten\nhäuslichen Umgebung gepflegt werden?\nSie brauchen Hilfe beim Aufstehen, bei der Körperpflege oder beim Bett machen?\nIhr Arzt hat Ihnen eine Verordnung für einen Verbandswechsel, eine Injektion oder sonstige pflegerische Leistungen ausgestellt?\nSie liegen im Krankenhaus und könnten schneller nach Hause, wenn die Pflege dort gesichert wäre?\n\nWir sind für Sie da.\n\nWeitere Informationen unter:\n\nhttp://www.sozialstationen-stuttgart.de/",[]]]]]],["cdf:org-94a08172c163",0,[],[["schema:name",[["Kita Regenbogen",[]]]],["schema:email",[["kita.waldalgesheim@kita-ggmbh-koblenz.de",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/99068",[]]]],["dct:modified",[["2025-08-20T19:26:16+00:00",[]]]],["schema:address",[[["cdf:addr-ac4e6628d400"],[]]]],["foaf:homepage",[["www.kita-ggmbh-koblenz.de",[]]]],["schema:description",[["KiTa gGmbH Koblenz Kath. Kindertageseinrichtung Regenbogen",[]]]]]],["cdf:org-94a11d82df5c",0,[],[["schema:name",[["Pfarrei Heilig Kreuz Weißwasser",[]]]],["schema:email",[["pfarrbuero@kath-kirche-weisswasser.de",[]]]],["schema:telephone",[["+49 (3576) 201830",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/88723",[]]]],["dct:modified",[["2025-06-20T05:08:25+00:00",[]]]],["schema:address",[[["cdf:addr-bdcc3a1cada0"],[]]]],["foaf:homepage",[["http://weisswasser.kathweb.de/",[]]]],["schema:description",[["Die katholische Pfarrgemeinde Heilig Kreuz Weißwasser liegt im Dekanat Görlitz-Wittichenau des Bistums Görlitz und befindet sich im Freistaat Sachsen.\n\n\n\nSonntagsgottesdienste:\nSamstag:\n18:00 Uhr in der Pfarrkirche\nSonntag:\n10:00 Uhr in der Pfarrkirche\n\nAnsprechpartner:\nPfarrer Christoph Lamm",[]]]]]],["cdf:org-94a5ebbaae46",0,[],[["schema:name",[["Katholische Kindertagesstätte Kinderland St. Ursula",[]]]],["schema:email",[["kinderland.st.ursula@kath-oberursel.de",[]]]],["schema:telephone",[["+49 (06171) 51305",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/105362",[]]]],["dct:modified",[["2025-08-20T17:20:20+00:00",[]]]],["schema:address",[[["cdf:addr-8c2fd8677bf9"],[]]]],["schema:description",[["Kinderland St. Ursula",[]]]]]],["cdf:org-94a807f46d3e",0,[],[["schema:name",[["Betreutes Wohnen",[]]]],["schema:telephone",[["072229375-0",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/90132",[]]]],["dct:modified",[["201