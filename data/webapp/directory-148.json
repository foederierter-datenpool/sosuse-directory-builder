,[["Ambulante Einrichtung",[]]]],["schema:openingHours",[["Mo - Fr 8.00 ? 12.00 Uhr; 13.00 ? 17.00 Uhr sowie nach Vereinbarung",[]]]],["schema:availableService",[["Ambulante Beratung / Sucht- und Drogenberatung, Ambulante Behandlung, Kombibehandlung, Psychosoziale Betreuung Substituierter, Suchtberatung / -Prävention im Betrieb, Suchtberatung im Justizvollzug, Beratung für Angehörige",[]]]],["schema:accessibilitySummary",[["Die Einrichtung ist barrierefrei erreichbar.",[]]]],["cdf:parentOrgClassification",[["Freie Wohlfahrtspflege / gemeinnütziger Träger",[]]]],["schema:audience",[["Alkohol, Tabak, Medikamenten, Glücksspiel, Illegalen Drogen, Problematischer Mediennutzung",[]]]],["schema:description",[["In der Diözese Regensburg existiert die Caritas-Suchthilfe seit mittlerweile über 80 Jahren mit einem flächendeckenden Beratungs- und Behandlungsangebot.\n\nWir sind da für Personen,\n\n * die Probleme im Umgang mit Alkohol, Nikotin, Medikamenten und Drogen haben,\n * mit problematischem Spielverhalten, z. B. Glücksspiel, Internetrollenspiel,\n * mit Essstörungen.\n\nWir informieren, beraten und behandeln Betroffene und deren Angehörige oder Umfeld zu allen Fragen rund um Abhängigkeit. Neben den Fachambulanzen für Suchtprobleme unterhält die Caritas in der Diözese Regensburg auch eine Fachklinik für alkohol- und medikamentenabhängige Frauen und Männer in Haselbach und die Adaption START in Regensburg. Zu unseren Partnern zählt auch der Kreuzbund, die Selbsthilfe und Helfergemeinschaft für Suchtkranke und deren Angehörige.",[]]]]]],["cdf:org-6581de878157",0,[],[["schema:name",[["Kleiderkammer des SkF Dorsten",[]]]],["schema:telephone",[["+4923627059948",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/72083",[]]]],["schema:address",[[["cdf:addr-b17f97eaa731"],[]]]],["dct:modified",[["2025-01-06T07:52:28+00:00",[]]]]]],["cdf:org-6582bed31c96",0,[],[["schema:name",[["Diakonisches Werke im Kirchenkreis An Nahe und Glan - Schuldnerberatung",[]]]],["sche