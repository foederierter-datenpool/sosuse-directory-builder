a:name",[["Marienhof/St. Josef gGmbH",[]]]],["schema:email",[["h.mueller@kk-koblenz.de und Logopaedieschule@kk-koblenz.de",[]]]],["schema:telephone",[["+492614963900",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/107870",[]]]],["schema:address",[[["cdf:addr-e362b5839dcc"],[]]]],["dct:modified",[["2009-08-19T13:36:34+00:00",[]]]],["schema:alternateName",[["Schule für Logopadie",[]]]]]],["cdf:org-87444f6be637",0,[],[["schema:name",[["Caritasverband Westeifel e.V. Dienststelle Prüm",[]]]],["schema:email",[["caritas@caritas-westeifel.de",[]]]],["schema:telephone",[["+496551971090",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/157353",[]]]],["schema:address",[[["cdf:addr-f78659ae8dd9"],[]]]],["dct:modified",[["2026-02-05T10:10:43+00:00",[]]]],["schema:alternateName",[["Fachstelle Spielsucht",[]]]],["foaf:homepage",[["http://www.caritas-westeifel.de",[]]]],["schema:openingHours",[["Montag bis Freitag 8:00 bis 13:00 Uhr und\nMontag und Donnerstag 14:00 bis 16:30 Uhr",[]]]],["schema:description",[["FACHSTELLE SPIELSUCHT\n\nDie Fachstelle Spielsucht beim Caritasverband Westeifel e.V. wird vom Land Rheinland-Pfalz gefördert und bietet Beratung zur und Prävention der Spielsucht an. Die Fachstelle ist zuständig für die beiden Landkreise Eifelkreis Bitburg-Prüm und Vulkaneifel Daun.\n\nDie Beratung richtet sich an Menschen mit einem auffälligen oder krankhaften Spielverhalten in den Bereichen: Glücksspielautomaten, Glücksspiel im Internet, Lotto, Toto, Oddset, Poker, illegale Glücksspiele, Computerspiele, Internetgebrauch.\n\nEs wird begleitend eine Selbsthilfegruppe für Spieler_innen und bei Bedarf eine Schuldner- und Insolvenzberatung angeboten.\n\nDie Prävention richtet sich an junge Menschen, Lehrer und Eltern und beinhaltet die Themen Computerspiele, Online-Rollenspiele und Internetsucht. Die Beratung ist vertraulich und findet auf freiwilliger Basis statt. Die Angebote sind kostenfrei; Beratung kann anonym oder vor Ort stattfinden.\n\nTermine für beide Angebote sind nach vorheriger Vereinbarung möglich.\n\nAnsprechpersonen:\nFranz Urfels             f.urfels@caritas-westeifel.de\nWaltraud Alten         w.alten@caritas-westeifel.de",[]]]]]],["cdf:org-87445cb653db",0,[],[["schema:name",[["Sozialdienst kath. Frauen e. V. Wesel",[]]]],["schema:email",[["mgh@skfwesel.de",[]]]],["schema:telephone",[["+4928195238135",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/84209",[]]]],["schema:address",[[["cdf:addr-df427d5e1e82"],[]]]],["dct:modified",[["2021-07-09T07:04:55+00:00",[]]]],["schema:alternateName",[["Mehrgenerationenhaus",[]]]],["foaf:homepage",[["www.mgh-skfwesel.de",[]]]],["schema:description",[["Mehrgenerationenhaus Wesel",[]]]]]],["cdf:org-87456d3a4072",0,[],[["schema:name",[["Kath. Kindergarten St. Remigius/Fam.Z. Happerschoß",[]]]],["schema:email",[["info@kindergarten-happerschoss.de",[]]]],["schema:telephone",[["+49 (02242/) 5457",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/94305",[]]]],["schema:address",[[["cdf:addr-a19200d59674"],[]]]],["dct:modified",[["2023-08-29T09:08:07+00:00",[]]]],["foaf:homepage",[["Angabe wird nachgereicht",[]]]],["schema:description",[["Kath. Kindergarten St. Remigius",[]]]]]],["cdf:org-8746b0aebd4c",0,[],[["schema:name",[["Kath. Kindergarten St. Elisabeth",[]]]],["schema:email",[["kiga@pfarrei-erbendorf.de",[]]]],["schema:telephone",[["+49968218359350",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/98275",[]]]],["schema:address",[[["cdf:addr-0dd31f32e4ec"],[]]]],["dct:modified",[["2020-11-10T08:42:52+00:00",[]]]],["schema:alternateName",[["Erbendorf",[]]]],["foaf:homepage",[["http://www.kindergarten-erbendorf.de",[]]]]]],["cdf:org-874963d16c2c",0,[],[["schema:name",[["Beratungsstelle für Frauen",[]]]],["schema:address",[[["cdf:addr-dd9421362d0a"],[]]]]]],["cdf:org-874a487aa4e6",0,[],[["schema:name",[["Caritasverband f.d. Oberbergischen Kreis",[]]]],["schema:email",[["renate.bergmann@caritas-ob