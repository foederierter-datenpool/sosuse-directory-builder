e St. Peter und Paul",[]]]],["schema:email",[["pfarrer.senkbeil@pv-menden.de",[]]]],["schema:telephone",[["+492372915123",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/75196",[]]]],["schema:address",[[["cdf:addr-0c05ab7dafd4"],[]]]],["dct:modified",[["2018-03-12T04:53:16+00:00",[]]]],["foaf:homepage",[["http://www.kath-kirche-hemer.de",[]]]]]],["cdf:org-f8a38f0cd818",0,[],[["schema:name",[["Missionare Herz-Jesu",[]]]],["schema:telephone",[["+4984219003384",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/100385",[]]]],["schema:address",[[["cdf:addr-57f8e08c0d17"],[]]]],["dct:modified",[["2018-03-16T11:48:32+00:00",[]]]]]],["cdf:org-f8a663d6bfeb",0,[],[["schema:name",[["Sozialdienst katholischer Frauen e.V. Hamburg",[]]]],["schema:email",[["beratung-altona@skf-hamburg.de",[]]]],["schema:telephone",[["+494041436700",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/104989",[]]]],["schema:address",[[["cdf:addr-9b268cc94c12"],[]]]],["dct:modified",[["2024-11-21T12:12:09+00:00",[]]]],["schema:alternateName",[["Beratungsstelle für Frauen, Familien und Schwangere",[]]]],["foaf:homepage",[["www.skf-hamburg.de",[]]]]]],["cdf:org-f8a7f6d3ab7b",0,[],[["schema:name",[["Caritas Tagespflege St. Gertrud",[]]]],["schema:email",[["tp-gertrud@caritas-dn.de",[]]]],["schema:telephone",[["+492427904294",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/96964",[]]]],["schema:address",[[["cdf:addr-3880dc7512c3"],[]]]],["dct:modified",[["2025-04-09T10:03:40+00:00",[]]]],["foaf:homepage",[["http:// www.caritasverband-dueren.de",[]]]],["schema:description",[["Mit unseren modernen Tagespflegen unterhalten wir ein flächendeckendes Tages-Betreuungsangebot (teilstationär) für Senioren und pflegebedürftige Menschen im Kreis Düren. Menschen, die zu Hause leben, den Tagesablauf aber nicht mehr alleine bewältigen können, finden in unseren Tagespflege-Einrichtungen Geselligkeit, Anregung, Entspannung sowie einen strukturierten Alltag und kehren am Nachmittag in ihr Zuhause zurück.\n\nUnsere Hauptaufgaben liegen in der aktivierenden Pflege und der rehabilitierenden Förderung vorhandener Ressourcen der von uns betreuten Tagesgäste. Zudem unterstützt eine Tagespflege die Wünsche und Bedürfnisse Betroffener und Angehöriger in besonderer Weise, denn so soll möglichst lange der Aufenthalt in der gewohnten häuslichen Umgebung ermöglicht werden. Anstatt in ein stationäres Pflegeheim zu ziehen, besuchen sie täglich oder an selbst ausgewählten Tagen unsere teilstationären Einrichtungen.\n\nUnsere Tagespflegen sind montags bis freitags und an jedem 1. Samstag im Monat von 8.00 bis 16.00 Uhr geöffnet.",[]]]]]],["cdf:org-f8aaac215723",0,[],[["schema:name",[["Kath. Kirchenstiftung St. Michael",[]]]],["schema:telephone",[["+499833262",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/78609",[]]]],["schema:address",[[["cdf:addr-4cd1cc481d48"],[]]]],["dct:modified",[["2018-03-16T11:48:40+00:00",[]]]]]],["cdf:org-f8ac303419f6",0,[],[["schema:name",[["Caritas-Sozialstation Weißenfels",[]]]],["schema:email",[["sozialstation@caritas-wsf.de",[]]]],["schema:telephone",[["+493443303111",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/101419",[]]]],["schema:address",[[["cdf:addr-8273202b8a2d"],[]]]],["dct:modified",[["2026-03-20T06:36:27+00:00",[]]]],["schema:description",[["Caritas-Sozialstation Weißenfels",[]]]]]],["cdf:org-f8acc78ca908",0,[],[["schema:name",[["Schuldnerberatung Frankfurt-Ost",[]]]],["schema:address",[[["cdf:addr-eec59825e66c"],[]]]]]],["cdf:org-f8acf2d76404",0,[],[["schema:name",[["Kindergarten St. Anna",[]]]],["schema:email",[["st-anna.moosen@kita.ebmuc.de",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/109143",[]]]],["schema:address",[[["cdf:addr-f7d1ca50925b"],[]]]],["dct:modified",[["2025-08-20T17:56:14+00:00",[]]]],["schema:description",[["Kindergarten St.Anna",[]]]]]],["cdf:org-f8adea9c3975",0,[],[["schema:name",[["Psychosozialer Dienst Bitburg, Sucht - und Drogenberatung",[]]]],["schema:address",[[["cdf:addr-2c676dafac56"],[]]]]]],["cdf:org-f8ae75d9f058",0,[],[["schema:name",[["Sozialstation St.Elisabeth",[]]]],["schema:email",[["pfullendorf@caritas-pflegenetz.de",[]]]],["schema:telephone",[["+4975529289670",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/73807",[]]]],["schema:address",[[["cdf:addr-e3248762aa83"],[]]]],["dct:modified",[["2025-08-20T16:35:44+00:00",[]]]],["foaf:homepage",[["Überlinger Str. 1",[]]]],["schema:description",[["Sozialstation St.Elisabeth e.V",[]]]]]],["cdf:org-f8aea253fd1f",0,[],[["schema:name",[["Katholischer Kindergarten \"Zu Unserer Lieben Frau\"",[]]]],["schema:email",[["kita.zu-unserer-lb-frau.nm@bistum-eichstaett.de",[]]]],["schema:telephone",[["+49918142102",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/90818",[]]]],["schema:address",[[["cdf:addr-22b4ca3bc394"],[]]]],["dct:modified",[["2023-05-15T13:25:30+00:00",[]]]],["foaf:homepage",[["http://www.hofkirche.de",[]]]],["schema:description",[["Unser Angebot\nWir haben für die Kinder ein umfassendes Bildungs-, Erziehungs- und Betreuungsangebot und sind bereit, Eltern und Kinder optimal zu unterstützen und zu fördern.\nWir wollen bei allen Kindern in der gesamten Kindergartenzeit die Freude am Lernen wecken. Zusammen mit den Eltern unterstützen wir die Kinder, damit sie alle Fähigkeiten entwickeln, die sie für die Schule und das Leben brauchen. In der Projektarbeit lernen die Kinder, sich frei zu entscheiden, mitzubestimmen und selbständig Themen zu bearbeiten.\nFür unsere ausländischen Kinder bieten wir eine gezielte Sprachförderung an. Außerdem arbeiten wir eng mit einer Frühförderstelle und anderen Einrichtungen zusammen, um jedem Kind eine bestmögliche Förderung zu bieten.\n\nWir sind ein Integrationskindergarten, betreuen also gemeinsam behinderte und nicht behinderte Kinder.\n\nIn unserer Einrichtung gibt es auch eine Krippe für Kleinkinder.\n\nAnsprechpartnerin\nRupprecht Teresa",[]]]]]],["cdf:org-f8b193c739dd",0,[],[["schema:name",[["Kath.Kirchenstiftung Herz-Jesu",[]]]],["schema:telephone",[["+4984172185",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/75326",[]]]],["schema:address",[[["cdf:addr-2238d34a8b0b"],[]]]],["dct:modified",[["2018-03-16T11:49:01+00:00",[]]]]]],["cdf:org-f8b2caa1969d",0,[],[["schema:name",[["Siloah St. Trudpert Klinikum",[]]]],["schema:telephone",[["+4972314980",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/108854",[]]]],["schema:address",[[["cdf:addr-3fd9c58bbb6d"],[]]]],["dct:modified",[["2021-04-20T13:17:09+00:00",[]]]]]],["cdf:org-f8b4267137e9",0,[],[["schema:name",[["Fachklinik Villa Maria",[]]]],["schema:email",[["info-villamaria@ludwigsmuehle.de",[]]]],["schema:telephone",[["+49634999690",[]]]],["schema:mainEntityOfPage",[["https://www.dhs.de/service/suchthilfeverzeichnis/?tx_wwdhseinrichtung2_fe1%5Baction%5D=show&tx_wwdhseinrichtung2_fe1%5Bcontroller%5D=Entry&tx_wwdhseinrichtung2_fe1%5Bentry%5D=5099&cHash=2c362fc20b5e66a79ba83f39c80386ad",[]]]],["schema:address",[[["cdf:addr-9074a340f353"],[]]]],["schema:alternateName",[["Mitaufnahme von Kindern",[]]]],["foaf:homepage",[["www.ludwigsmuehle.de",[]]]],["schema:category",[["Stationäre Rehabilitationseinrichtung",[]]]],["schema:availableService",[["Elternarbeit (Angebote für Eltern suchtkranker Kinder), Paartherapie, Heilpädagogisches Kinderhaus, Stationäre Entwöhnungsbehandlung, Adaption, Kombibehandlung",[]]]],["schema:accessibilitySummary",[["Die Einrichtung ist nicht barrierefrei erreichbar.",[]]]],["cdf:parentOrgClassification",[["Freie Wohlfahrtspflege / gemeinnütziger Träger",[]]]],["schema:audience",[["Alkohol, Illegalen Drogen",[]]]]]],["cdf:org-f8b6b085019e",0,[],[["schema:name",[["Familienzentrum Kindertagesstätte Arche Noah",[]]]],["schema:email",[["kita-osthofen@caritas-worms.de",[]]]],["schema:telephone",[["+49624148036270",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/