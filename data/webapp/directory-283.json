l.de",[]]]],["schema:telephone",[["04316612896",[]]]],["schema:mainEntityOfPage",[["https://www.dhs.de/service/suchthilfeverzeichnis/?tx_wwdhseinrichtung2_fe1%5Baction%5D=show&tx_wwdhseinrichtung2_fe1%5Bcontroller%5D=Entry&tx_wwdhseinrichtung2_fe1%5Bentry%5D=6121&cHash=fb400427f5745b329bf101ce26e653cd",[]]]],["schema:address",[[["cdf:addr-87ec82676cb7"],[]]]],["schema:alternateName",[["ODYSSEE e.V.",[]]]],["foaf:homepage",[["www.odyssee-kiel.de",[]]]],["schema:category",[["Soziotherapeutische Einrichtungen / Eingliederungshilfe / Hilfen zur Überwindung besonderer sozialer Schwierigkeiten, AGH und Trainingsmaßnahme (Jobcenter Kiel)",[]]]],["schema:openingHours",[["Mo. - Do. 8.00 - 16.00 Uhr Fr. 8.00 - 14.00 Uhr",[]]]],["schema:availableService",[["Qualifizierung / Arbeitsförderung / Beschäftigung",[]]]],["schema:accessibilitySummary",[["Die Einrichtung ist barrierefrei erreichbar.",[]]]],["cdf:parentOrgClassification",[["Freie Wohlfahrtspflege / gemeinnütziger Träger",[]]]],["schema:audience",[["Illegalen Drogen, in anerkanntem Substitutionsprogramm",[]]]]]],["cdf:org-eef8f9538b77",0,[],[["schema:name",[["Katholische Familienpflege des Dekanats Esslingen-Nürtingen",[]]]],["schema:email",[["info@kath-familienpflege-es-nt.de",[]]]],["schema:telephone",[["(07022) 38515",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/104671",[]]]],["dct:modified",[["2019-08-20T07:10:20+00:00",[]]]],["schema:address",[[["cdf:addr-5f753313cf16"],[]]]],["foaf:homepage",[["http://www.kath-familienpflege-es-nt.de",[]]]],["schema:openingHours",[["Mo. - Fr. 8:00 - 16:00 Uhr\n\nAnsprechpartnerin: Bettina Betzner\n",[]]]],["schema:description",[["Es gibt viele Gründe, warum eine Familei zeitweise Hilfe im Alltag, bei der Versorgung der Kinder und des Haushalts benötigen kann:\n\n * bei Erkrankung der Mutter (oder des Vaters)\n * bei Krankenhausaufenthalt, Kuren und Rehabilitation\n * bei Risikoschwangerschaft, Geburt und Mehrlingsgeburten\n * bei Pflege von Kindern mit chronischer Erkrankung und Behinderung\n * bei starker Belastung, Überforderung oder psychischer Erkrankung\n * und andere Notlagen\n\nUnsere qualifizierten Fachkräfte kommen zu Ihnen nach Hause und leisten Hilfe nach Bedarf und Absprache mit Ihnen:\n\n * Versorgung der Kinder\n * Altersentsprechende Betreuung, Versorgung und Beschäftigung\n * Haushaltsführung\n * Einkaufen, Kochen, Wäschepflege, Ordnung und Reinigung der Wohnung\n * Pflege von Säuglingen und Kleinkindern, kranken Kindern und Kindern mit Behinderung.",[]]]]]],["cdf:org-eefda976585f",0,[],[["schema:name",[["Katholisches Kinderhaus St. Johannes Weißwasser",[]]]],["schema:email",[["kinderhaus@kath-kirche-weisswasser.de",[]]]],["schema:telephone",[["+49 (03576) 201211",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/86376",[]]]],["dct:modified",[["2026-10-02T10:32:30+00:00",[]]]],["schema:address",[[["cdf:addr-e2bc0e96fc7d"],[]]]],["foaf:homepage",[["https://www.kath-kirche-weisswasser.de/kinderhaus-st-johannes",[]]]],["schema:openingHours",[["Täglich von 06:00 Uhr bis 16:30 Uhr",[]]]],["schema:description",[["In unserem Kinderhaus entdecken rund 70 Kinder im Alter zwischen 0 und 10 Jahren ihre Welt, lernen miteinander und füreinander da zu sein, können unbeschwert spielen und ihren Bewegungsdrang entfalten. \n\nTäglich umsorgen unsere erfahrenen, gut ausgebildeten Pädagogen die fröhliche Rasselbande. In gemischten Gruppen gibt es immer etwas zu entdecken und den eigenen Neigungen nachzugehen.\nBei uns können die Kinder forschen, experimentieren und an den eigenen Stärken wachsen.\n\nIhre Ansprechpartnerin:\nSarah Gottschling\nLeiterin der Einrichtung\n\npfarrbuero@kath-kirche-weisswasser.de",[]]]]]],["cdf:org-ef035d01c36c",0,[],[["schema:name",[["Evas Obdach",[]]]],["schema:email",[["EvasObdach@skf-berlin.de",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/1067628",[]]]],["dct:modified",[["2025-08-20T09:58:39+00:00",[]]]],["schema:address",[[["cdf:addr-752256f1d8ff"],[