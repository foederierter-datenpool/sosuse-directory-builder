",[["http://www.caritas-wetzlar-lde.de",[]]]]]],["cdf:org-4a5e6a73b8fc",0,[],[["schema:name",[["Jugendpflege Haiger",[]]]],["schema:email",[["jugendpflegehaiger@caritas-wetzlar-lde.de",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/728133",[]]]],["dct:modified",[["2025-08-20T17:18:44+00:00",[]]]],["schema:address",[[["cdf:addr-5ce2b9a02dba"],[]]]]]],["cdf:org-4a631925ae97",0,[],[["schema:name",[["Kath. Kindertagesstätte St. Martin",[]]]],["schema:email",[["Kita.Bad-Bergzabern@bistum-speyer.de",[]]]],["schema:telephone",[["+49 (06343) 2057",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/74817",[]]]],["dct:modified",[["2025-03-28T11:14:47+00:00",[]]]],["schema:address",[[["cdf:addr-cff715056c72"],[]]]]]],["cdf:org-4a63c18699ce",0,[],[["schema:name",[["Schuldnerberatung Schwabach",[]]]],["schema:address",[[["cdf:addr-4f3c933cd50e"],[]]]]]],["cdf:org-4a6529de4584",0,[],[["schema:name",[["Sozialstation St. Martin Dunningen",[]]]],["schema:email",[["info@sozialstation-dunningen.de",[]]]],["schema:telephone",[["+49 (07403) 92904-10",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/100106",[]]]],["dct:modified",[["2025-08-20T19:06:39+00:00",[]]]],["schema:address",[[["cdf:addr-9c312e1d8cd3"],[]]]],["foaf:homepage",[["www.sozialstation-dunningen.de",[]]]],["schema:description",[["Wir erbringen Leistungen für Menschen in deren häuslicher Umgebung und tragen damit wesentlich dazu bei, Lebensqualität und vertraute Umgebung so lange wie möglich zu erhalten.\n\nDas jeweilige Pflegeprogramm stellen wir individuell nach Ihren Bedürfnissen zusammen. Dabei lassen sich unterschiedliche  Leistungsmodule miteinander kombinieren - zum Beispiel die \"Grundpflege\", die \"Hauswirtschaftliche Versorgung\" und die\n\"Ärztlich verordnete Behandlungspflege\".\nTragende Säulen unseres Pflegekonzepts sind neben der konsequenten Patientenorientierung der enge Austausch mit Angehörigen und Bezugspersonen und die kontinuierliche Abstimmung mit Ärzten und Krankenhäusern.\n\nGerne beraten wir Sie eingehend in einem persönlichen Gespräch.\n\nDie Abrechnung der Leistungen erfolgt größtenteils über die jeweiligen Kranken- und/oder Pflegekassen.",[]]]]]],["cdf:org-4a6954841c62",0,[],[["schema:name",[["CariMARKT",[]]]],["schema:email",[["personalwesen@caritas-kelheim.de",[]]]],["schema:telephone",[["+49 (09441) 6820650",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/72833",[]]]],["dct:modified",[["2025-08-20T18:51:30+00:00",[]]]],["schema:address",[[["cdf:addr-b7a16e6f75b0"],[]]]],["foaf:homepage",[["www.caritas-kelheim.de",[]]]]]],["cdf:org-4a6a0c649ba6",0,[],[["schema:name",[["Sozialstation Emstek-Cappeln",[]]]],["schema:email",[["feldhaus@sozialstation-emstek-cappeln.de",[]]]],["schema:telephone",[["+49 (04473) 92664-4444",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/94839",[]]]],["dct:modified",[["2023-12-01T09:21:50+00:00",[]]]],["schema:address",[[["cdf:addr-7efef8de6c17"],[]]]],["foaf:homepage",[["http://www.sozialstation-emstek-cappeln.de",[]]]],["schema:description",[["* Grundpflege, z.B. Hilfen beim An- und Auskleiden, Waschen, Baden und Duschen\n * Behandlungspflege nach ärztlicher Verordnung, z.B. Verbandswechsel, Blutzucker- und Blutdruckkontrolle\n * Erstellen eines individuellen Pflegeplans und nachvollziehbare Dokumentation\n * Vermittlung von weiteren sozialen Diensten, wie z.B. Hauswirtschaftshilfen, Hausnotrufdiensten, Mobiler Mahlzeitendienst\n * Betreuungsleistungen bei Demenz\n * Hauswirtschaftliche Versorgung, z.B. leichte Hausarbeiten, Einkaufen, Nahrungszubereitung\n * Begleitung Sterbender und ihrer Angehörigen, SAPV (spezialisierte ambulante palliative Versorgung)\n * Beratung und Unterstützung beim Umgang mit Krankenkassen, Pflegekassen und Behörden (z.B. Hilfe bei allen Kostenfragen)\n * Zusammenarbeit mit allen Einrichtungen des St. Pius-Stift und des Seniorenzentrums Haus St. Margaretha\n * Organisation und Durchführung der Pflege bei Verhinderung pflegender Angehöriger oder Mehrbedarf\n * Beratungsbesuche nach dem Pflegeversicherungsgesetz gemäß § 37 Abs. 3 SGB XI",[]]]]]],["cdf:org-4a715c8c20f3",0,[],[["schema:name",[["Kath. Kindergarten St. Franziskus",[]]]],["schema:email",[["kindergarten.st.franziskus@ewetel.net",[]]]],["schema:telephone",[["+49 (04443) 2326",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/95446",[]]]],["dct:modified",[["2025-02-18T07:27:38+00:00",[]]]],["schema:address",[[["cdf:addr-b52a47acd596"],[]]]],["schema:description",[["Leiterin: Frau Marita Tapken",[]]]]]],["cdf:org-4a71fff755fb",0,[],[["schema:name",[["Caritas-Kindergarten Arche Noah",[]]]],["schema:email",[["info@kiga-ebern.de",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/77542",[]]]],["dct:modified",[["2025-08-20T19:36:16+00:00",[]]]],["schema:address",[[["cdf:addr-5693f5f7fb6f"],[]]]],["foaf:homepage",[["http://www.kiga-ebern.de",[]]]],["schema:description",[["Anmerkung\n* Früh-/Mittagsbetreuung möglich",[]]]]]],["cdf:org-4a73402afbc8",0,[],[["schema:name",[["Beratungsstelle Information und Hilfe in Drogenfragen",[]]]],["schema:email",[["info@fsz-wesel.de",[]]]],["schema:telephone",[["028146091660",[]]]],["schema:address",[[["cdf:addr-8026e7879c53"],[]]]],["schema:openingHours",[["Mo 09:00-12:00,14:00-16:30;Tu 14:00-16:30;We 09:00-12:00,14:00-16:30;Th 14:00-18:00;Fr 09:00-12:00",[]]]]]],["cdf:org-4a77b4d83308",0,[],[["schema:name",[["Kath. Kinderhaus St. Vinzenz",[]]]],["schema:email",[["st-vinzenz.bayreuth@kita.erzbistum-bamberg.de",[]]]],["schema:telephone",[["+49 (0921) 5160583",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/96466",[]]]],["dct:modified",[["2025-08-20T09:14:27+00:00",[]]]],["schema:address",[[["cdf:addr-ce6b61cc006b"],[]]]],["foaf:homepage",[["www.kakivi.de",[]]]],["schema:description",[["Kath. Kinderhaus St. Vinzenz",[]]]]]],["cdf:org-4a7b56e5385a",0,[],[["schema:name",[["Caritasverband der Erzdiözese München und Freising e. 