:email",[["wohnungslosenhilfe@caritas-marl.de",[]]]],["schema:telephone",[["+4923652963100",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/81546",[]]]],["schema:address",[[["cdf:addr-e9c5f037952b"],[]]]],["dct:modified",[["2023-01-26T06:43:54+00:00",[]]]],["schema:alternateName",[["Wohnungslosenhilfe",[]]]],["foaf:homepage",[["http://www.caritas-marl.de",[]]]],["schema:openingHours",[["Montag bis Donnerstag: 8:00 Uhr - 17:00 Uhr, Freitag:\n8:00 Uhr - 13:00 Uhr",[]]]],["schema:description",[["Die Wohnungslosenhilfe bietet vielfältige Dienste und Hilfeangebote für Menschen in sozialen Schwierigkeiten.\n\nBeratung, Information und Unterstützung in vielfältigen Problembereichen:\n\n * bei der Sicherung der materiellen Existenz\n * zur Beschaffung und/oder Sicherung einer Wohnung\n * bei der Bearbeitung und Klärung von persönlichen Lebensproblemen\n\nBedarfsgerechte Hilfe in vielfältiger Form aus einer Hand:\n\n * Beratungsstelle als zentrale Anlauf- und Clearingstelle\n * Flankierende Angebote wie Kontoführung/Etatberatung\n * Tagesstätte als Aufenthalts- und Versorgungsangebot\n * Ambulantes Betreutes Wohnen in eigener Wohnung\n * Pädagogische Wohngemeinschaft als teilstationäre Einrichtung\n * Spezielle Angebote für Frauen in sozialen Schwierigkeiten\n\nAnsprechpartner:\nDaniel Bröer \n\nSpendenkonto:\nVolksbank Marl-Recklinghausen Zw\nBankleitzahl: 42661008\nKonto: 718200301\nWohnungslosenhilfe",[]]]]]],["cdf:org-8722c0ae8791",0,[],[["schema:name",[["Diakonie Cuxland Schuldnerberatung - Schuldnerberatung",[]]]],["schema:address",[[["cdf:addr-c7b7b376e3af"],[]]]]]],["cdf:org-87244129fd5c",0,[],[["schema:name",[["Betreutes Einzelwohnen Team Süd",[]]]],["schema:address",[[["cdf:addr-844f1ff0657a"],[]]]]]],["cdf:org-8724cf1c5f43",0,[],[["schema:name",[["Sozialstation Bobingen gemeinnützige GmbH Ambulanter Dienst",[]]]],["schema:email",[["info@sozialstation-bobingen.de",[]]]],["schema:telephone",[["+49823496210",[]]]],["schema:mainEntityOfPage",[["htt