cription",[["Anerkannter Betreuungsverein",[]]]]]],["cdf:org-9f033a851932",0,[],[["schema:name",[["Caritasverband Fürth und Neustadt/Aisch e.V.",[]]]],["schema:email",[["sozialstation@caritas-fuerth.de",[]]]],["schema:telephone",[["+49 (0911) 236055-50",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/107133",[]]]],["dct:modified",[["2026-08-10T12:17:42+00:00",[]]]],["schema:address",[[["cdf:addr-342d0dc994b1"],[]]]],["schema:alternateName",[["Caritas-Sozialstation Fürth",[]]]],["foaf:homepage",[["http://www.caritas-fuerth.de",[]]]],["schema:description",[["Caritas-Sozialstation Fürth: \n\n\nUNSERE ANGEBOTE\n\nBehandlungspflege\nWir übernehmen ärztlich verordnete medizinische Leistungen bei Ihnen zu Hause, zum Beispiel Medikamentengabe, Wundversorgung, Injektionen, Kompressionsversorgung oder weitere behandlungspflegerische Maßnahmen.\n\nGrundpflege\nWir unterstützen Sie individuell bei den Aktivitäten des täglichen Lebens – zum Beispiel bei der Körperpflege, beim An- und Auskleiden, bei der Mobilität sowie bei weiteren persönlichen Bedürfnissen. Dabei stehen Ihre Selbstständigkeit und Ihre Gewohnheiten im Mittelpunkt.\n\nPflegeberatung\nWir beraten Pflegebedürftige und Angehörige kompetent und persönlich zu allen Fragen rund um Pflege, Pflegeleistungen und Unterstützungsmöglichkeiten. Gemeinsam suchen wir nach Lösungen, die zu Ihrer individuellen Lebenssituation passen.\n\nBetreuung und individuelle Angebote\nNeben der pflegerischen Versorgung bieten wir individuelle Betreuung und Unterstützung im Alltag an. Dazu gehören zum Beispiel gemeinsame Gespräche, Spaziergänge, Begleitung bei alltäglichen Aktivitäten oder Beschäftigungsangebote – abgestimmt auf Ihre persönlichen Wünsche und Bedürfnisse.",[]]]]]],["cdf:org-9f05197d94c1",0,[],[["schema:name",[["Kindergarten St. Elisabeth, Stadtlohn",[]]]],["schema:email",[["kita.stelisabeth-stadtlohn@bistum-muenster.de",[]]]],["schema:telephone",[["+49 (02563) 400000500",[]]]],["schema:mainEntityOfPage",[["