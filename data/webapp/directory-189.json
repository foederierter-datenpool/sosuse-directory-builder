df:org-814273f48f53",0,[],[["schema:name",[["Kath. Kirchengemeinde St. Gordianus",[]]]],["schema:email",[["st.Gordianus@t-online.de",[]]]],["schema:telephone",[["+4967165043",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/76512",[]]]],["schema:address",[[["cdf:addr-937c744ae2f8"],[]]]],["dct:modified",[["2021-08-25T11:34:54+00:00",[]]]]]],["cdf:org-814626260609",0,[],[["schema:name",[["Kath. Kindergarten St. Winfried",[]]]],["schema:email",[["kita.st.winfried.essen@kita-zweckverband.de",[]]]],["schema:telephone",[["+49201552297",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/101449",[]]]],["schema:address",[[["cdf:addr-a5ac0539dd9e"],[]]]],["dct:modified",[["2025-08-20T13:46:35+00:00",[]]]],["schema:description",[["Kath. Kindergarten St. Winfried",[]]]]]],["cdf:org-81492028cd68",0,[],[["schema:name",[["Sozialdienst katholischer Frauen e.V. Diözese Rottenburg-Stuttgart",[]]]],["schema:email",[["fbz@skf-drs.de",[]]]],["schema:telephone",[["+4971124892341",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/107592",[]]]],["schema:address",[[["cdf:addr-339c233e8113"],[]]]],["dct:modified",[["2025-08-20T19:08:41+00:00",[]]]],["schema:alternateName",[["FrauenBerufsZentrum",[]]]],["foaf:homepage",[["https://www.skf-stuttgart.de/frauen-und-beruf/index.php",[]]]],["schema:description",[["Das FrauenBerufsZentrum (FBZ) unterstützt Frauen in besonderen Lebenssituationen mit verschiedenen kostenfreien Angeboten zur beruflichen Förderung.\n\nWir beraten und unterstützen:\n\n * alleinerziehende Frauen\n * Frauen ohne und ohne ausreichende Schul- und Berufsausbildung\n * Frauen die nach der Familienzeit ins Erwerbsleben einsteigen wollen\n * Frauen mit ausländischen Wurzeln\n * ältere Frauen\n * Frauen im Wohnungsnotfall\n * Frauen mit gesundheitlichen Beeinträchtigungen\n\nDie Leistungen des FBZ beinhalten für Frauen aus Stuttgart, die sich beruflich auf den Weg machen wollen und den (Wieder-)Einstieg ins Erwerbsleben anstreben, u.a.\n\n * berufliche Beratung\n * Unterstützung bei Klärung der persönlichen und beruflichen Situation\n * Bewerbungsunterstützung\n * berufsbezogene Gruppenangebote\n * Hilfestellung bei der Arbeitsplatzsuche\n\nWir arbeiten ganzheitlich und verweisen bei Bedarf auf weitere Möglichkeiten der Unterstützung. Zudem bietet das FBZ im Rahmen von \"FORUM FRAUEN\" eine spezielle berufliche Beratung für Frauen in Elternzeit \"Elternzeit - und dann?\" an und für Frauen, die  in den  Beruf (wieder-) einsteigen wollen, eine Beratung zur Beschäftigungsaufnahme \"Startklar - Arbeit sofort!\".",[]]]]]],["cdf:org-81498dfe1318",0,[],[["schema:name",[["Caritasverband Frankfurt e.V.",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/109162",[]]]],["schema:address",[[["cdf:addr-029d9677a731"],[]]]],["dct:modified",[["2009-08-19T14:23:43+00:00",[]]]],["schema:alternateName",[["Projekt schulische Hilfen",[]]]]]],["cdf:org-814b1192fc4d",0,[],[["schema:name",[["Diakonisches Werk Hamburg Nord - Schuldnerberatung Barmbek-Süd",[]]]],["schema:address",[[["cdf:addr-9df4a966cb54"],[]]]]]],["cdf:org-814f90ac8aa2",0,[],[["schema:name",[["Johannesverein e. V.",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/109655",[]]]],["schema:address",[[["cdf:addr-bbf67ba358bf"],[]]]],["dct:modified",[["2023-01-12T09:02:13+00:00",[]]]]]],["cdf:org-8150fcee4517",0,[],[["schema:name",[["Caritasverband Ostvest e. V.",[]]]],["schema:email",[["ah-datteln@caritas-ostvest.de",[]]]],["schema:telephone",[["+492363565636",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/82480",[]]]],["schema:address",[[["cdf:addr-c0c875c5a62c"],[]]]],["dct:modified",[["2026-05-11T14:34:17+00:00",[]]]],["schema:alternateName",[["Ambulanter Hospiz-und Beratungsdienst",[]]]],["foaf:homepage",[["http://www.caritas-Ostvest.de",[]]]]]],["cdf:org-8151ceefd9c1",0,[],[["schema:name",[["Antoniusheim Münchshöfen",[]]]],["schema:email",[["info@antoniusheim-kjf.de",[]]]],["schema:telep