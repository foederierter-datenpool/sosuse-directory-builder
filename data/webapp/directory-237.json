im Sankt Raphael",[]]]]]],["cdf:org-c727df9096d1",0,[],[["schema:name",[["Caritas Alten- und Pflegezentrum Heilige Familie",[]]]],["schema:email",[["hl.familie@caritas-dn.de",[]]]],["schema:telephone",[["+49 (2463) 970-0",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/107026",[]]]],["dct:modified",[["2025-04-09T10:03:43+00:00",[]]]],["schema:address",[[["cdf:addr-f85a1622c675"],[]]]],["foaf:homepage",[["https://www.caritasverband-dueren.de/",[]]]],["schema:description",[["Das Alten- und Pflegezentrum Heilige Familie befindet sich seit 1996 in ruhiger Lage in Titz-Hasselsweiler, einem idyllischen Ort im Norden des Kreises Düren. In der umgebenden gepflegten Grünanlage können alle Wege von Gehbehinderten und Rollstuhlfahrern barrierefrei genutzt werden.\nUnser Pflegekonzept ist ausgerichtet auf die individuelle Pflege und Begleitung von Menschen, die aufgrund von körperlichen,  seelischen und geistigen Beeinträchtigungen auf professionelle Hilfe angewiesen sind.\nDas Betreuungsangebot umfasst alle Bereiche rund um das Leben im Alter. Zu den Leistungen der vollstationären Pflege, Kurzzeitpflege und Verhinderungspflege bieten wir soziale und seelsorgerische Betreuung an.",[]]]]]],["cdf:org-c7292624cab1",0,[],[["schema:name",[["AWO Familienglobus gGmbH - Schuldner und Insolvenzberatung",[]]]],["schema:address",[[["cdf:addr-a60e8e9b2d0c"],[]]]]]],["cdf:org-c72ff8a47da1",0,[],[["schema:name",[["Kath. Kindergarten Don Bosco (431.60)",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/78184",[]]]],["dct:modified",[["2014-02-20T15:23:10+00:00",[]]]],["schema:address",[[["cdf:addr-5422984ee3fd"],[]]]]]],["cdf:org-c739666c84df",0,[],[["schema:name",[["Private Marienschule",[]]]],["schema:email",[["Sekretariat@marienschule-limburg.de",[]]]],["schema:telephone",[["+49 (06431) 201-250",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/108793",[]]]],["dct:modified",[["2025-08-20T17:21:05+00:00",[]]]],["schema:address",[[["cdf: