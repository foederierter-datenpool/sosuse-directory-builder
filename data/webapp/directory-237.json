leiten Freiwillige durch Beratung, Fortbildung und Gesprächskreise.",[]]]]]],["cdf:org-c73d2acc3989",0,[],[["schema:name",[["WIR-KITAs gem. GmbH",[]]]],["schema:email",[["maria-frieden-lipperbruch@wirkitas.nrw",[]]]],["schema:telephone",[["+49 (02941) 80430",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/95863",[]]]],["dct:modified",[["2025-09-04T06:28:28+00:00",[]]]],["schema:address",[[["cdf:addr-b7cf363192d6"],[]]]],["schema:alternateName",[["Kath. Kindertageseinrichtung Maria-Frieden\r\n",[]]]],["foaf:homepage",[["www.familienzentrum-maria-frieden.de",[]]]]]],["cdf:org-c73e9a43c680",0,[],[["schema:name",[["Stiftung SOLVEnt - Schuldner- und Insolvenzberatung Springe",[]]]],["schema:email",[["info@stiftung-solvent.de",[]]]],["schema:telephone",[["05041776805",[]]]],["schema:address",[[["cdf:addr-59f476d0d454"],[]]]],["schema:openingHours",[["Termine auf Anfrage",[]]]]]],["cdf:org-c73f6293aa5a",0,[],[["schema:name",[["Kath. Kindergarten Don Bosco (891.50)",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/87160",[]]]],["dct:modified",[["2012-04-12T08:27:00+00:00",[]]]],["schema:address",[[["cdf:addr-ce74c8632fa9"],[]]]]]],["cdf:org-c73ffe3c759a",0,[],[["schema:name",[["IN VIA Lübeck e.V.",[]]]],["schema:email",[["gottschlich@invia-luebeck.de",[]]]],["schema:telephone",[["+49 (0157) 80457168",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/1449698",[]]]],["dct:modified",[["2021-10-26T13:50:51+00:00",[]]]],["schema:address",[[["cdf:addr-bf3c67e193e7"],[]]]],["schema:alternateName",[["Betreute Grundschule an der Grundschule Lübeck-Niendorf",[]]]],["foaf:homepage",[["www.invia-luebeck.de",[]]]]]],["cdf:org-c7413dfb4ff8",0,[],[["schema:name",[["Caritas Seniorendienste Rhein-Kreis Neuss GmbH",[]]]],["schema:email",[["info@caritas-neuss.de",[]]]],["schema:telephone",[["+49 (02181) 238-00",[]],["+49 (02181) 23802",[]],["0218123800",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/1236327",[]]]],[