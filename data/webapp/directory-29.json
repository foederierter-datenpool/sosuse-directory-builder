arantiert, um Kontinuität und Qualität in der Betreuung und Unterstützung unserer Gemeinschaft zu gewährleisten.",[]]]]]],["cdf:org-146f6a84add2",0,[],[["schema:name",[["Betreutes Einzelwohnen für Menschen mit psychischer Erkrankung",[]]]],["schema:email",[["abw@caritas-rottal-inn.de",[]]]],["schema:telephone",[["+498561960718",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/561202",[]]]],["schema:address",[[["cdf:addr-439ebd8ec8d3"],[]]]],["dct:modified",[["2026-02-16T05:58:00+00:00",[]]]],["foaf:homepage",[["www.caritas-rottal-inn.de",[]]]]]],["cdf:org-14727b3ed137",0,[],[["schema:name",[["Caritas-Kreisstelle Nürnberg-Süd",[]]]],["schema:email",[["sozialberatung@caritas-nuernberg-sued.de",[]]]],["schema:telephone",[["+499116493160",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/3147092",[]]]],["schema:address",[[["cdf:addr-99126c136b11"],[]]]],["dct:modified",[["2025-10-28T13:33:32+00:00",[]]]],["schema:alternateName",[["Außenstelle Eibach / Allgemeine Sozialberatung",[]]]],["foaf:homepage",[["http://www.caritas-kreisstelle-nuernberg.de",[]]]]]],["cdf:org-1475003315a3",0,[],[["schema:name",[["SKFM Papenburg e.V.",[]]]],["schema:email",[["info@skfm-papenburg.de",[]]]],["schema:telephone",[["+494961660780",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/81697",[]]]],["schema:address",[[["cdf:addr-243e0a501746"],[]]]],["dct:modified",[["2026-03-27T10:34:15+00:00",[]]]],["schema:alternateName",[["Projekt \"Integration durch Arbeit\"",[]]]],["foaf:homepage",[["http://www.skfm-papenburg.de",[]]]],["schema:description",[["SKFM-Sozialdienst kath. Frauen und Männer e. V. -Arbeitsprojekt-",[]]]]]],["cdf:org-1476b789fbf1",0,[],[["schema:name",[["Kath. Pfarrkirchenstiftung Simbach/Inn",[]]]],["schema:email",[["pfarramt.simbach.inn@bistum-passau.de",[]]]],["schema:telephone",[["+4985718650",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/89898",[]]]],["schema:address",[[["cdf:addr-3a660e74c901"],[