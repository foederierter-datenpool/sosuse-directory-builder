,[]]]],["schema:email",[["haus-antonius@caritas-pb.de",[]]]],["schema:telephone",[["+495251161957310",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/709007",[]]]],["schema:address",[[["cdf:addr-a5420a53cfd4"],[]]]],["dct:modified",[["2025-08-20T18:24:31+00:00",[]]]],["schema:alternateName",[["Haus St. Antonius Zentrum für Menschen mit Demenz Kurzzeitpflege",[]]]],["foaf:homepage",[["www.caritas-pb.de",[]]]]]],["cdf:org-79331aca92fa",0,[],[["schema:name",[["Caritasverband Leipzig e.V.",[]]]],["schema:email",[["erziehungsberatung@caritas-leipzig.de",[]]]],["schema:telephone",[["+493419454767",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/76003",[]]]],["schema:address",[[["cdf:addr-8945a6437b2a"],[]]]],["dct:modified",[["2019-10-28T13:16:07+00:00",[]]]],["schema:alternateName",[["Erziehungsberatung",[]]]],["foaf:homepage",[["http://www.caritas-leipzig.de",[]]]]]],["cdf:org-793370d12153",0,[],[["schema:name",[["Stiftung Haus Lindenhof",[]]]],["schema:email",[["wg-grauleshof@haus-lindenhof.de",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/1053355",[]]]],["schema:address",[[["cdf:addr-bad90914cb55"],[]]]],["dct:modified",[["2025-08-20T19:07:27+00:00",[]]]],["schema:alternateName",[["Wohngemeinschaft Grauleshof Wohnen für Menschen mit Behinderung",[]]]],["foaf:homepage",[["www.haus-lindenhof.de",[]]]]]],["cdf:org-79349602f6b5",0,[],[["schema:name",[["Katholisches Kinderhaus St. Elisabeth Hoyerswerda",[]]]],["schema:email",[["kinderhaus@kath-hoyerswerda.de",[]]]],["schema:telephone",[["+493571978090",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/102158",[]]]],["schema:address",[[["cdf:addr-448a055d3ff0"],[]]]],["dct:modified",[["2026-03-27T11:44:11+00:00",[]]]],["foaf:homepage",[["http://www.kinderhaus-sankt-elisabeth.de",[]]]],["schema:description",[["Das Katholische Kinderhaus St. Elisabeth ist ein Haus für Kinder im Alter von 6 Monaten bis zu 10 Jahren. In den einzelnen Gruppen leben Kinder wie in einer Familie unterschiedlichen Alters zusammen.\nSeit Sommer 2008 leben und arbeiten wir mit den Kindern in fünf altersgemischten Gruppen (2 bis 6 Jahre), einer Krippengruppe (1 bis 3 Jahre) und einer Hortgruppe (6 bis 10 Jahre) zusammen.\nUnsere Hortgruppe ist seit 2007 nicht mehr bei uns im Kinderhaus, sondern in den oberen Räumen des Katholischen Jugendhauses, unweit des Kinderhauses untergebracht.\nIn insgesamt fünf Gruppen sind derzeit Kinder mit speziellem Förderbedarf integriert.\nUnsere Konzeption ist so ausgerichtet, dass sie den Kindern mit unterschiedlichen Bedürfnissen und Interessen gerecht wird und zu einer Atmosphäre der Geborgenheit, der Sicherheit und der Ruhe führt. In unserem Kinderhaus sollen die Kinder durch die Menschen erfahren:\n\n * ich bin erwünscht und geliebt,\n * ich bin für Andere und der Andere ist für mich da,\n * ich bin angenommen,\n * hier kann ich mich wohl fühlen und glücklich sein.\n\nJedes Kind soll werden, was ihm von Gott her zugesprochen ist. Das Kind ist vollwertiges \"Du\", das im Umgang, in der erzieherischen Begegnung, die Freiheit erhält, seine eigenen Möglichkeiten im Reden und Handeln zu entwickeln. Unserem Erziehungs- und Bildungsauftrag liegen bewährte Grundsätze der Pädagogik, so der \"Marchtaler Plan\" und die Erkenntnisse von Maria Montessori zugrunde.\n\nIhre Ansprechpartnerin:\nAnke Schulz",[]]]]]],["cdf:org-79414c989e0f",0,[],[["schema:name",[["Caritasverband Herten e.V.",[]]]],["schema:email",[["info@caritas-herten.de",[]]]],["schema:telephone",[["+4923663040",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/77900",[]]]],["schema:address",[[["cdf:addr-8f5a873505d5"],[]]]],["dct:modified",[["2020-06-03T11:36:18+00:00",[]]]],["schema:alternateName",[["Geschäftsstelle",[]]]],["foaf:homepage",[["http://www.caritas-herten.de",[]]]],["schema:description",[["Geschäftsführer:\nJan Hindrichs\nj.hindrichs@caritas-herten.de\n\nMarkus Lerche\nm.lerche@caritas-herten.de",[]]]]]],["cdf:org-