ed",[["2023-03-30T11:57:45+00:00",[]]]],["schema:alternateName",[["Geschäftsstelle",[]]]],["foaf:homepage",[["http://www.caritas-oberlausitz.de",[]]]],["schema:description",[["Caritasverband Oberlausitz e.V Geschäftsstelle",[]]]]]],["cdf:org-796bfb878c7a",0,[],[["schema:name",[["St. Vincenzstift gGmbH",[]]]],["schema:email",[["mail@st-vincenzstift.de",[]]]],["schema:telephone",[["+4967229010",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/87365",[]]]],["schema:address",[[["cdf:addr-ff4715ab0337"],[]]]],["dct:modified",[["2018-03-11T18:28:57+00:00",[]]]],["foaf:homepage",[["http://www.st-vincenzstift.de",[]]]],["schema:openingHours",[["mail@st-vincenzstift.de\r\n06722/901-0\r\nübliche Bürozeiten: 8:00 - 17:00 Uhr",[]]]],["schema:description",[["St. Vincenzstift gGmbH",[]]]]]],["cdf:org-796c16feac97",0,[],[["schema:name",[["Caritas Rheine - Marienstift Betreutes Wohnen",[]]]],["schema:email",[["marienstift@caritas-rheine.de",[]]]],["schema:telephone",[["+4959718660",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/110341",[]]]],["schema:address",[[["cdf:addr-8f0ea270ae4a"],[]]]],["dct:modified",[["2024-06-11T14:36:05+00:00",[]]]],["foaf:homepage",[["https://www.caritas-rheine.de/altenwohnanlagen",[]]]],["schema:description",[["Insgesamt 31 alten- und behindertengerechte Wohnungen in der Größe von 40 bis 7 qm stehen für das Betreute Wohnen zur Verfügung und können von Menschen ab 60 Jahren gemietet werden. Die räumliche Verbindung zu den Hauptgebäuden sowie die Rufanlage vermitteln Sicherheit und die Garantie, rund um die Uhr notwendige Hilfen abrufen zu können. Ganz nach den persönlichen Wünschen und Anforderungen kann das eigene Dienstleistungspaket zusammengestellt werden. Angefangen vom Mittagstisch über Wohnungs- und Wäschereinigung bis hin zum Pflegebad stehen die Angebote der Altenwohnanlagen zur Verfügung. Darüber hinaus ist eine garantierte Übernahme bei Eintritt von Pflegebedürftigkeit in eine der Wohnungen im Wohn- und Pflegebereich gesichert.\n\nAnsprechpartnerin: Margarethe Lemke",[]]]]]],["cdf:org-79714d4fbddb",0,[],[["schema:name",[["Caritasverband für den Landkreis Deggendorf e.V.",[]]]],["schema:email",[["schuldnerberatung@caritas-deggendorf.de",[]]]],["schema:telephone",[["+49991389740",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/72648",[]]]],["schema:address",[[["cdf:addr-527cdd284786"],[]]]],["dct:modified",[["2025-08-20T18:50:18+00:00",[]]]],["schema:alternateName",[["Schuldner- und Insolvenzberatungsstelle",[]]]],["foaf:homepage",[["http://www.caritas-deggendorf.de",[]]]]]],["cdf:org-7977b91d1026",0,[],[["schema:name",[["Altenheim Immaculata",[]]]],["schema:email",[["info@altenheim-immaculata.de",[]]]],["schema:telephone",[["+4921319168303",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/99369",[]]]],["schema:address",[[["cdf:addr-ba68c4e592ff"],[]]]],["dct:modified",[["2026-07-13T06:04:41+00:00",[]]]],["schema:description",[["Altenheim Kloster Immaculata",[]]]]]],["cdf:org-7979250a092d",0,[],[["schema:name",[["Antoniuskloster",[]]]],["schema:telephone",[["+4925912340",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/75528",[]]]],["schema:address",[[["cdf:addr-99c89aaddd59"],[]]]],["dct:modified",[["2018-03-10T13:16:01+00:00",[]]]],["schema:description",[["Antoniuskloster",[]]]]]],["cdf:org-797990ed1a77",0,[],[["schema:name",[["Kappeskindergarten",[]]]],["schema:telephone",[["+49621853319",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/91752",[]]]],["schema:address",[[["cdf:addr-dfa2f34ad023"],[]]]],["dct:modified",[["2011-11-10T11:22:16+00:00",[]]]],["foaf:homepage",[["http://kath.kirche-mannheim.de/",[]]]]]],["cdf:org-797b7ff691db",0,[],[["schema:name",[["Ambulante Hilfe Neustadt",[]]]],["schema:address",[[["cdf:addr-397a59e5638c"],[]]]]]],["cdf:org-797c0a4bd7a8",0,[],[["schema:name",[["Caritasverband Bruchsal e.V.",[]]]],["schema:email",[["info.sstforst@caritas-bruchsal.de",[]]]],["schema:telephone",[["+4972513661717",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/104270",[]]]],["schema:address",[[["cdf:addr-beaa8e2d3ab1"],[]]]],["dct:modified",[["2025-12-19T06:40:26+00:00",[]]]],["schema:alternateName",[["Sozialstation St. Elisabeth Forst",[]]]],["foaf:homepage",[["http://www.caritas-bruchsal.de",[]]]],["schema:description",[["Unsere Angebote\n\n * Kranken- und Altenpflege: Für Sie sind ausschließlich examinierte Kranken- und Altenpflegerinnen für alle medizinischen Leistungen wie u. a. Spritzen und Verbände da. Selbstverständlich unterstützen wir Sie bei Ihrer Körperpflege.\n * Familienpflege: Haushaltsführung und Kinderbetreuung, wenn die Mutter oder der Vater vertreten oder entlastet werden soll, z. B. während eines Krankenhausaufenthaltes, bei der Entbindung, bei schwerer Krankheit.\n * Hauspflegedienst: Unterstützung bei allen hauswirtschaftlichen Tätigkeiten wie Zubereitung von Mahlzeiten, Einkaufen oder Waschen, Bügeln, Putzen. Gern geben wir auch Hilfestellung beim Verlassen oder Wiederaufsuchen der Wohnung. Diese Leistungen können bei vorhandener Pflegestufe mit den Pflegekassen abgerechnet werden.\n * Ökumenischer Hospizdienst: Dasein bei schwerer Krankheit oder in der letzten Lebensphase.\n * Essen auf Rädern: Ausgewogene Ernährung bringen wir Ihnen direkt nach Hause.\n * Hausnotruf: Hilfe für kritische Lebenssituationen bei Tag und Nacht\n\nUnser Einzugsgebiet\n\nWir pflegen Menschen in Forst, Hambrücken, Karlsdorf, Neuthard, Stettfeld, Ubstadt, Weiher und Zeutern.\n\nWir leiten unseren Anspruch auf ganzheitliche Pflege von unserem christlichen Grundauftrag ab.\n\nWir helfen allen Menschen im Einzugsgebiet, unabhängig von Nationalität, Konfession oder der Weltanschauung.\n\nWir begleiten Sie in Krankheit und Alter durch unsere fachlich qualifizierten Pflegekräfte und unterstützen Sie gemäß unserem Leistungsangebot.\n\nWir  fördern die Erhaltung Ihrer Selbstständigkeit mit dem Ziel, dass Sie so lange wie möglich zu Hause bleiben können.\n\nWir betrachten die Sterbebegleitung als zentrale Aufgabe im Sinne unseres christlichen Verständnisses.\n\nWir  wollen Ihnen ein wenig Last abnehmen, gemeinsam einen Weg gehen.\n\nÖffnungszeiten\n\nDas Büro ist werktags von 8.00 bis 16.00 Uhr besetzt. Sprechzeiten werden individuell und nach Ihren Wünschen vereinbart. Gern kommen wir zu Ihnen nach Hause. Über eine Rufbereitschaft sind wir rund um die Uhr zu erreichen.",[]]]]]],["cdf:org-797f42c82a9e",0,[],[["schema:name",[["Kath. Pfarramt St. Otto",[]]]],["schema:telephone",[["+4989606023",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/75905",[]]]],["schema:address",[[["cdf:addr-5fc054e29b1f"],[]]]],["dct:modified",[["2018-03-11T19:10:35+00:00",[]]]]]],["cdf:org-797ff337760d",0,[],[["schema:name",[["Schuldnerberatung Lüneburger Heide e.V.",[]]]],["schema:address",[[["cdf:addr-f586fe2d2155"],[]]]]]],["cdf:org-7984d20b1858",0,[],[["schema:name",[["Kath. Kindergarten St. Johannes",[]]]],["schema:email",[["st-johannes.roehrmoos@kita.ebmuc.de",[]]]],["schema:telephone",[["+4981396544",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/72566",[]]]],["schema:address",[[["cdf:addr-c7329081421b"],[]]]],["dct:modified",[["2025-08-20T17:56:54+00:00",[]]]],["foaf:homepage",[["www.kindergarten-st-johannes-roehrmoos.de",[]]]],["schema:description",[["Kath. Kindergarten St. Johannes",[]]]]]],["cdf:org-7989cc5614aa",0,[],[["schema:name",[["Caritas-Kreisstelle Nürnberg",[]]]],["schema:email",[["kreisstelle@caritas-nuernberg-sued.de",[]]]],["schema:telephone",[["+499118001107",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/81547",[]]]],["schema:address",[[["cdf:addr-248981bf8511"],[]]]],["dct:modified",[["2026-03-18T07:02:10+00:00",[]]]],["schema:alternateName",[["Kleiderkammer",[]]]],["foaf:homepage",[["http://www.caritas-kreisstelle-nuernberg.de",[]]]],["schema:description",[["Weitere Informationen finden Sie auf unserer Website (siehe Internetad