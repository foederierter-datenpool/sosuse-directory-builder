e/adressen/76786",[]]]],["schema:address",[[["cdf:addr-5764aee5654e"],[]]]],["dct:modified",[["2018-03-06T13:29:44+00:00",[]]]],["foaf:homepage",[["www.sankt-josefshaus.de",[]]]],["schema:description",[["Das St. Josefshaus begleitet Menschen mit Behinderungen auf ihrem Lebensweg und hält für sie ein breites und auf den Einzelnen zugeschnittenes Angebot der Assistenz, Förderung und Pflege bereit.\n\nUnsere Ausrichtung zielt auf Wachheit, Wahrnehmung und Authentizität. Dadurch möchten wir im alltäglichen Geschehen eine ehrliche, stimmige Haltung im Austausch untereinander und mit anderen Menschen finden.\n\nMit wachem Geist, spürbarem Gehör und ruhigem, gewaltfreien Blick möchten wir uns engagiert einbringen für jeden Menschen, der bei uns eine Heimat sucht. Um unsere Energien klar in eine Richtung wirken zu lassen, vergewissern wir uns unseres Rückgrats, unserer gemeinsamen Identität\n\n Sie können sich vorstellen hier zu arbeiten? Dann informieren Sie sich auf www.arbeiten-sankt-josefshaus.de",[]]]]]],["cdf:org-485f4d52c192",0,[],[["schema:name",[["St. Antonius-Krankenhaus",[]]]],["schema:telephone",[["+492638923",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/98028",[]]]],["schema:address",[[["cdf:addr-763094af6dfe"],[]]]],["dct:modified",[["2009-08-19T13:32:31+00:00",[]]]],["schema:alternateName",[["Waldbreitbach",[]]]]]],["cdf:org-485fabb8c8fc",0,[],[["schema:name",[["Kath. Kindertageseinrichtungen Ruhr-Mark gGmbH",[]]]],["schema:email",[["hildegard-iserlohn@kath-kitas-ruhr-mark.de",[]]]],["schema:telephone",[["+4923747887",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/95304",[]]]],["schema:address",[[["cdf:addr-d588cfb2e65a"],[]]]],["dct:modified",[["2025-08-20T18:19:13+00:00",[]]]],["schema:alternateName",[["Kath. Kindergarten St. Hildegard",[]]]]]],["cdf:org-486241702761",0,[],[["schema:name",[["Schuldner- und Insolvenzberatung Pinneberg",[]]]],["schema:address",[[["cdf:addr-3cf19c1703f9"],[]]]]]],["cdf:org-48628c4efa