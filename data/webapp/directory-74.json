address",[[["cdf:addr-0403809f50c5"],[]]]],["dct:modified",[["2025-03-20T13:18:33+00:00",[]]]],["schema:alternateName",[["Katholische Pfarrei St. Maria Mater Dolorosa Finsterwalde",[]]]],["foaf:homepage",[["http://www.kath-finsterwalde.de",[]]]],["schema:description",[["Die katholische Pfarrgemeinde St. Maria, Mater Dolorosa befindet sich in der Stadt Finsterwalde und liegt im Dekanat Lübben-Senftenberg des Bistums Görlitz im Landkreis Elbe-Elster des Landes Brandenburg. Sie umfasst Finsterwalde, Doberlug-Kirchhain und Tröbitz.\n\nGottesdienstzeiten:\n\nSamstag:\n18.00 Uhr Vorabendmesse in Doberlug-Kirchhain\n\nSonntag:\n09:00 Uhr Heilige Messe in Tröbitz\n10.00 Uhr Hochamt in Finsterwalde\n17:00 Uhr Vespergottesdienst in Finsterwalde\n\nAnsprechpartner:\nPfarrer Dr. Artur Zuk",[]]]]]],["cdf:org-321d9d12dd95",0,[],[["schema:name",[["Katholische Hochschule Freiburg gGmbH",[]]]],["schema:email",[["rektorat@kh-freiburg.de",[]]]],["schema:telephone",[["+497612001501",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/81996",[]]]],["schema:address",[[["cdf:addr-347b4e0a7946"],[]]]],["dct:modified",[["2025-08-20T16:33:31+00:00",[]]]],["foaf:homepage",[["http://www.kh-freiburg.de",[]]]],["schema:description",[["Die Katholische Hochschule Freiburg ist eine Hochschule für das Sozial- und Gesundheitswesen, die neben Bachelor- und Masterstudiengängen auch Weiterbildungen anbietet sowie in der angewandten Forschung tätig ist. Rechtsträger der KH Freiburg ist eine gemeinnützige GmbH, deren Gesellschafter die Erzdiözese Freiburg, die Diözese Rottenburg-Stuttgart, der Deutsche Caritasverband e.V. sowie die Diözesan-Caritasverbände Freiburg und Rottenburg-Stuttgart sind.\n\nDie KH Freiburg ist die größte Hochschule des Sozial- und Gesundheitswesens in Baden-Württemberg. Ca. 1.900 Studierende sind an ihr immatrikuliert, 37 Professor*innen sowie ca. 160 Lehrbeauftragte sind an ihr tätig. Das Studienangebot der KH Freiburg umfasst ein breites Spektrum – von Sozialer Arbeit über Heilpädagogik bis hin zum Management. Dabei orientiert sich die Hochschule am christlichen Menschenbild und steht ein für Weltoffenheit, Toleranz und Solidarität.\n\n \n\nAnsprechpartner:\n\nDr. Johannes Keller-Herder\n\nRektor",[]]]]]],["cdf:org-32209a8e6517",0,[],[["schema:name",[["Kath. Kirchengemeinde St. Maria Magdalena Dorn-Assenheim",[]]]],["schema:telephone",[["+4960355196",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/85248",[]]]],["schema:address",[[["cdf:addr-58012f32d6ac"],[]]]],["dct:modified",[["2021-08-25T11:35:02+00:00",[]]]]]],["cdf:org-322129ac755c",0,[],[["schema:name",[["Familienwerk Sölden Station Stetten",[]]]],["schema:email",[["info@familienwerk-soelden.de",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/87933",[]]]],["schema:address",[[["cdf:addr-d265920e0989"],[]]]],["dct:modified",[["2024-08-19T09:10:38+00:00",[]]]],["foaf:homepage",[["www.dorfhelferinnenwerk.de",[]]]],["schema:description",[["Dorfhelferinnenstation Stetten",[]]]]]],["cdf:org-322184438fff",0,[],[["schema:name",[["Caritasverband Offenbach/Main e.V.",[]]]],["schema:email",[["info@cv-offenbach.de",[]]]],["schema:telephone",[["+496984005126",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/97462",[]]]],["schema:address",[[["cdf:addr-d225b417b998"],[]]]],["dct:modified",[["2025-08-20T17:33:50+00:00",[]]]],["schema:alternateName",[["Geschäftsstelle",[]]]],["foaf:homepage",[["www.caritas-offenbach.de",[]]]],["schema:description",[["Caritasverband Offenbach/Main e.V.",[]]]]]],["cdf:org-32230502b65d",0,[],[["schema:name",[["Katholische Jugendfürsorge der Diözese Regensburg e.V.",[]]]],["schema:email",[["info@lernwerkstatt-regensburg.de",[]]]],["schema:telephone",[["+49941464570",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/99358",[]]]],["schema:address",[[["cdf:addr-fba294d72cb4"],[]]]],["dct:modified",[["2025-08-20T18:49:36+00:00",[]]]],["schema:alternateName",[["Lernwerkstatt",[]]]],["f