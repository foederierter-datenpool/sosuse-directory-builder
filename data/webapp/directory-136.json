n 365 Tagen",[]]]],["schema:description",[["Caritas-Sozialstation Ambulanter Pflegedienst\n\n…ihr Partner für Pflege, Beratung und Betreuung\n\nSie wollen solange wie möglich zu Hause wohnen, trotz Pflegebedürftigkeit, Krankheit oder Hilfebedarf ?\n\nWir unterstützen Sie und können dabei auf 30 Jahre Pflege-Erfahrung zurückgreifen.\n\nNeben umfassenden Pflegeleistungen können wir Ihnen weitere Dienstleistungen, wie beispielsweise hauswirtschaftliche Versorgung, Gesprächskreise für pflegende Angehörige, Hausnotruf und fahrbarem, (warmen) Mittagstisch anbieten.\n\nWir sind rund um die Uhr für Sie erreichbar.\n\nRufen Sie uns an, wir beraten Sie gerne auch zu weiteren Hilfsangeboten.\n\nAnsprechpartnerin:\n\nMelanie Bischof\nsozialstation-pruem@caritas-westeifel.de",[]]]]]],["cdf:org-5d95a102d9ee",0,[],[["schema:name",[["Deutsche Pfadfinderschaft St. Georg Bundesamt St. Georg e.V.",[]]]],["schema:email",[["info@dpsg.de",[]]]],["schema:telephone",[["+492131469937",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/72368",[]]]],["schema:address",[[["cdf:addr-59f6f7ec85ba"],[]]]],["dct:modified",[["2019-01-31T09:48:03+00:00",[]]]],["foaf:homepage",[["www.dpsg.de",[]]]],["schema:description",[["Deutsche Pfadfinderschaft St. Georg Bundesamt St. Georg e.V.",[]]]]]],["cdf:org-5d976ad5f85f",0,[],[["schema:name",[["Ortscaritasverein Marktsteinach e. V.",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/90814",[]]]],["schema:address",[[["cdf:addr-bbf67ba358bf"],[]]]],["dct:modified",[["2022-12-01T06:28:20+00:00",[]]]],["schema:description",[["Ortcaritasverein Marktsteinach e. V.",[]]]]]],["cdf:org-5d9b6d30ef91",0,[],[["schema:name",[["Berufsfachschule für Altenpflegehilfe - Caritas Berufsbildungszentrum für Soziale Berufe",[]]]],["schema:email",[["schulen@caritas-bbz-zwiesel.de",[]]]],["schema:telephone",[["+49992284640",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/73419",[]]]],["schema:address",[[["cdf:addr-69fc0b44045c"