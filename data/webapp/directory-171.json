[["cdf:org-74cfde5a6f20",0,[],[["schema:name",[["SKM - Katholischer Verein für soziale Dienste in Dortmund e. V.",[]]]],["schema:email",[["ewerth@skm-dortmund.de",[]]]],["schema:telephone",[["+492311848117",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/90693",[]]]],["schema:address",[[["cdf:addr-bd907d63bb19"],[]]]],["dct:modified",[["2025-08-20T18:26:54+00:00",[]]]],["schema:alternateName",[["Betreuungsverein",[]]]],["foaf:homepage",[["www.skm-dortmund.de",[]]]],["schema:description",[["SKM - Katholischer Verein für soziale Dienste in Dortmund e. V.",[]]]]]],["cdf:org-74d1316dd4e8",0,[],[["schema:name",[["Kath. Kindergarten St. Viktor",[]]]],["schema:email",[["kita.stviktor-xanten@bistum-muenster.de",[]]]],["schema:telephone",[["+4928012599",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/98793",[]]]],["schema:address",[[["cdf:addr-a08db81c5379"],[]]]],["dct:modified",[["2021-07-13T09:28:14+00:00",[]]]],["schema:alternateName",[["St. Viktor",[]]]]]],["cdf:org-74d3a1d3519c",0,[],[["schema:name",[["Kath. Kirchenstiftung St. Blasius Engetried",[]]]],["schema:email",[["kiga.engetried@bistum-augsburg.de",[]]]],["schema:telephone",[["+498392268",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/103707",[]]]],["schema:address",[[["cdf:addr-38d18c8e7b71"],[]]]],["dct:modified",[["2026-07-13T07:48:47+00:00",[]]]]]],["cdf:org-74d50e34bbab",0,[],[["schema:name",[["Caritas-Förderzentrum Edith Stein",[]]]],["schema:email",[["edith-stein@cbs-speyer.de",[]]]],["schema:telephone",[["+49684251020",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/108591",[]]]],["schema:address",[[["cdf:addr-bd528ba0a397"],[]]]],["dct:modified",[["2025-08-20T19:14:17+00:00",[]]]],["schema:alternateName",[["Soziotherapie",[]]]],["foaf:homepage",[["www.edithstein-cbs-speyer.de",[]]]],["schema:description",[["Wer kann sich an unsere Dienste wenden?\n\n\n\n\n\nUnsere Dienste richten sich an:\n\n\n\n * Menschen mit chronisch psychischen Erkrankungen\n   \n * Familienangehörige von psychisch Erkrankten\n   \n * Diejenigen, die im sozialen Umfeld eines psychisch erkrankten Menschen leben\n\nWas leisten unsere Dienste?\n\n\n\n * Kontaktaufnahme schon während der stationären Behandlung, wenn eine ambulante Nachsorge angestrebt wird.\n   \n * Durchführung von Hausbesuchen. Aufsuchen des Klienten und der Angehörigen in ihrem sozialen Umfeld.\n   \n * Vermittlung und Koordination von Einzelhilfen im psychosozialen Versorgungsnetz.\n   \n * Psychosoziale Beratung.\n   \n * Hilfen bei der Bewältigung des Alltags, lebenspraktische Hilfen.\n   \n * Hilfen zur Sicherung von rechtlichen und materiellen Ansprüchen.\n   \n * Offene Kliententreffs, Clubangebote, Freizeitaktivitäten.\n   \n * Tagesstrukturierende Angebote.\n * Lebenspraktische Gruppenarbeit.\n   \n * Gesprächsorientierte Gruppenarbeit.\n\nWie arbeiten unsere Dienste?\n\n\n\nDie Inanspruchnahme unserer Dienste ist freiwillig und kostenlos. Lediglich in den Kontaktstellen entstehen u.U. geringe Kosten für persönliche Aufwendungen.\n\n\n\nDie haupt- und ehrenamtliche Mitarbeiter sind zur Vertraulichkeit verpflichtet und an die Schweigepflicht gebunden.\n\n\n\nUnsere Dienste kooperieren mit den niedergelassenen Ärzten und Nervenfachärzten, den zuständigen psychiatrischen Kliniken, sowie den anderen Diensten, Stellen und Ämtern im psychosozialen Versorgungsnetz.\n\n\n\nUnsere Angebote sind flexibel und orientieren sich im Rahmen unserer Möglichkeiten an den Bedürfnissen der psychisch erkrankten Menschen. Sie verstehen sich als Hilfe zur Selbsthilfe.\n\n\n\nUnsere Methoden sind: Einzel-, Paar- und Familienarbeit sowie Arbeit in Gruppen.\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nWann sind unsere Dienste geöffnet?\n\n\n\n\n\nDer Ambulant aufsuchende Dienst ist in der Regel von\n\n\n\nMontag ? Donnerstag von 8.00 ? 17.00 Uhr\n\nund Freitag von 8.00 ? 12.00 Uhr\n\n\n\nerreichbar.\n\n\n\nDa die Dienststellen wegen der aufsuchenden Arbeit nicht immer besetzt sein können, stehen Anrufbeantworter zur Verfügung.\n\n\n\nUNSER KONTAKTSTELLENANGEBOT \n\n\n\n\n\n\n\n\n\nMontags: ab 16.00 Uhr offener Treff\n\nMittwochs: ab 16.00 Uhr Mittwochstreff\n\nSamstags: ab 11.00 Uhr Kochen (14tägig)\n\nSamstags: ab 15.00 Uhr Kaffeeklatsch (14tägig)\n\n\n\nAnsprechpartner:\nMechthild Winter",[]]]]]],["cdf:org-74d6de03ba01",0,[],[["schema:name",[["Ehe-, Partnerschafts- und Familienberatung",[]]]],["schema:telephone",[["+49809222218",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/105886",[]]]],["schema:address",[[["cdf:addr-24a01b6a41a3"],[]]]],["dct:modified",[["2025-08-20T17:51:04+00:00",[]]]],["schema:alternateName",[["Beratungsstelle für Ehe-, Familien- und Lebensfragen",[]]]],["schema:description",[["Ehe-, Partnerschafts- und Familienberatung",[]]]]]],["cdf:org-74d8dc0a6c7e",0,[],[["schema:name",[["Kath. Kinderhaus St. Franziskus Kinderkrippe",[]]]],["schema:email",[["kita.ludwigsfeld@bistum-augsburg.de",[]]]],["schema:telephone",[["+4973117599420",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/88429",[]]]],["schema:address",[[["cdf:addr-c5e8f870c19c"],[]]]],["dct:modified",[["2026-07-10T09:14:31+00:00",[]]]],["foaf:homepage",[["www.nu-cuf.telebus.de",[]]]],["schema:description",[["Kath. Kinderhaus St. Franziskus Kinderkrippe",[]]]]]],["cdf:org-74dc845624ca",0,[],[["schema:name",[["Sozialwerk St. Georg e.V. WV Kontrapunkt Hamm-Heessen",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/73291",[]]]],["schema:address",[[["cdf:addr-4313879fdf14"],[]]]],["dct:modified",[["2025-08-20T13:45:13+00:00",[]]]],["foaf:homepage",[["http://www.sozialwerk-st-georg.de",[]]]],["schema:description",[["Sozialwerk St. Georg e.V. Haus Kontrapunkt Hamm",[]]]]]],["cdf:org-74dcfd50c258",0,[],[["schema:name",[["Diakonisches Werk Ingolstadt e. V. - Außenstelle LK Eichstätt/ Schuldnerberatung",[]]]],["schema:address",[[["cdf:addr-e9c2dca34a63"],[]]]]