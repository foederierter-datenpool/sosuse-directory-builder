0",[]]]],["schema:address",[[["cdf:addr-34f883ed3172"],[]]]],["foaf:homepage",[["www.skm-heidelberg.de",[]]]],["schema:description",[["SKM - Heidelberg Betreuungsverein für das Stadtgebiet Heidelberg",[]]]]]],["cdf:org-e4e0eb619fdc",0,[],[["schema:name",[["Studienseminar St. Joseph Schülerheim",[]]]],["schema:email",[["internat@st-stephan.de",[]]]],["schema:telephone",[["(0821) 32960",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/102253",[]]]],["dct:modified",[["2009-08-19T13:50:47+00:00",[]]]],["schema:address",[[["cdf:addr-c8010e66fbbf"],[]]]]]],["cdf:org-e4e194848bf6",0,[],[["schema:name",[["Seniorenhaus St. Anna Tagespflege",[]]]],["schema:email",[["st.anna@celltitinnen.de",[]]]],["schema:telephone",[["+49 (0221) 940523-0",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/75233",[]]]],["dct:modified",[["2019-08-06T11:30:08+00:00",[]]]],["schema:address",[[["cdf:addr-4b4251095291"],[]]]],["foaf:homepage",[["www.cellitinnen.de",[]]]],["schema:description",[["Seniorenhaus St. Anna Tagespflege",[]]]]]],["cdf:org-e4e5e5f89531",0,[],[["schema:name",[["Psychiatrisches Pflegeheim St. Elisabeth-Stift",[]]]],["schema:email",[["behlen-s@elisabeth-stift.de",[]]]],["schema:telephone",[["+49 (04472) 950-0",[]],["+49 (4472) 950-282",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/400553",[]]]],["dct:modified",[["2018-03-11T22:38:56+00:00",[]]]],["schema:address",[[["cdf:addr-847187a663bf"],[]]]],["foaf:homepage",[["http://www.Elisabeth-Stift.de",[]]]],["schema:description",[["WOHNEN MIT ATMOSPHÄRE\n\nUnser Pflegeheim bietet Platz für 63 Bewohnerinnen und Bewohner. Wir verfügen überwiegend über Einzelzimmer. Bei einer Unterbringung im\n\nZweibettzimmer schauen wir sensibel genau, welche Menschen miteinander auskommen und berücksichtigen die Wünsche. Alle Zimmer sind mit direkter Sanitäranbindung. Selbstverständlich gestalten die Bewohnerinnen und Bewohner Ihr Zimmer nach Ihren Wünschen und können einzelne liebgewonnene Möbel und Gegenstände mitbringen.\n\nRundum Pflege und Betreuung\n\nUnser multiprofessionelles Mitarbeiterteam besteht aus in der Alten- und in der psychiatrischen Pflege erfahrenen Fachkräften. In einer kleinen, familienähnlichen Gemeinschaft bzw. Wohngruppe haben die Bewohnerinnen und Bewohner feste Bezugspersonen und eine 24-Stunden-Betreuung.\n\nIn der Begleitung konzentrieren wir uns auf:\n\n\n\n * die psychische und körperliche Stabilisierung\n * eine ressourcenorientierte Betreuung und Pflege\n * die Förderung und Unterstützung der Entwicklung\n\n\n\nUns ist es wichtig, den Menschen dort abzuholen, wo er gerade ist, d.h. mit Geduld und Einfühlungsvermögen auf die individuelle Situation einzugehen. Wir bieten eine umfangreiche Arbeits- und Beschäftigungstherapie und setzen zur Stärkung der Sinneswahrnehmung u.a. auch auf Fußreflexzonenmassage und Klangmassage.\n\nDie medizinische Versorgung über Fachärzte erfolgt auch in Zusammenarbeit mit der Abteilung für Psychiatrie und Psychotherapie des Christlichen Krankenhauses in Quakenbrück. Die hausärztliche Versorgung erfolgt über die Hausärzte in Lastrup und der Region. Für die Sterbebegleitung haben wir ein besonderes Konzept. Wir arbeiten eng mit den Angehörigen, gesetzlichen Betreuern und dem Sozialdienst zusammen",[]]]]]],["cdf:org-e4e61369c7d8",0,[],[["schema:name",[["GBS Katholische Schule Katharina von Siena",[]]]],["schema:email",[["gbs-st.annen@kvs-hh.de",[]]]],["schema:telephone",[["+49 (040) 75698481",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/1703751",[]]]],["dct:modified",[["2023-07-18T13:52:26+00:00",[]]]],["schema:address",[[["cdf:addr-1769149d2367"],[]]]],["foaf:homepage",[["www.katharina-von-siena-schule.de/gbs",[]]]]]],["cdf:org-e4e79faec0e9",0,[],[["schema:name",[["St. Mariä Himmelfahrt Seniorenwerk GmbH",[]]]],["schema:telephone",[["+49 (0201) 8518-105",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/93968",[]]]],["dct:modified",[["2018-03-11T15:58:4