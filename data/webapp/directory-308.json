2a8443"],[]]]],["dct:modified",[["2018-03-11T19:06:35+00:00",[]]]],["foaf:homepage",[["www.erzbistum-muenchen.de/WiederkunftChristiKolber",[]]]]]],["cdf:org-d2f71d6270bb",0,[],[["schema:name",[["Caritas-Tagestreff Leinefelde",[]]]],["schema:email",[["inpetto@caritas-bistum-erfurt.de",[]]]],["schema:telephone",[["+4936052592160",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/75598",[]]]],["schema:address",[[["cdf:addr-276f7c0fdb3f"],[]]]],["dct:modified",[["2026-05-07T07:13:23+00:00",[]]]],["schema:alternateName",[["Caritas Sozialkaufhaus inpetto",[]]]],["schema:openingHours",[["Öffnungszeiten: Montag-Freitag 10.00-13.00 Uhr und von 14.00-16.00 Uhr",[]]]]]],["cdf:org-d2f79b65402f",0,[],[["schema:name",[["ambinius Kita: antonius : gemeinsam leben gGmbH",[]]]],["schema:email",[["s.rehm@antonius.de",[]]]],["schema:telephone",[["+49661250065201",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/77334",[]]]],["schema:address",[[["cdf:addr-bfea6f579756"],[]]]],["dct:modified",[["2025-01-21T10:08:19+00:00",[]]]],["schema:alternateName",[["ambinius Kita",[]]]],["foaf:homepage",[["http://www.antonius-fulda.de/lernen/antonius-kita.html",[]]]],["schema:description",[["ANTONIUS KITA\n\nDie antonius KITA ist eine inklusive Kindertagesstätte mit Bildungs-, Förder-, und Schutzauftrag zur Begleitung von Kindern ab 2 Jahren mit und ohne besonderem Förderbedarf. In insgesamt sieben Gruppen besuchen zurzeit rund 100 Kinder die antonius KITA.\n\nIn einem geschützten Rahmen lernen die Kinder, sich in ihrem Tempo, mit ihren eigenen Stärken, Schwächen, Fähigkeiten und denen der anderen auseinanderzusetzen. Sie werden angeregt, die Welt kennen zu lernen, zu hinterfragen und mit anderen in Beziehung zu sein. Die Arbeit der antonius KITA hat zum Ziel, Isolation und Ausgrenzung vorzubeugen, sowohl in der Gegenwart als auch in der Zukunft.\n\nEine besondere Gruppe in der antonius KITA sind die Gartenkinder. Am Konzept eines Waldkindergartens angelegt haben die Gartenkinder keine festen Räumlichkeiten in der antonius KITA. Sie spielen, lernen und toben auf dem Campus von antonius und entdecken die Welt mit zahlreichen Facetten. Unterschlupf finden sie in einem Bauwagen. Die meiste Zeit des Jahres sieht man sie aber draußen. So geht das tagaus, tagein, sommers wie winters. Spielerisch begreifen die Kinder, wozu man arbeitet, was durch Anstrengung entsteht. Tiere müssen gefüttert, Pflanzen gepflegt werden. All das lernen die Gartenkinder in ihrem Alltag.\n\nEine weitere Besonderheit der antonius KITA ist das Projekt \"ambinius\". Hier geht es darum, Angebote für Kinder und Senioren gemeinsam zu schaffen. Oftmals lernen Kinder, durch die berufsbedingte Mobilität der Eltern oder auf Grund der Tatsache, dass Paare immer später Kinder bekommen, nicht mehr ihre Großeltern kennen. Mit \"ambinius\" sollen Begegnungsmöglichkeiten zwischen den Generationen entstehen. Alle Informationen dazu finden Sie unter www.ambinius.de",[]]]]]],["cdf:org-d2ffdbd490d5",0,[],[["schema:name",[["Ganztagsschule Hohensteinschule",[]]]],["schema:telephone",[["+4917618107025",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/1322909",[]]]],["schema:address",[[["cdf:addr-7e3a4dac5377"],[]]]],["dct:modified",[["2018-10-18T16:56:32+00:00",[]]]],["schema:alternateName",[["Schulkindbetreuung",[]]]]]],["cdf:org-d3039af16d9c",0,[],[["schema:name",[["Katholische Sozialstation St. Vinzenz Lahr-Ettenheim e. V.",[]]]],["schema:email",[["info@sst-lahr-ettenheim.de",[]]]],["schema:telephone",[["+497821509590",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/90464",[]]]],["schema:address",[[["cdf:addr-476a448b0206"],[]]]],["dct:modified",[["2025-08-20T16:34:38+00:00",[]]]],["foaf:homepage",[["www.sst-lahr-ettenheim.de",[]]]],["schema:description",[["Unser Angebot\n\nIm Mittelpunkt stehen bei uns die üblichen Leistungen der Kranken- und Altenpflege. Darüber hinaus zeichnen wir uns durch folgende Angebote aus:\n\n \n\n * Betreuung Demenzkranker zur temporären Entlastung der Angehörigen\n * Hauswirtschaftliche Versorgung\n * Beratung\n * Hausnotruf \n\nUnser Einzugsgebiet\n\nWir pflegen Menschen in Lahr, Seelbach, Schuttertal, Friesenheim und Kippenheim.\n\nÖffnungszeiten - Erreichbarkeit\n\nDas Büro ist werktags von 8.00 bis 16.00 Uhr besetzt (freitags bis 14:00 Uhr). In dringenden Fällen sind wir auch außerhalb der Bürozeit für Sie erreichbar - über o.a. Telefonnummer via Rufumleitung auf Mobiltelefon der Rufbereitschaft.",[]]]]]],["cdf:org-d3039ea9267a",0,[],[["schema:name",[["Kath. Pfarrgemeinde Heilig Geist Braunschweig mit St. Elisabeth Wendeburg, St. Gereon Vechelde",[]]]],["schema:email",[["pfarrbuero@hl-geist-bs.de",[]]]],["schema:telephone",[["+4953152225",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/81699",[]]]],["schema:address",[[["cdf:addr-73749b9f1f0d"],[]]]],["dct:modified",[["2026-06-01T08:27:55+00:00",[]]]],["foaf:homepage",[["www.hl-geist-bs.de",[]]]]]],["cdf:org-d3041ba0c91e",0,[],[["schema:name",[["ZUHAUSE LEBEN Beratung",[]]]],["schema:email",[["zimmer-meyer@caritas-bodensee-oberschwaben.de",[]]]],["schema:telephone",[["+497515576547",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/479439",[]]]],["schema:address",[[["cdf:addr-b560f1730e0a"],[]]]],["dct:modified",[["2018-11-13T20:02:05+00:00",[]]]],["schema:alternateName",[["(Berg, Weingarten, Baienfurt, Baindt, Bergatreute, Wolfegg, Vogt)",[]]]]]],["cdf:org-d304c6aa8f46",0,[],[["schema:name",[["Sozialberatung im Obdach",[]]]],["schema:address",[[["cdf:addr-09b70ca33fe4"],[]]]]]],["cdf:org-d304dcaa1a2e",0,[],[["schema:name",[["PSK – Psychosomatische Klinik Bergisch Gladbach",[]]]],["schema:address",[[["cdf:addr-933ec3ced78b"],[]]]]]],["cdf:org-d305cc00fdcd",0,[],[["schema:name",[["Ernst-Ott-Seniorenzentrum Ökum.Sozialstat.Günzburg gGmbH Kurzzeitpflege",[]]]],["schema:telephone",[["+49822396850",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/94193",[]]]],["s