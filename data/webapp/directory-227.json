add033"],[]]]],["schema:alternateName",[["Jugendwohnverbund für Mädchen\r\nMädchenwohngruppe Riederwald",[]]]],["foaf:homepage",[["http://www.caritas-frankfurt.de",[]]]],["schema:openingHours",[["365 Tage, 24 Stunden",[]]]],["schema:description",[["Ansprechpartner*innen:\nLeitung:               Christine Resinek\nStellv.Leitung       Dr. Sabrina Bigos\n\nZielgruppe:\nDie Mädchenwohngruppe Riederwald ist Teil des Jugendwohnverbunds für Mädchen und bietet 19 Plätze für Mädchen ab 13 Jahren jeder Nationalität oder Religionszugehörigkeit, die wegen persönlicher oder sozialer Probleme nicht mehr bei ihren Familien leben können.\nBasierend auf einem systemischen Ansatz sehen wir die Jugendlichen nicht losgelöst von ihrer Herkunftsfamilie, sondern beziehen die Familie, sofern möglich, in die pädagogische Arbeit mit ein. So bieten wir auf freiwilliger Basis regelmäßige Eltern- oder Familiengespräche an.\n\nZiel unserer Arbeit ist die Aufarbeitung psychosozialer Defizite und eventueller Traumata in einem emotional stabilen und überschaubaren Rahmen.",[]]]]]],["cdf:org-bf328ca6656a",0,[],[["schema:name",[["Schuldner- und Insolvenzberatung Berlin-Mitte",[]]]],["schema:email",[["sib.mitte@caritas-berlin.de",[]]]],["schema:telephone",[["+49 (030) 66633-420",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/106508",[]]]],["dct:modified",[["2025-08-20T10:00:31+00:00",[]]]],["schema:address",[[["cdf:addr-1f508583bd14"],[]]]],["schema:alternateName",[["Caritas Erzbistum Berlin ",[]]]],["foaf:homepage",[["http://www.caritas-berlin.de",[]]]],["schema:description",[["Schuldner- und Insolvenzberatung der Caritas in Berlin-Mitte",[]]]]]],["cdf:org-bf348929f0c8",0,[],[["schema:name",[["Kirchengemeinde St. Matthäus",[]]]],["schema:telephone",[["+49 (02222) 2585",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/100738",[]]]],["dct:modified",[["2018-03-11T17:52:38+00:00",[]]]],["schema:address",[[["cdf:addr-6b37b892b7d3"],[]]]]]],["cdf:org-bf34dc8b08ec",0