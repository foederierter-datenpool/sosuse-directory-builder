epage",[["http://www.caritas-soest.de",[]]]]]],["cdf:org-eb9cc25faeed",0,[],[["schema:name",[["Schuldner- und Insolvenzberatung",[]]]],["schema:address",[[["cdf:addr-7545ba6e937e"],[]]]]]],["cdf:org-eba0c753c9bf",0,[],[["schema:name",[["Katholische Sozialstation St. Vinzenz Fellbach-Schmiden-Oeffingen",[]]]],["schema:email",[["tepfenhart@sozialstation-fellbach.de",[]]]],["schema:telephone",[["+49 (0711) 957906-20",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/93351",[]]]],["dct:modified",[["2025-08-20T19:07:37+00:00",[]]]],["schema:address",[[["cdf:addr-3e06dc99777a"],[]]]],["foaf:homepage",[["http://www.sozialstation-fellbach.de",[]]]],["schema:openingHours",[["Die Katholische Sozialstation St. Vinzenz ist zu den gewohnten Bürozeiten an Werktagen erreichbar, Mo - Fr von 8:00 bis 17:00 Uhr.\n\nPflegekunden können die Katholische Sozialstation St. Vinzenz an allen Tagen der Woche von 0:00 bis 24:00 Uhr erreichen.",[]]]],["schema:description",[["Die Katholische Sozialstation St. Vinzenz hat den Auftrag, Pflegebedürftige, die die Leistungen der Sozialstation in Anspruch nehmen, häuslich so zu versorgen, dass diese auf eigenen Wunsch bis ins hohe Alter in ihrem Zu Hause ein gesichertes Leben führen können.\n\nDabei setzt die Katholische Sozialstation St. Vinzenz sich dafür ein, dass die ihr anvertrauten Pflegebedürftigen, ein Höchstmaß an zeitgemäßer pflegerischer und medizinischer Versorgung in Verbindung mit einem Höchstmaß an Zufriedenheit erleben.\n\n Das Angebot erstreckt sich auf folgende Leistungen:\n\n1. Behandlungs- und Grundpflege,\n\n2. Spezielle Wundversorgung,\n\n3. Palliativpflege (Pflege von Schwerstkranken und Sterbenden),\n\n4. Nachbarschaftshilfe,\n\n5. Familienpflege,\n\n6. Hausnotruf,\n\n7. Beratung zu allen Hilfsmöglichkeiten,\n\n8. Unterstützung pflegender Angehöriger,\n\n9. Begleitung und Seelsorge.",[]]]]]],["cdf:org-eba4f5a042be",0,[],[["schema:name",[["Kath. Kindergarten Don Bosco",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/85923",[]]]],["dct:modified",[["2011-11-10T11:15:37+00:00",[]]]],["schema:address",[[["cdf:addr-a0130c8f830f"],[]]]]]],["cdf:org-eba6e59577f1",0,[],[["schema:name",[["Sozialstation St. Vitus Heidelberg-Nord und Dossenheim",[]]]],["schema:email",[["info@sozialstation-st-vitus.de",[]]]],["schema:telephone",[["+49 (06221) 480686",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/88209",[]]]],["dct:modified",[["2026-05-13T06:49:15+00:00",[]]]],["schema:address",[[["cdf:addr-30c3be3a529d"],[]]]],["foaf:homepage",[["http://sozialstation-st-vitus.de",[]]]],["schema:description",[["Angebot:\n\nDer Schwerpunkt unserer Arbeit liegt im Bereich der Grund- und Behandlungspflege.\n\nWeitergehende Angebote unserer Einrichtung sind:\n\nHauswirtschaftliche Leistungen:\n\nfest angestellte Mitarbeiter, zum Teil Fachkräfte, erledigen alle im Haushalt anfallenden Arbeiten nach Absprache.\n\nNachbarschaftshilfe:\n\nehrenamtlich engagierte Menschen besuchen alte und / oder kranke Mitbürger, sowie Menschen mit Behinderungen in ihrer Wohnung, lesen vor, machen Besorgungen, geben Hilfestellung beim Spazieren gehen, erledigen anfallende hauswirtschaftliche Arbeiten, nach den Wünschen der Klienten.\n\nGesprächskreis für Pflegende Angehörige:\n\nJeden 1.Dienstag im Monat findet zusammen mit dem Caritasverband, der Sozialstation HD-Süd und unserer Einrichtung ein Gesprächskreis mit wechselnden Themen statt.\n\nUnser Einzugsgebiet:\n\nWir betreuen Menschen in Ziegelhausen, Neuenheim, Handschuhsheim und in Dossenheim\n\nÖffnungszeiten:\n\nDas Büro ist werktags von 7:00-14:30 Uhr besetzt.\n\nAußerhalb dieser Zeiten ist ein Anrufbeantworter geschaltet, der regelmäßig abgehört wird. Bei pflegerischen Notfällen sind wir über Mobiltelefon rund um die Uhr erreichbar.",[]]]]]],["cdf:org-eba82aa94dc7",0,[],[["schema:name",[["Altentagesstätte St. Jakob",[]]]],["schema:telephone",[["08252-4445",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/1