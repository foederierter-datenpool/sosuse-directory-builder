dr-1bed847c3a1c"],[]]]],["dct:modified",[["2026-07-13T13:19:46+00:00",[]]]],["schema:alternateName",[["Allgemeine Soziale Beratung",[]]]],["foaf:homepage",[["http://www.caritas-eifel.de",[]]]],["schema:description",[["Caritasverband für die Region Eifel e. V. Allgemeine Sozialberatung",[]]]]]],["cdf:org-6891e5f0aca5",0,[],[["schema:name",[["Caritas Hort St. Ida",[]]]],["schema:email",[["kita-stida@caritas-hamm.de",[]]]],["schema:telephone",[["+49238175560",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/1852847",[]]]],["schema:address",[[["cdf:addr-18fafc856e6d"],[]]]],["dct:modified",[["2025-08-20T18:18:35+00:00",[]]]],["foaf:homepage",[["www.caritas-hamm.de",[]]]]]],["cdf:org-6899c1fa5181",0,[],[["schema:name",[["Jugend- und Drogenberatung",[]]]],["schema:email",[["caritaszentrum-dicker-busch@cv-offenbach.de",[]]]],["schema:telephone",[["+496142409670",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/88552",[]]]],["schema:address",[[["cdf:addr-2b643929216c"],[]]]],["dct:modified",[["2025-08-20T17:33:56+00:00",[]]]],["schema:alternateName",[["Caritaszentrum Dicker Busch Rüsselsheim",[]]]],["foaf:homepage",[["www.caritas-offenbach.de",[]]]],["schema:description",[["Einzugsbereich\n\nStadt Rüsselsheim, Kreis Groß-Gerau und Randgebiete\n\nBeratung und Behandlung von Drogenkonsumenten, Elternarbeit, Präventionsberatung, Schuldnerberatung, Vermittlung in Entgiftung und stationäre Therapie, Betreuung von Substituierten, Nachsorge und betreutes Wohnen, Hilfen bei der berufl. Wiedereingliederung",[]]]]]],["cdf:org-689cc714fef6",0,[],[["schema:name",[["Peiner Betreuungsverein e.V.",[]]]],["schema:email",[["info@peiner-btv.de",[]]]],["schema:telephone",[["+4951715081410",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/3300623",[]]]],["schema:address",[[["cdf:addr-9f698f7a737f"],[]]]],["dct:modified",[["2026-05-29T09:31:12+00:00",[]]]],["foaf:homepage",[["www.peiner-btv.de",[]]]],["schema:openingHours",[["Sprechrechzeiten:\nMo: 14:00\nErreichbarkeit:\n(Öffnngs- oder Sprechzeiten)\nMo: 14:0 – 17:00 Uhr\nDo: 09:30 – 11:00 Uhr\nund nach Vereinbarung",[]]]],["schema:description",[["Der Peiner Betreuungsverein e.V. ist ein caritativer Verein, der gemeinsam mit haupt- und ehrenamtlichen Mitarbeitern Menschen betreut, die aufgrund von Krankheit oder Behinderung nicht mehr in der Lage sind, ihre rechtlichen Angelegenheiten selbst zu erledigen. Diese Hilfen sind sehr umfangreich: z.B. bei diversen Anträgen, Hilfe bei der Organisation des Alltags und der Pflege, Verwaltung des Einkommens und des Vermögens. Bevor es zu dieser Hilfe kommt, muss das Vormundschaftsgericht diese Hilfe (Betreuung) anordnen.\n\nDer Betreuungsverein bietet auch Beratung zum Thema Vorsorgevollmachten und Patientenverfügungen an.\n\nSeit 2014 führt unser Verein Vormundschaften und Pflegeschaften für Minderjährige. Für Kinder und Jugendliche, die ohne Eltern nach Deutschland einreisen, die sogenannten UMA (unbegleitete minderjährige Ausländer) übernehmen wir im Landkreis Peine in der Regel alle Vormundschaften. Gerade in diesem Bereich helfen uns viele ehrenamtliche Vormünder.\n\nDie Ergänzende unabhängige Teilhabeberatung ist das neuste Projekt des Vereins und ist für Menschen mit Behinderungen oder von Behinderung bedrohte Menschen. Hierzu gibt es eine eigene Webseite: www.tip-eutb .de (man findet die Seite bei google kaum…)",[]]]]]]]