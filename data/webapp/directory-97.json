torstubb@caritas-frankfurt.de",[]]]],["schema:telephone",[["+49 (069) 2982-6200",[]],["+49 (069) 2982-6250",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/2804829",[]]]],["dct:modified",[["2025-08-20T17:22:22+00:00",[]]]],["schema:address",[[["cdf:addr-d56f7ea30010"],[]]]],["schema:alternateName",[["Lisbethtreff - Tagestreff für Frauen in bes. soz. Schwierigkeiten/Wohnungslose",[]]]],["foaf:homepage",[["http://www.caritas-frankfurt.de",[]]]],["schema:openingHours",[["Dienstag und Donnerstag 13:30 bis 16:30 Uhr",[]]]],["schema:description",[["Der Lisbethtreff ist ein Kooperationsprojekt der Wohnungslosenhilfe und der Frauenberatung des Caritasverbands Frankfurt e. V. Der Lisbethtreff bietet Raum zur Unterstützung der eigenständigen Lebensführung und Lebensplanung, zum Schutz vor Gewalt, zur Krisenbewältigung und zur Teilnahme am öffentlichen Leben.\n\nDer Lisbethtreff bietet folgende Möglichkeiten:\n\n * andere Frauen treffen\n * miteinander reden\n * sich ausruhen\n * lesen\n * Kaffee oder Tee trinken\n * Spiele spielen\n * Secondhand-Kleidung\n * Körperpflege\n * Wäschepflege\n * Vermittlung in die Frauenberatung und zu anderen Fachberatungsstellen auf Wunsch\n * Beratung in lebenspraktischen Fragen\n * Freizeit und Kulturangebote\n\nAnsprechpartner:\nAngelina Schmidt",[]]]]]],["cdf:org-520406a7f2f6",0,[],[["schema:name",[["Haus Nordpark Wohn- und Pflegehaus",[]]]],["schema:email",[["info@vinzenzgemeinschaft.de",[]]]],["schema:telephone",[["+49 (02131) 22809-0",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/87338",[]]]],["dct:modified",[["2023-02-23T07:49:51+00:00",[]]]],["schema:address",[[["cdf:addr-424bb4f90426"],[]]]],["foaf:homepage",[["www.vinzenzgemeinschaft.de",[]]]],["schema:description",[["Wohn- Und Pflegehaus Haus Nordpark",[]]]]]],["cdf:org-52056af10f83",0,[],[["schema:name",[["Kath. Kita St. Franziskus, Warburg",[]]]],["schema:email",[["st.franziskus.warburg@kath-kitas-hochstift.de",[]]]],["schema:telephone",[["+49 (05641) 7473373",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/2025015",[]]]],["dct:modified",[["2026-04-10T07:50:00+00:00",[]]]],["schema:address",[[["cdf:addr-2c263137a6dd"],[]]]],["schema:alternateName",[["Kath. Kindertageseinrichtung St. Franziskus ",[]]]],["foaf:homepage",[["www.kath-kitas-hochstift.de",[]]]]]],["cdf:org-520861f3640e",0,[],[["schema:name",[["Rheinisches Bildungszentrum für Berufe im Gesundheitswesen der Marienhaus GmbH - Neuwied",[]]]],["schema:email",[["info@rheinisches-bildungszentrum.de",[]]]],["schema:telephone",[["+49 (02631) 946810",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/89701",[]]]],["dct:modified",[["2025-08-20T19:20:35+00:00",[]]]],["schema:address",[[["cdf:addr-5466070ff869"],[]]]],["foaf:homepage",[["www.rheinisches-bildungszentrum.de",[]]]],["schema:description",[["Rheinisches Bildungszentrum für Berufe im Gesundheitswesen der Marienhaus GmbH - Neuwied\n\nQualität in der Pflege kann nur durch eine qualifizierte Ausbildung erreicht werden. Die ständigen Veränderungen im Gesundheitswesen erfordern Pflegekräfte, die Handlungskompetenz besitzen, flexibel auf Neuentwicklungen und berufliche Anforderungen reagieren und Verantwortung in einem multiprofessionellen Team übernehmen können. Fort- und Weiterbildungsmöglichkeiten in unserer Schule kennzeichnen darüber hinaus die Dynamik in einem abwechslungsreichen und spannenden Beruf. Den Menschen aller Altersstufen professionell zu erfassen - auch das ist eines unserer erklärten Ziele. Lehr- und Lernprozesse werden in unserem Bildungszentrum handlungsorientiert begleitet. Unterricht ist weiterhin Kopf-, Herz- und Handarbeit.\n\nIm Bereich der Aus, Fort- und Weiterbildung setzen wir ein umfassendes, transparentes Qualitätsmanagementsystem nach DIN EN ISO 9001: 2008 und AZWV um und gestalten einen kontinuierlichen Verbesserungsprozess, mit dessen Hilfe wir Bildungsqualität sichern und weiter entwickeln sowie die in unserem christlichen Leitbild verfassten Ziele umsetzen.\n\nDie Zukunft liegt auch in unseren Händen! Besuchen Sie unsere Homepage.",[]]]]]],["cdf:org-520a4eaf0277",0,[],[["schema:name",[["Christliches Klinikum Paderborn gGmbH",[]]]],["schema:email",[["info.ckp@bbtgruppe.de",[]]]],["schema:telephone",[["+49 (05251) 702-0",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/3076146",[]]]],["dct:modified",[["2025-07-24T07:01:25+00:00",[]]]],["schema:address",[[["cdf:addr-05351e0a0e08"],[]]]],["foaf:homepage",[["https://www.ck-paderborn.de",[]]]]]],["cdf:org-520ae0f32194",0,[],[["schema:name",[["Cusanus-Krankenhaus Bernkastel",[]]]],["schema:email",[["krankenpflegeschule-wil@t-online.de",[]]]],["schema:telephone",[["(06531) 58-279",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/100217",[]]]],["dct:modified",[["2009-08-19T13:36:39+00:00",[]]]],["schema:address",[[["cdf:addr-d1ab97ea3024"],[]]]],["schema:alternateName",[["Krankenpflegeschule\n",[]]]],["schema:description",[["Beruf: Krankenpflegehelfer/in\nUnterrichtsbeginn: Oktober\nAnmeldetermine: ganzjährig\nInternat oder Wohnheim vorhanden\nAbschluß: staatl. anerk. Krankenpflegehelfer/in\nPlätze: 20\n\nBeruf: Krankenschwester/pfleger\nUnterrichtsbeginn: Oktober\nAnmeldetermine: ganzjährig\nInternat oder Wohnheim vorhanden\nAbschluß: staatl. anerk. Krankenschwester/pfleger\nDauer: 3 Jahre\nPlätze: 60",[]]]]]],["cdf:org-520c860ab0f1",0,[],[["schema:name",[["Schuldnerberatung",[]]]],["schema:address",[[["cdf:addr-0e5585582f21"],[]]]]]],["cdf:org-520cd3103dfa",0,[],[["schema:name",[["Kath. Kindergarten St. Andreas",[]]]],["schema:email",[["kita.fronberg@bistum-regensburg.de",[]]]],["schema:telephone",[["+49 (09431) 2446",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/92899",[]]]],["dct:modified",[["2025-08-20T18:48:17+00:00",[]]]],["schema:address",[[["cdf:addr-c7ec20f8b64c"],[]]]],["schema:alternateName",[["Schwandorf",[]]]],["schema:description",[["Leitung: Carina Dorner",[]]]]]],["cdf: