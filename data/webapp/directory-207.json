ater-Kind-Kuren und von Mutter-Kuren.\n\nIhre Ansprechpartnerin:\n\nVivienne Machill",[]]]]]],["cdf:org-8dc9cdc6cf60",0,[],[["schema:name",[["Sozialdienst kath. Frauen e.V.",[]]]],["schema:email",[["skf@schwerterkirchen.de",[]]]],["schema:telephone",[["+49230416988",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/99076",[]]]],["schema:address",[[["cdf:addr-15dc728e8812"],[]]]],["dct:modified",[["2025-08-20T18:21:51+00:00",[]]]],["schema:alternateName",[["Spielstube",[]]]],["foaf:homepage",[["www.skf-schwerte.de",[]]]],["schema:description",[["Spielstube",[]]]]]],["cdf:org-8dca8cbd3df9",0,[],[["schema:name",[["Kath. Kirchenstiftung Maria Immaculata Oberwaldbach",[]]]],["schema:email",[["pg.jettingen-scheppach@bistum-augsburg.de",[]]]],["schema:telephone",[["+498225101451",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/87044",[]]]],["schema:address",[[["cdf:addr-444f78303f8d"],[]]]],["dct:modified",[["2023-09-25T10:03:34+00:00",[]]]]]],["cdf:org-8dcb10b20726",0,[],[["schema:name",[["Caritasverband Konstanz e.V.",[]]]],["schema:email",[["post@caritas-kn.de",[]]]],["schema:telephone",[["+49753112000",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/93227",[]]]],["schema:address",[[["cdf:addr-15d228634e5b"],[]]]],["dct:modified",[["2018-07-31T06:51:04+00:00",[]]]],["schema:alternateName",[["Caritaszentrum Konradihaus",[]]]],["foaf:homepage",[["http://www.caritas-kn.de",[]]]],["schema:description",[["Caritasverband Konstanz e.V.",[]]]]]],["cdf:org-8dcb470ef8fc",0,[],[["schema:name",[["Krankenhaus Mörsenbroich-Rath GmbH",[]]]],["schema:email",[["info@augusta-duesseldorf.de",[]]]],["schema:telephone",[["+4921190430",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/94009",[]]]],["schema:address",[[["cdf:addr-b90688fca169"],[]]]],["dct:modified",[["2021-03-01T14:00:03+00:00",[]]]],["foaf:homepage",[["http://www.vkkd-kliniken.de",[]]]],["schema:description",[["Krankenhaus Mörsenbroich-Rath Gmbh",[]]