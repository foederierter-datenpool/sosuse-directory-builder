ngHours",[["Mo - FR, 9.00- 16.00 Uhr",[]]]],["schema:availableService",[["Ambulante Beratung / Sucht- und Drogenberatung, Suchtberatung / -Prävention im Betrieb, Prävention an Schulen, Multiplikatorenschulungen, Beratung für Angehörige, Elternarbeit (Angebote für Eltern suchtkranker Kinder)",[]]]],["schema:accessibilitySummary",[["Die Einrichtung ist nicht barrierefrei erreichbar.",[]]]],["cdf:parentOrgClassification",[["Freie Wohlfahrtspflege / gemeinnütziger Träger",[]]]],["schema:audience",[["Alkohol, Tabak, Medikamenten, Illegalen Drogen, Problematischer Mediennutzung",[]]]]]],["cdf:org-0c40e3fee885",0,[],[["schema:name",[["Ambulante Dienste der Liebenau Teilhabe gemeinnützige GmbH",[]]]],["schema:telephone",[["+49731159399630",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/1025283",[]]]],["schema:address",[[["cdf:addr-7e28dfec3d14"],[]]]],["dct:modified",[["2017-05-23T14:54:05+00:00",[]]]]]],["cdf:org-0c4305dc2faf",0,[],[["schema:name",[["Malteser-Hilfsdienst e.V.",[]]]],["schema:telephone",[["+498161936990",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/87657",[]]]],["schema:address",[[["cdf:addr-514711dd6fd4"],[]]]],["dct:modified",[["2023-11-02T13:39:20+00:00",[]]]],["schema:alternateName",[["Fahrdienst f. Behinderte",[]]]],["schema:description",[["Malteser-Hilfsdienst e.V. Fahrdienst f. Behinderte",[]]]]]],["cdf:org-0c433859cef9",0,[],[["schema:name",[["Caritasverband Frankfurt e. V.",[]]]],["schema:email",[["casa21@caritas-frankfurt.de",[]]]],["schema:telephone",[["+496929823000",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/87813",[]]]],["schema:address",[[["cdf:addr-ce8ddc5cd1e9"],[]]]],["dct:modified",[["2025-08-26T06:12:28+00:00",[]]]],["schema:alternateName",[["CASA21 - Zentrum für Wohnungslose",[]]]],["foaf:homepage",[["http://www.caritas-frankfurt.de",[]]]],["schema:openingHours",[["Montag, Dienstag, Donnerstag und Freitag jeweils von 09:00 bis 12:00 Uhr\n",[]]]],["schema:description",[["Ansprechpersonen:\nKlaus Schäfer , Einrichtungsleiter\n\n\nBeratung und Begleitung\n\nWenn Probleme überhand nehmen, alles keinen Sinn mehr zu haben scheint und Sie nicht mehr weiter wissen, sind Sie bei uns richtig. Ob Konfliktsituationen oder akute Lebenskrisen: Wir nehmen uns Zeit für Sie und helfen bei der Entwicklung von neuen Lebensperspektiven. Und das bei uns im Zentrum oder durch Streetwork auf der Straße.\nIn unserem Zentrum für Wohnungslose CASA 21 finden Wohnungslose und von Wohnungslosigkeit bedrohte Menschen Unterstützung und Hilfe:\n\n * Beratung in finanziellen Angelegenheiten\n * Existenzsicherung, d. h. Sicherstellung der materiellen Grundversorgung\n * Integrierte Schuldnerberatung\n * Beratung zum Thema Alkohol / Sucht\n * Beratung zum Thema Freizeitgestaltung / Tagesstrukturierung\n * Verhinderung von Obdachlosigkeit: Sie haben Probleme mit Ihrer Wohnung? Sie können die Miete nicht mehr bezahlen oder haben gar schon die Kündigung erhalten? Wir helfen, den Erhalt der Wohnung zu sichern.\n * Hilfen rund um das Thema Arbeitslosigkeit / Arbeitssuche / Arbeitsaufnahme\n * Formulierungshilfen bei Anträgen und Schriftverkehr\n\n\nPRAKTISCHE HILFEN\n\n * Im erforderlichen Einzelfall: Hilfen bei der Geldeinteilung\n * Nutzung von Computern und der üblichen EDV\n\n\nPERSÖNLICHE BEGLEITUNG UND WEITERE HILFEANGEBOTE\n\n * Begleitung zu Behörden, Wohnungsgesellschaften etc. im erforderlichen Einzelfall.\n * Vermittlung zu anderen Fachdiensten (Schuldnerberatung, Beratung bei Insolvenz ...)\n * Wenn erforderlich, Vermittlung von \"Betreutem Wohnen\" nach Erhalt einer Wohnung\n * Besuche zu Hause, in der JVA und im Krankenhaus\n\nDie Arbeit erfolgt in enger Vernetzung mit anderen sozialen Diensten und städtischen Behörden. Das gemeinsame Ziel ist hierbei die Verbesserung der Lebenssituation wohnungsloser Menschen in Frankfurt am Main.\n\n\nWICHTIG\n\nEine Voraussetzung für eine Beratung ist die Verständigung. Ist diese (sprachlich) nicht gegeben, können wir wichtige Gespräche nicht führen und deshalb auch nicht professionell beraten.\n\n\nSTRASSENSOZIALARBEIT / AUFSUCHENDE SOZIALARBEIT\n\nUnser Team von Sozialarbeiterinnen und Sozialarbeitern sucht die Wohnungslosen auf der Straße, in den Parkanlagen, an den Kiosken und anderen einschlägig bekannten Treffpunkten auf. Wir sind regelmäßig in der Frankfurter Innenstadt und in den östlichen Stadtteilen, vor allem im Ostend, in Bornheim und im Riederwald unterwegs.\n\nDen Tagesaufenthalt in der Bärenstraße 1 und das dortige Umfeld besuchen wir mehrmals wöchentlich, außerdem die Treffpunkte an der Hauptwache, Konstablerwache, beim Franziskustreff und bei den Frühstückstreffs in der Josef- und Wartburggemeinde.",[]]]]]],["cdf:org-0c437258546f",0,[],[["schema:name",[["Katholische Kindertagesstätte St. Bonifatius",[]]]],["schema:email",[["kita.st.bonifatius-steinbach@kath-oberursel.de",[]]]],["schema:telephone",[["+49617173106",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/89771",[]]]],["schema:address",[[["cdf:addr-80a472f1ead5"],[]]]],["dct:modified",[["2025-08-20T17:20:17+00:00",[]]]],["schema:description",[["Katholische Kindertagesstätte St. Bonifatius",[]]]]]],["cdf:org-0c43921dbbe3",0,[],[["schema:name",[["Caritasverband für die Diözese Limburg e. V.",[]]]],["schema:email",[["info@dicv-limburg.de",[]]]],["schema:telephone",[["+4964319970",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/178385",[]]]],["schema:address",[[["cdf:addr-6d24640becde"],[]]]],["dct:modified",[["2020-07-02T07:16:51+00:00",[]]]],["schema:alternateName",[["Geschäftsstelle",[]]]],["foaf:homepage",[["http://www.dicv-limburg.de",[]]]],["schema:description",[["Caritasverband für die Diözese Limburg e. V.",[]]]]]],["cdf:org-0c44f6007558",0,[],[["schema:name",[["Caritasverband für den Schwarzwald-Baar-Kreis e. V.",[]]]],["schema:email",[["info@caritas-sbk.de",[]]]],["schema:telephone",[["+49772184070",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adres