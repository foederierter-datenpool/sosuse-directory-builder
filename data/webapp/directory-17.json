2",[]]]],["dct:modified",[["2025-06-06T11:58:04+00:00",[]]]],["schema:address",[[["cdf:addr-c960410b64a3"],[]]]],["schema:description",[["Kath. Kindergarten St. Hermann-Josef",[]]]]]],["cdf:org-0ee753e79926",0,[],[["schema:name",[["Kath. Kindertageseinrichtung St. Klara, Böschhof",[]]]],["schema:email",[["kita.stklara-duisburg@bistum-muenster.de",[]]]],["schema:telephone",[["+49 (02151) -407250",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/111089",[]]]],["dct:modified",[["2021-07-13T12:32:28+00:00",[]]]],["schema:address",[[["cdf:addr-8d81db00d13e"],[]]]],["schema:alternateName",[["St. Klara",[]]]]]],["cdf:org-0eea3d8b926f",0,[],[["schema:name",[["Caritasverband Westeifel e.V. Dienststelle Prüm",[]]]],["schema:email",[["Pruemer-Tafel@gmx.net",[]]]],["schema:telephone",[["+49 (06551) 960402",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/79260",[]]]],["dct:modified",[["2025-08-20T19:24:25+00:00",[]]]],["schema:address",[[["cdf:addr-591c4b4ce28f"],[]]]],["schema:alternateName",[["Tafel Prüm",[]]]],["foaf:homepage",[["http://www.caritas-westeifel.de",[]]]],["schema:openingHours",[["Büro: Freitag von 08.00 Uhr bis 14.00 Uhr\nAusgabe: Freitag von 11.00 Uhr bis 14.00 Uhr\n\n\nAußerhalb dieser Zeiten bitte die Dienststelle des Caritasverbandes in Prüm kontaktieren!",[]]]],["schema:description",[["PRÜMER TAFEL\n\nNicht alle Menschen haben ihr täglich Brot, obwohl es Lebensmittel im Überfluss gibt.\n\nIn der Prümer Tafel werden qualitativ einwandfreie Lebensmittel, die im Wirtschaftsprozeß nicht mehr verwendet werden können, an Bedürftige verteilt. Damit soll Menschen geholfen werden, eine schwierige Zeit zu überbrücken. Diese Hilfe versteht sich als Ergänzung zu den gesetzlichen Hilfen und den Angeboten anderen öffentlichen sozialen Einrichtungen.\n\nDie Abgabe der Lebensmittel durch die Prümer Tafel ist nachrangig und kann nur von Personen in Anspruch genommen werden, die eine Bedürftigkeit nachweisen können.\n\nDie am jeweiligen Ausgabetag verfügbaren Lebensmittel werden gleichmäßig aufgeteilt. Ein Anspruch auf bestimmte Lebensmittel besteht nicht.\n\nDie Abgabe erfolgt gegen eine symbolische Gebühr von 2,00 Euro je Haushalt, je Ausgabetag können Lebensmittel nur ein Mal abgeholt werden.\n\nDie Lebensmittelausgabe findet immer  freitags von 11.00 Uhr bis circa 14.00 Uhr statt.\n\nAnsprechpartner:\nKlaus Zeeh  Pruemer-Tafel@gmx.net         (freitags)\nJo Bach j.bach@caritas-westeifel.de (montags bis freitags)",[]]]]]],["cdf:org-0eed25d98773",0,[],[["schema:name",[["Guter Hirte Bocholt GmbH",[]]]],["schema:telephone",[["+49 (02871) 958-0",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/164335",[]]]],["dct:modified",[["2021-06-24T10:49:08+00:00",[]]]],["schema:address",[[["cdf:addr-9f62ffd71c17"],[]]]],["schema:alternateName",[["Kurzzeitpflege im Guten Hirten",[]]]],["foaf:homepage",[["http://www.guter-hirte-bocholt.de",[]]]]]],["cdf:org-0ef52c119273",0,[],[["schema:name",[["Schuldnerberatung Ribnitz-Damgarten",[]]]],["schema:address",[[["cdf:addr-996c1dfceaf7"],[]]]]]],["cdf:org-0ef6e4353c69",0,[],[["schema:name",[["Katholische Kindertagesstätte St. Martinus",[]]]],["schema:email",[["kita-st.martinus@abteigemeinden.de",[]]]],["schema:telephone",[["+49 (02238) /54721",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/76831",[]]]],["dct:modified",[["2023-08-29T09:07:38+00:00",[]]]],["schema:address",[[["cdf:addr-59a6ede4ed1e"],[]]]],["foaf:homepage",[["www.st-nikolaus.info",[]]]],["schema:description",[["Kath. Kindertagesstätte St. Martinus",[]]]]]],["cdf:org-0ef6f6aa7831",0,[],[["schema:name",[["Kath. Kindergarten St. Anna",[]]]],["schema:email",[["kiga-st-anna@web.de",[]]]],["schema:telephone",[["+49 (09656) 9140203",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/74382",[]]]],["dct:modified",[["2026-03-05T12:12:01+00:00",[]]]],["schema:address",[[["cdf:addr-0a19f46495b0"],[]]]],["schema:alternateName",[["Moosbach",[]]]]]],["cdf:org-0