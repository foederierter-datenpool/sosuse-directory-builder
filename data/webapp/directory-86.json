fication",[["Freie Wohlfahrtspflege / gemeinnütziger Träger",[]]]],["schema:audience",[["Alkohol, Illegalen Drogen",[]]]]]],["cdf:org-4909111f52cf",0,[],[["schema:name",[["Betreutes Wohnen",[]]]],["schema:telephone",[["07243515155",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/80566",[]]]],["dct:modified",[["2025-05-21T09:34:54+00:00",[]]]],["schema:address",[[["cdf:addr-9c7bd08539ad"],[]]]],["schema:alternateName",[["Haus Albgrün\n",[]]]]]],["cdf:org-490a2e6ee89b",0,[],[["schema:name",[["Integrative Kindertagesstätte Caritas-Haus",[]]]],["schema:email",[["kita-cederwald@caritas-rheinberg.de",[]]]],["schema:telephone",[["+49 (2202) 1008401",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/95066",[]]]],["dct:modified",[["2023-08-29T09:08:22+00:00",[]]]],["schema:address",[[["cdf:addr-c640cab0df7c"],[]]]],["schema:alternateName",[["FB Kinder-, Jugend- und Familienhilfe FD Kindertagesstätten",[]]]],["foaf:homepage",[["http://www.caritas-rheinberg.de",[]]]],["schema:description",[["Die Angebote der Kindertagesstätte sind sehr breit gefächert. Im Hinblick auf das „Life-Model“ von Germain und Gitterman wird individuell auf jedes Kind geschaut und entsprechend des vorhandenen Potentials, die Ressourcen für die Weiterentwicklung genutzt. So wird neben der Sprachtherapie, Motopädie und Krankengymnastik, viel Wert auf Bewegung und Kreativität sowie Selbständigkeit und Sozialkompetenz gelegt. Die Persönlichkeit jedes einzelnen Kindes hat einen großen Stellenwert!\nEin wichtiger Aspekt unserer Arbeit ist auch die Kooperation und Vernetzung mit anderen Institutionen. So arbeiten wir u.a. intensiv mit den hiesigen Grund – und Sonderschulen, der Erziehungsberatungsstelle, dem Frühförderzentrum, Kinderärzten und dem SPZ zusammen. Ebenso legen wir großen Wert darauf, uns für die Verbesserung der Perspektiven von Kindern einzusetzen. Daher nehmen wir regelmäßig an Gremien, Arbeitskreisen und Fortbildungen teil und bieten somit die bestmöglichste Unterstützung für Eltern und Kinder.",[]]]]]],["cdf:org-490a5b7bfd46",0,[],[["schema:name",[["Kath. Pfarramt St. Michael",[]]]],["schema:telephone",[["+49 (08652) 3682",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/81109",[]]]],["dct:modified",[["2018-03-11T19:12:05+00:00",[]]]],["schema:address",[[["cdf:addr-c3d1ca5ee973"],[]]]]]],["cdf:org-490afbf3bb51",0,[],[["schema:name",[["Caritas Kita St. Laurentius Denkhof",[]]]],["schema:email",[["kita.denkhof@caritas-passau.de",[]]]],["schema:telephone",[["+49 (08582) 8659",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/80637",[]]]],["dct:modified",[["2026-02-26T13:24:30+00:00",[]]]],["schema:address",[[["cdf:addr-52b35941ab6d"],[]]]],["foaf:homepage",[["https://www.caritas-kita-denkhof.de",[]]]],["schema:description",[["Caritas-Kita St. Laurentius Denkhof",[]]]]]],["cdf:org-490cb92d9a10",0,[],[["schema:name",[["Kath. Kirchengemeinde St. Petrus Herborn",[]]]],["schema:telephone",[["+49 (02772) 2509",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/109952",[]]]],["dct:modified",[["2018-03-11T18:27:51+00:00",[]]]],["schema:address",[[["cdf:addr-50b2c87e4a47"],[]]]]]],["cdf:org-490dc54bb9a9",0,[],[["schema:name",[["Frauenhaus",[]]]],["schema:telephone",[["(07461) 2066",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/80182",[]]]],["dct:modified",[["2009-08-19T13:44:33+00:00",[]]]],["schema:address",[[["cdf:addr-9f0f71461a25"],[]]]],["schema:description",[["Beratung und Schutz für Frauen in Krisensituationen",[]]]]]],["cdf:org-491455c221c9",0,[],[["schema:name",[["Kath. Kindergarten Arche Noah",[]]]],["schema:email",[["regenstauf@kita.bistum-regensburg.de",[]]]],["schema:telephone",[["+49 (09402) 4515",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/89818",[]]]],["dct:modified",[["2020-11-10T08:16:33+00:00",[]]]],["schema:address",[[["cdf:addr-5eaf702c544c"],[]]]],["schema:alternateName",[["Regenstauf",[]]]],["foaf:homepage"