name",[["SJG St. Paulus GmbH",[]]]],["schema:email",[["info@joho-dortmund.de",[]]]],["schema:telephone",[["+4923118430",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/92677",[]]]],["schema:address",[[["cdf:addr-da44877a4c14"],[]]]],["dct:modified",[["2021-08-16T13:27:09+00:00",[]]]],["schema:alternateName",[["Kranken-u.Pflegeeinrichtungen",[]]]],["foaf:homepage",[["www.st-johannes.de",[]]]],["schema:description",[["Kath.St. Johannes-Gesellschaft Dortmund gGmbH",[]]]]]],["cdf:org-106be40a1dda",0,[],[["schema:name",[["Caritasverband für die Diözese Augsburg e. V.",[]]]],["schema:email",[["Suchtfachambulanz.Donauwoerth.Zehenthof@caritas-augsburg.de",[]]]],["schema:telephone",[["+4990670595670",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/425198",[]]]],["schema:address",[[["cdf:addr-93ba51d17f74"],[]]]],["dct:modified",[["2026-07-08T10:10:03+00:00",[]]]],["schema:alternateName",[["Suchtfachambulanz Donauwörth",[]]]],["foaf:homepage",[["http://www.suchtfachambulanz-donauwoerth.de",[]]]],["schema:openingHours",[["Sprechzeiten:\nMontag bis Donnerstag:                    9:00 – 11:30 Uhr\nMontag, Dienstag, Donnerstag:       14:00 – 16:00 Uhr\nFreitag:                                               9:00 – 13:00 Uhr\n",[]]]],["schema:description",[["SUCHTBERATUNG UND -BEHANDLUNG IM LANDKREIS DONAU-RIES\n\n\nFÜR WEN SIND WIR DA?\n\nWir beraten Menschen bei Problemen im Zusammenhang mit:\n\n* Alkohol\n* illegalen Drogen\n* Tabak\n* Medikamenten\n* Essstörungen\n* Glücksspiel\n* Medien- und Computerspielsucht\n* anderen Suchtgefährdungen und Abhängigkeiten\n\nWir beraten auch\n\n* Angehörige\n* Verantwortliche und KollegInnen in Betrieben und Institutionen\n* FreundInnen und Bekannte.\n\nDer Konsum von Suchtmitteln kann zu unerwünschten Folgen führen:\n\n* soziale und berufliche Probleme\n* Gesundheitsschäden\n* Beziehungskonflikte\n* Unfälle und Konflikte mit dem Gesetz/der Justiz\n\nAuch andere Suchtverhaltensweisen (Spielsucht\netc.) können ähnliche Folgen hervorrufen.\n\n\nWAS BIETEN WIR?\n\nWir bieten\n\n* vertrauliche persönliche Gespräche\n* kostenfreie Beratung\n* geschultes Fachpersonal\n* ambulante Therapie\n\n\nUNSERE ANGEBOTE!\n\n* Allgemeine Informationen zum Thema Sucht\n* Beratungsgespräche (Einzel-, Paar-, Familien- und Angehörigenberatung)\n* Beratung bei Glückspielproblematik\n* Beratung für Substituierte\n* Elternberatung\n* Sprechstunden in Allgemein-Krankenhäusern\n* Informations- und Motivierungsgruppen\n* Vorbereitung auf und Vermittlung in eine ambulante bzw. stationäre Therapie/Rehabilitation\n* Unterstützung bei Kostenklärung und Reha-Antragsstellung\n* Ambulante Therapie / Rehabilitation\n* Ambulante Weiterbehandlung/Nachsorge\n\nWeitere Angebote\n\n* Onlineberatung/Gruppen- und Einzel-Chat (www.cafeconnection-donauwoerth.de )\n* „Switch“(Frühintervention für junge Drogenkonsumierer)\n* „Break“ (Frühintervention für alkoholauffällige Jugendliche)\n* Elternkreis (für Eltern drogenabhängiger Kinder)\n* Selbsthilfegruppe für GlücksspielerInnen\n* Tabakentwöhnung\n* externe Suchtberatung (Alkohol/Medikamente) JVA Kaisheim\n* Betriebliche Suchtprävention\n* Ambulante Therapie/Rehabilitation (Glückspielsucht)",[]]]]]],["cdf:org-106c42ef3752",0,[],[["schema:name",[["Caritasverband Kinzigtal e.V.",[]]]],["schema:email",[["info@caritas-kinzigtal.de",[]]]],["schema:telephone",[["+497832999550",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/88201",[]]]],["schema:address",[[["cdf:addr-c5a3e4dd0143"],[]]]],["dct:modified",[["2022-09-05T14:30:28+00:00",[]]]],["foaf:homepage",[["http://www.caritas-kinzigtal.de",[]]]],["schema:description",[["Ansprechpartner:\nDetlef Kappes",[]]]]]],["cdf:org-106d9b6e9166",0,[],[["schema:name",[["Wohngemeinschaft St. Hildegard Niederachdorf",[]]]],["schema:email",[["wg.niederachdorf@wg-st-hildegard.de",[]]]],["schema:telephone",[["+499482909350",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/283402",[]]]],["sche