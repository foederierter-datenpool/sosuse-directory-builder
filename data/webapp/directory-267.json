0:33+00:00",[]]]],["foaf:homepage",[["Waldwinkler Straße 1",[]]]]]],["cdf:org-b68b01c977a4",0,[],[["schema:name",[["Alten- und Pflegeheim Hospital zum Heiligen Geist",[]]]],["schema:email",[["hospitalverwaltung@st-johannes-mgh.drs.de",[]]]],["schema:telephone",[["+49793197200",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/96121",[]]]],["schema:address",[[["cdf:addr-a739a2fee68c"],[]]]],["dct:modified",[["2026-05-22T10:48:43+00:00",[]]]],["schema:alternateName",[["Das Hospital zum Hl. Geist weist eine lange Tradition aus, die bis ins 14. Jahrhundert zurückgeht. Das Haus gilt heute als die älteste, noch bestehende und von der Kirche karitative Einrichtung der Diözese Rottenburg-Stuttgart. Das Alten- und Pflegeheim Hospital zum Hl. Geist verfügt über 30 Einzelzimmer und liegt direkt im Herzen der Stadt Bad Mergentheim. Das Ziel der Einrichtung besteht darin, den Bewohnern eine ganzheitliche, individuelle und aktivierende Pflege zu bieten. Unsere qualifizierten und motivierten Fachkräfte gehen auf die persönlichen Wünsche und Bedürfnisse der Bewohner ein. Das Erhalten der Selbstbestimmung und Eigenverantwortlichkeit sehen wir als selbstverständlich an. Zur Unterstützung des Pflegepersonals bieten die Ehrenamtlichen Helferinnen regelmäßig Veranstaltungen und Vorträge sowie Gottesdienste in der hauseigenen Martinskapelle an. Alle Haupt- und Ehrenamtliche sind bestrebt, den Heimbewohnern mit vergnüglichen und auch besinnlichen Stunden den Aufenthalt abwechslungsreicher zu gestalten und die Bewohner in den letzten Jahren ihre Lebens ein Stück weit begleiten zu dürfen. Im Mittelpunkt: Der Mensch und seine persönliche Würde.",[]]]],["foaf:homepage",[["http://www.st-johannes-mgh.drs.de",[]]]],["schema:description",[["Das Hospital zum Hl. Geist weist eine lange Tradition aus, die bis ins 14. Jahrhundert zurückgeht. Das Haus gilt heute als die älteste, noch bestehende und von der Kirche karitative Einrichtung der Diözese Rottenburg-Stuttgart. Das Alten- und Pflegeheim Hospital zum Hl. geist verfügt über 44 Einzelzimmer und liegt direkt im Herzen der Stadt Bad Mergentheim.\n\nDas Ziel der Einrichtung besteht darin, den Bewohnern eine ganzheitliche, individuelle und aktivierende Pflege zu bieten. Unsere qualifizierten und motivierten Fachkräfte gehen auf die persönlichen Wünsche und Bedürfnisse der Bewohner ein. Das Erhalten der Selbstbestimmung und Eigenverantwortlichkeit sehen wir als selbstverständlich an.\n\nZur Unterstützung des Pflegepersonals bietet der Ehrenamtliche Helferkreis regelmäßig Veranstaltungen und Vorträge sowie Gottesdienste in der hauseigenen Martinskapelle an. Die Mitglieder des Ehrenamtlichen Helferkreises sind bestrebt, den Heimbewohnern mit vergnüglichen und auch besinnlichen Stunden den Aufenthalt abwechslungsreicher zu gestalten und die Bewohner in den letzten Jahren ihre Lebens ein Stück weit begleiten zu dürfen.\n\nIm Mittelpunkt: Der Mensch und seine persönliche Würde.",[]]]]]],["cdf:org-b68ccedc5e17",0,[],[["schema:name",[["Kath. Pfarramt St. Laurentius",[]]]],["schema:email",[["St-Laurentius.Ostermuenchen@erzbistum-muenchen.de",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/108015",[]]]],["schema:address",[[["cdf:addr-4ec5756bac09"],[]]]],["dct:modified",[["2018-03-11T19:10:32+00:00",[]]]],["foaf:homepage",[["www.pv-tuntenhausen-schoenau.de",[]]]]]],["cdf:org-b68df9e2c55a",0,[],[["schema:name",[["ProFutura Mol e.V. - Schuldnerberatung",[]]]],["schema:address",[[["cdf:addr-14dcfa22fd56"],[]]]]]],["cdf:org-b6926aa24eeb",0,[],[["schema:name",[["Kindergartenverein St. Pius Waldfenster e. V.",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/107448",[]]]],["schema:address",[[["cdf:addr-c1424e0b22ea"],[]]]],["dct:modified",[["2021-11-30T09:31:00+00:00",[]]]]]],["cdf:org-b6939ce65a3b",0,[],[["schema:name",[["Jugendsuchtberatung",[]]]],["schema:address",[[["cdf:addr-8fcc31450163"],[]]]]]],["cdf:org-b693c7174360",0,[],[["schema:name",[["Caritasverband für den