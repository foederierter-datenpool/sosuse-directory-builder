ema:description",[["Caritasverband für den Kreis Olpe e. V. Fachdienst Ambulant betreutes Wohnen",[]]]]]],["cdf:org-740999849efc",0,[],[["schema:name",[["Suchtfachambulanz Diakonie Donau-Ries",[]]]],["schema:email",[["suchtfachambulanz@diakonie-donauries.de",[]]]],["schema:telephone",[["+49 (9081) 29070-30 ",[]],["090812907030",[]]]],["schema:mainEntityOfPage",[["https://www.dhs.de/service/suchthilfeverzeichnis/?tx_wwdhseinrichtung2_fe1%5Baction%5D=show&tx_wwdhseinrichtung2_fe1%5Bcontroller%5D=Entry&tx_wwdhseinrichtung2_fe1%5Bentry%5D=5912&cHash=22824570f915ad1168da8716d53afe4a",[]]]],["dct:modified",[["2026-01-29T11:06:14+00:00",[]]]],["schema:address",[[["cdf:addr-ef10725b3591"],[]]]],["schema:alternateName",[["Suchtfachambulanz Nördlingen\nAußenstelle der Suchtfachambulanz Donauwörth\nDiakonie Donau-Ries gGmbH",[]]]],["foaf:homepage",[["https://www.diakonie-donauries.de/beratung-und-hilfe/suchtprobleme/",[]]]],["schema:category",[["Ambulante Einrichtung",[]]]],["schema:openingHours",[["Telefonische Sprechzeiten zur Terminvereinbarung: Mo: 14:00-16:00 Uhr Di. und Mi. 13:00-16:00 Uhr Do. und Fr. 09:00-12:00 Uhr Termine können flexibel vereinbart werden, auch Abendtermine möglich.",[]]]],["schema:availableService",[["Ambulante Beratung / Sucht- und Drogenberatung, Ambulante Behandlung, Kombibehandlung, Psychosoziale Betreuung Substituierter, Suchtberatung / -Prävention im Betrieb, Beratung für Angehörige",[]]]],["schema:accessibilitySummary",[["Die Einrichtung ist barrierefrei erreichbar.",[]]]],["cdf:parentOrgClassification",[["Freie Wohlfahrtspflege / gemeinnütziger Träger",[]]]],["schema:audience",[["Alkohol, Tabak, Cannabis, Medikamenten, Glücksspiel, Illegalen Drogen, Problematisches Essverhalten, Problematischer Mediennutzung",[]]]],["schema:description",[["SUCHTBERATUNG UND -BEHANDLUNG IM LANDKREIS DONAU-RIES\n\n\nFÜR WEN SIND WIR DA?\n\nWir beraten Menschen bei Problemen im Zusammenhang mit: \n\n * Alkohol \n * illegalen Drogen \n * Tabak \n * Medikamenten \n * Essstörungen \n * Glücksspiel \n * Medien- und Computerspielsucht \n * anderen Suchtgefährdungen und Abhängigkeiten\n\nWir beraten auch \n\n * Angehörige \n * Verantwortliche und KollegInnen in Betrieben und Institutionen \n * FreundInnen und Bekannte.\n\nDer Konsum von Suchtmitteln kann zu unerwünschten Folgen führen: \n\n * soziale und berufliche Probleme \n * Gesundheitsschäden \n * Beziehungskonflikte \n * Unfälle und Konflikte mit dem Gesetz/der Justiz\n\nAuch andere Suchtverhaltensweisen (Spielsucht\netc.) können ähnliche Folgen hervorrufen.\n\n\nWAS BIETEN WIR?\n\nWir bieten \n\n * vertrauliche persönliche Gespräche \n * kostenfreie Beratung \n * geschultes Fachpersonal \n * ambulante Therapie\n\n\nUNSERE ANGEBOTE! \n\n * Allgemeine Informationen zum Thema Sucht \n * Beratungsgespräche (Einzel-, Paar-, Familien- und Angehörigenberatung) \n * Beratung bei Glückspielproblematik \n * Beratung für Substituierte \n * Elternberatung \n * Sprechstunden in Allgemein-Krankenhäusern \n * Informations- und Motivierungsgruppen \n * Vorbereitung auf und Vermittlung in eine ambulante bzw. stationäre Therapie/Rehabilitation \n * Unterstützung bei Kostenklärung und Reha-Antragsstellung \n * Ambulante Therapie / Rehabilitation \n * Ambulante Weiterbehandlung/Nachsorge\n\nWeitere Angebote \n\n * Onlineberatung/Gruppen- und Einzel-Chat (www.cafeconnection-donauwoerth.de)\n * „Switch“(Frühintervention für junge Drogenkonsumierer) \n * „Break“ (Frühintervention für alkoholauffällige Jugendliche) \n * Elternkreis (für Eltern drogenabhängiger Kinder) \n * Selbsthilfegruppe für GlücksspielerInnen \n * Tabakentwöhnung \n * externe Suchtberatung (Alkohol/Medikamente) JVA Kaisheim \n * Betriebliche Suchtprävention \n * Ambulante Therapie/Rehabilitation (Glückspielsucht)",[]]]]]],["cdf:org-7409cce73f71",0,[],[["schema:name",[["Kindertagesstätte St. Andreas",[]]]],["schema:email",[["kiga.trauchgau@bistum-augsburg.de",[]]]],["schema:telephone",[["+49 (08368) 1057",[]]]],["schema:mainE