["schema:telephone",[["+49 (05964) 93100",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/83760",[]]]],["dct:modified",[["2018-03-16T11:25:57+00:00",[]]]],["schema:address",[[["cdf:addr-c9ed6217d945"],[]]]],["foaf:homepage",[["http://www.pfarreiengemeinschaft-miteinander.de",[]]]]]],["cdf:org-73d7c9a363b4",0,[],[["schema:name",[["Caritasverband für die Stadt Erlangen und den Landkreis Erlangen-Höchstadt/Aisch e.V.",[]]]],["schema:email",[["spdie@caritas-erlangen.de",[]]]],["schema:telephone",[["+49 (09131) 88560",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/95245",[]]]],["dct:modified",[["2025-08-20T09:15:58+00:00",[]]]],["schema:address",[[["cdf:addr-bd8799a2db93"],[]]]],["schema:alternateName",[["Sozialpsychiatrischer Dienst",[]]]],["foaf:homepage",[["https://caritas-erlangen.de",[]]]],["schema:openingHours",[["Beratungstermine nach telefonischer Vereinbarung.",[]]]],["schema:description",[["Wir stehen fest an der Seite von Menschen, die mit seelischen Herausforderungen konfrontiert sind. Aktuellen Studien zufolge beträgt das Risiko, im Laufe unseres Lebens mindestens einmal psychisch zu erkranken, etwa 80%. Psychische Störungen zählen zudem zu den häufigsten Ursachen für Krankschreibungen in Deutschland, und seelische Krisen sind eher die Regel als die Ausnahme in unserer Gesellschaft. Besonders ältere Menschen sehen sich vermehrt mit sozialer Isolation und Vereinsamung konfrontiert. Sowohl die Betroffenen selbst als auch ihr soziales Umfeld benötigen in solchen Situationen dringend Hilfe, Beratung und Unterstützung.\n\nUnser Grundsatz ist klar definiert: Wir bieten Beratung und Unterstützung für Personen mit psychischen Erkrankungen und psychosozialen Krisen. Dabei ist unser Angebot unabhängig von Konfession, Weltanschauung und sozialer Stellung unserer Klient*innen. Die Beratung erfolgt kostenfrei und vertraulich. Wir sind hier, um Sie auf Ihrem Weg zu begleiten und gemeinsam Lösungen zu finden.",[]]]]]],["cdf:org-73d8