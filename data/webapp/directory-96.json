lingen.de",[]]]],["schema:category",[["Ambulante Einrichtung",[]]]],["schema:availableService",[["Beratung für Angehörige, Niedrigschwellige Hilfen, Ambulante Beratung / Sucht- und Drogenberatung, Ambulante Behandlung, Kombibehandlung, Suchtberatung / -Prävention im Betrieb, Aufsuchende Suchthilfe",[]]]],["schema:accessibilitySummary",[["Die Einrichtung ist nicht barrierefrei erreichbar.",[]]]],["cdf:parentOrgClassification",[["Freie Wohlfahrtspflege / gemeinnütziger Träger",[]]]],["schema:audience",[["Alkohol, Medikamenten, Glücksspiel, Problematischer Mediennutzung",[]]]]]],["cdf:org-51a5a129e744",0,[],[["schema:name",[["Caritas regio gGmbH",[]]]],["schema:email",[["pflege.erlangen@caritas-regio.de",[]]]],["schema:telephone",[["+49 (09131) 12080",[]],["+49 (09131) 120890",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/111045",[]]]],["dct:modified",[["2025-08-20T09:15:17+00:00",[]]]],["schema:address",[[["cdf:addr-ea24d276be0a"],[]]]],["schema:alternateName",[["Ambulanter Pflegedienst Erlangen/Bubenreuth",[]]]],["foaf:homepage",[["https://caritas-erlangen.de",[]]]],["schema:description",[["Roncallistift – Ihrem Zuhause für betreutes Wohnen und Pflege. Das Sprichwort „Einen alten Baum verpflanzt man nicht“ spiegelt den tiefen Wunsch älterer Menschen wider, in ihrer vertrauten Umgebung zu bleiben. Mit dem Ambulanten Pflegedienst der Caritas unterstützen wir diesen Wunsch nachhaltig. Doch manchmal bedarf es mehr, sei es aufgrund unpassender Wohnverhältnisse oder intensiverer Versorgungsbedürfnisse.\n\nIm Roncallistift bieten wir Ihnen nicht nur eine Unterkunft, sondern eine liebevolle Heimat, in der Ihre Bedürfnisse im Mittelpunkt stehen. Inspiriert von Papst Johannes XXIII., der als „Konzilspapst“ bekannt war, steht er für Menschlichkeit und Erneuerung. Papst Johannes XXIII. war dafür bekannt, eine lebendige Gemeinschaft zu fördern und sich für das Wohl älterer Menschen einzusetzen. In ähnlicher Weise streben auch wir danach, eine lebendige Gemeinschaft zu schaffen, die sich der Fürsorge und dem Wohlergehen älterer Menschen verschrieben hat. Durch die Namensgebung möchten wir nicht nur an die historische Bedeutung erinnern, sondern auch eine Verpflichtung gegenüber unseren Bewohnern ausdrücken, ihre Lebensgeschichten fortzuschreiben und eine Atmosphäre der Geborgenheit zu schaffen.",[]]]]]],["cdf:org-51a949f820f4",0,[],[["schema:name",[["Kath. Kindergarten St. Nikolaus",[]]]],["schema:email",[["info@kath-kiga-gerbrunn.de",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/93593",[]]]],["dct:modified",[["2025-08-20T19:31:47+00:00",[]]]],["schema:address",[[["cdf:addr-376dafd29021"],[]]]],["foaf:homepage",[["https://www.kath-kiga-gerbrunn.de/",[]]]],["schema:description",[["geöffnet täglich A) 7.15 - 14.30 Uhr; B) 7.15 - 16.30 Uhr incl. Mittagessen; C) 7.15 - 12 u. 13.30 -16.30 Uhr",[]]]]]],["cdf:org-51ab6c40918f",0,[],[["schema:name",[["Caritasverband Frankfurt e. V.",[]]]],["schema:email",[["frankfurtmain@bahnhofsmission.de",[]]]],["schema:telephone",[["+49 (069) 234468",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/97429",[]]]],["dct:modified",[["2025-08-20T17:22:24+00:00",[]]]],["schema:address",[[["cdf:addr-7a9b15bde7c0"],[]]]],["schema:alternateName",[["Ökumenische Bahnhofsmission am Hauptbahnhof",[]]]],["foaf:homepage",[["http://www.caritas-frankfurt.de",[]]]],["schema:description",[["Hilfen für Reisende, Menschen unterwegs und/oder in Not\n\nBankverbindung:\nPostbank\nBankleitzahl: 50010060\nKonto: 103063 609\n\nSpendenkonto:\nPostbank\nBankleitzahl: 50010060\nKonto: 103063 609\nBahnhofsmission\n\nAnmerkung\nErstkontakt, Weitervermittlung, Infos",[]]]]]],["cdf:org-51ad2507aa28",0,[],[["schema:name",[["Unikathe Kita-Zweckverband im Bistum Mainz KdöR c/o Kath. Kita St. Alban, Bodenheim",[]]]],["schema:email",[["kitastalban@kath-bona.de",[]]]],["schema:telephone",[["+49 (06135) 3193",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/109084",[]]]],[