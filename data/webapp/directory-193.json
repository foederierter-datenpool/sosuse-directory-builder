,[["2023-01-18T11:29:12+00:00",[]]]]]],["cdf:org-8469ca37d223",0,[],[["schema:name",[["Sozialstation St. Martin Langenargen",[]]]],["schema:email",[["info@sozialstation-langenargen.de",[]]]],["schema:telephone",[["+4975431270",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/78160",[]]]],["schema:address",[[["cdf:addr-2f1df586e454"],[]]]],["dct:modified",[["2025-08-20T19:03:54+00:00",[]]]],["foaf:homepage",[["Klosterstr. 35",[]]]],["schema:description",[["Wir erbringen Leistungen für Menschen in deren häuslicher Umgebung und tragen damit wesentlich dazu bei, Lebensqualität und vertraute Umgebung so lange wie möglich zu erhalten.\n\nDas jeweilige Pflegeprogramm stellen wir individuell nach Ihren Bedürfnissen zusammen. Dabei lassen sich unterschiedliche  Leistungsmodule miteinander kombinieren - zum Beispiel die \"Grundpflege\", die Hauswirtschaftliche Versorgung\" und die\n\"Ärztlich verordnete Behandlungspflege\".\nTragende Säulen unseres Pflegekonzepts sind neben der konsequenten Patientenorientierung der enge Austausch mit Angehörigen und Bezugspersonen und die kontinuierliche Abstimmung mit Ärzten und Krankenhäusern.\n\nGerne beraten wir Sie eingehend in einem persönlichen Gespräch.\n\nDie Abrechnung der Leistungen erfolgt größtenteils über die jeweiligen Kranken- und/oder Pflegekassen.",[]]]]]]]