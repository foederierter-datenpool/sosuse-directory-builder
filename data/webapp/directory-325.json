und gGmbH (KJD)",[]]]],["schema:email",[["dialog@kjd.de",[]]]],["schema:telephone",[["+4923198320",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/84939",[]]]],["schema:address",[[["cdf:addr-51250858e721"],[]]]],["dct:modified",[["2024-03-27T07:19:39+00:00",[]]]],["foaf:homepage",[["https://kjd.de",[]]]],["schema:description",[["St. Vincenz Jugendhilfe-Zentrum e. V.",[]]]]]],["cdf:org-de9d821fee3f",0,[],[["schema:name",[["Kath. Kindertagesstätte St. Theresia",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/73328",[]]]],["schema:address",[[["cdf:addr-fa6441cada0d"],[]]]],["dct:modified",[["2011-11-10T11:14:19+00:00",[]]]]]],["cdf:org-de9e2fd02ea9",0,[],[["schema:name",[["Caritasverband für den Kreis Coesfeld e.V.",[]]]],["schema:email",[["erziehungsberatung.luedinghausen@caritas-coesfeld.de",[]]]],["schema:telephone",[["+4925912354230",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/93664",[]]]],["schema:address",[[["cdf:addr-0b95c6737de7"],[]]]],["dct:modified",[["2026-02-16T11:28:56+00:00",[]]]],["schema:alternateName",[["Beratungsstelle für Eltern, Kinder und Jugendliche",[]]]],["foaf:homepage",[["https://www.caritas-coesfeld.de/hilfen/kinderjugendundfamilie/beratungsstelle-fuer-eltern-kinder-und-jugendliche/beratungsstelle",[]]]],["schema:description",[["In jeder Familie gibt es Zeiten, in denen das Zusammenleben herausfordernd ist. Wir bieten Ihnen professionelle Unterstützung bei Fragen rund um Erziehung, Trennung und Scheidung sowie bei alltäglichen Problemen, die das Familienleben belasten können.\n\n\nUNSER ANGEBOT\n\nUnsere Beratungsstelle steht Eltern, Kindern, Jugendlichen und Bezugspersonen offen. Wir beraten professionell, vertraulich, kostenfrei und selbstverständlich unabhängig von Nationalität, Herkunft, Religion, Geschlecht oder sexueller Orientierung.\n\nIn vertrauensvoller Atmosphäre entwickeln wir gemeinsam mit Ihnen Ideen und Impulse zur Klärung Ihrer Situation, die individuell zu Ihrer Familie passen. Wir denken inklusiv.\n\nWir sind für Sie da, und das in Lüdinghausen, Coesfeld, Dülmen,  in den Familienzentren und im Ankerpunkt Dülmen.\n\nIn allen Einrichtungen erwarten Sie erfahrene Fachkräfte, die mit Ihnen gemeinsam nach einer Klärung für Ihr Thema suchen - individuell, ressourcenorientiert und mit viel Einfühlungsvermögen.",[]]]]]],["cdf:org-dea4634eabc9",0,[],[["schema:name",[["Kath. Kita-Verbund Mangfalltal Kath. Pfarramt Mariä Himmelfahrt",[]]]],["schema:email",[["Mariae-Himmelfahrt.Bad-Aibling@erzbistum-muenchen.de",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/108291",[]]]],["schema:address",[[["cdf:addr-bedf42369928"],[]]]],["dct:modified",[["2018-03-11T19:03:34+00:00",[]]]],["foaf:homepage",[["www.erzbistum-muenchen.de/stadtkirche-bad-aibling",[]]]]]],["cdf:org-dea4f85237cf",0,[],[["schema:name",[["Caritasverband Rhein-Hunsrück-Nahe e.V.",[]]]],["schema:email",[["Bad-Kreuznach@caritas-rhn.de",[]]]],["schema:telephone",[["+49671838280",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/76885",[]]]],["schema:address",[[["cdf:addr-b72bc6f559d4"],[]]]],["dct:modified",[["2025-08-20T19:21:33+00:00",[]]]],["schema:alternateName",[["Caritas-Geschäftsstelle Bad Kreuznach",[]]]],["foaf:homepage",[["www.caritas-rhn.de",[]]]],["schema:description",[["Caritasverband Rhein-Hunsrück-Nahe e. V. Geschäftsstelle Bad Kreuznach",[]]]]]],["cdf:org-dea6b16f413b",0,[],[["schema:name",[["Sozialpädagogische Familienhilfe",[]]]],["schema:email",[["info@caritas-kronach.de",[]],["spfh@caritas-kronach.de",[]]]],["schema:telephone",[["+499261605620",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/98597",[]]]],["schema:address",[[["cdf:addr-26f5302459c1"],[]]]],["dct:modified",[["2025-08-20T09:13:18+00:00",[]]]],["foaf:homepage",[["http://www.caritas-kronach.de",[]]]],["schema:description",[["Sozialpädagogische Familienhilfe",[]]]]]],["cdf:org-dea864fcf9a7",0,[],[["schema:name",[["Kath. Kindergarten St. Jo