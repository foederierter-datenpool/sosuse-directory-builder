",[["Katholischer Kindertagesstätte Marienheim",[]]]],["schema:email",[["kita.burgoberbach@bistum-eichstaett.de",[]]]],["schema:telephone",[["+49 (09805) 377",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/96673",[]]]],["dct:modified",[["2026-03-18T07:10:46+00:00",[]]]],["schema:address",[[["cdf:addr-b9cfb8cadb13"],[]]]],["foaf:homepage",[["www.kitas-afsn.de",[]]]],["schema:description",[["Aufnahme\nSeit September 2009 sind in unserer Einrichtung eine Kinderkrippe und zwei Regelgruppen untergebracht. Unsere Tagesstätte besuchen Kinder im Alter von einem Jahr bis sechs Jahren. Unsere Tagesstätte hat von Montag bis Donnerstag von 7.00 bis 16.00 Uhr geöffnet, freitags bis 15.00 Uhr.\n\nAngebote\nWährend der Freispielzeit haben wir offene Gruppen. Die Kinder können selbst entscheiden, wo und mit wem sie spielen. Unsere gezielten Beschäftigungen richten sich nach einem Jahresthema. Zusätzlich bieten wir eine musikalische Früherziehung, Vorschule und Projektgruppen an. Am Mittag bekommen die Kinder eine warme Mahlzeit, welche von einem Caterer aus Ansbach geliefert wird.\n\nAnsprechpartnerinnen\nKarin Neber (Leitung)",[]]]]]],["cdf:org-8eac209bb079",0,[],[["schema:name",[["Kath. Kita Arche Noah Simmerath",[]]]],["schema:email",[["kita-arche.noah-simmerath@bistum-aachen.de",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/81244",[]]]],["dct:modified",[["2025-06-06T11:56:48+00:00",[]]]],["schema:address",[[["cdf:addr-e1a9dd089a53"],[]]]],["foaf:homepage",[["www.profinos.de",[]]]],["schema:description",[["Kath. Kindergarten St. Johannes d. T.",[]]]]]],["cdf:org-8ead9b7565c4",0,[],[["schema:name",[["Hephata Hessisches Diakoniezentrum e.V.",[]]]],["schema:email",[["fk.weibersbrunn@hephata.de",[]]]],["schema:telephone",[["0609497150",[]]]],["schema:mainEntityOfPage",[["https://www.dhs.de/service/suchthilfeverzeichnis/?tx_wwdhseinrichtung2_fe1%5Baction%5D=show&tx_wwdhseinrichtung2_fe1%5Bcontroller%5D=Entry&tx_wwdhseinrichtung2_fe1%5Bentry%