ema:address",[[["cdf:addr-2e78725ad9bd"],[]]]],["foaf:homepage",[["www.invia-drs.de",[]]]],["schema:description",[["IN VIA Katholischer Verband für Mädchen- und Frauensozialarbeit Diözese Rottenburg-Stuttgart e.V. Kirchliche Bahnhofsmission in Aalen\n\nBahnhofsmissionen sind Anlauf- und Weitervermittelungsstellen für alle Hilfesuchenden, unabhängig von ihrem Alter, Herkunft, Geschlecht, Religion oder Weltanschauung.\n\nWir bieten anonyme, unbürokratische und praktische Hilfe: Ein- und Aussteigehilfen und Begleitung für mobilitätseingeschränkte Menschen, Auskunft zu Öffnungszeiten und Zuständigkeiten von Behörden und soziale Einrichtungen. Vermittlung an das soziale Hilfenetzwerk, Materielle und praktische Hilfen: ein Pflaster, ein Eisbeutel bei Verletzungen, eine Schnur für den kaputten Koffer, einen Knopf annähen, eine Windel …\n\nWir hören zu, trösten und suchen gemeinsam nach den nächsten Schritten. Wir machen Kirche am Bahnhof erfahrbar.",[]]]]]],["cdf:org-a78db8139d7b",0,[],[["schema:name",[["Kath. Kirchengemeinde St. Antonius",[]]]],["schema:email",[["info@st-antonius-papenburg.de",[]]]],["schema:telephone",[["+49 (04961) 9472-10",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/103583",[]]]],["dct:modified",[["2018-03-16T11:27:10+00:00",[]]]],["schema:address",[[["cdf:addr-fdef8a3b2b71"],[]]]],["foaf:homepage",[["http://www.st-antonius-papenburg.de",[]]]]]],["cdf:org-a790addc5f70",0,[],[["schema:name",[["Kath. Pfarramt Mariä Himmelfahrt",[]]]],["schema:email",[["PV-Obertaufkirchen@erzbistum-muenchen.de",[]]]],["schema:mainEntityOfPage",[["https://www.caritas.de/adressen/97692",[]]]],["dct:modified",[["2018-03-11T19:11:47+00:00",[]]]],["schema:address",[[["cdf:addr-e9385786755c"],[]]]],["foaf:homepage",[["www.pfarrverband-obertaufkirchen.de",[]]]]]],["cdf:org-a795ea1361bb",0,[],[["schema:name",[["Haus Regenbogen - Außerklinische Intensivpflege",[]]]],["schema:email",[["wachkoma-langzeitbeatmung.josef@caritas-dortmund.de",[]]]],["schema:telep