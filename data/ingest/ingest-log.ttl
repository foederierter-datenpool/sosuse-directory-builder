@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

:fetchSozialplattform a :Fetch, p-plan:Step ; :fromSource :sozialplattformSource .
:liftSozialplattform a :Lift, p-plan:Step ; :fromSource :sozialplattformSource ; p-plan:isPrecededBy :fetchSozialplattform .
:fetchAwo a :Fetch, p-plan:Step ; :fromSource :awoSource .
:liftAwo a :Lift, p-plan:Step ; :fromSource :awoSource ; p-plan:isPrecededBy :fetchAwo .
:fetchDestatis a :Fetch, p-plan:Step ; :fromSource :destatisSource .
:liftDestatis a :Lift, p-plan:Step ; :fromSource :destatisSource ; p-plan:isPrecededBy :fetchDestatis .
:fetchCaritas a :Fetch, p-plan:Step ; :fromSource :caritasSource .
:liftCaritas a :Lift, p-plan:Step ; :fromSource :caritasSource ; p-plan:isPrecededBy :fetchCaritas .
:fetchDhs a :Fetch, p-plan:Step ; :fromSource :dhsSource .
:liftDhs a :Lift, p-plan:Step ; :fromSource :dhsSource ; p-plan:isPrecededBy :fetchDhs .

