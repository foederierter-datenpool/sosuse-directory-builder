:liftAwo a :Lift, p-plan:Step ; :fromSource :awoSource ; p-plan:isPrecededBy :fetchAwo .
:liftDestatis a :Lift, p-plan:Step ; :fromSource :destatisSource ; p-plan:isPrecededBy :fetchDestatis .

