PREFIX xyz: <http://sparql.xyz/facade-x/data/>
PREFIX cdp: <https://civic-data.de/pipeline#>
PREFIX cdf: <https://civic-data.de/federated-directory#>
PREFIX schema: <http://schema.org/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX dct: <http://purl.org/dc/terms/>

INSERT {
    GRAPH <urn:mapped> {
        ?entity a <http://www.w3.org/ns/org#OrganizationalUnit> ; cdp:fromSource cdp:dhsSource .
        ?entity schema:availableService ?angebote .
        ?entity schema:availableService ?arbeit .
        ?entity schema:category ?art .
        ?entity schema:accessibilitySummary ?barrierefrei .
        ?entity schema:alternateName ?department .
        ?entity schema:mainEntityOfPage ?detailLink .
        ?entity schema:email ?email .
        ?entity schema:identifier ?entryId .
        ?entity schema:name ?name .
        ?entity schema:telephone ?telefon .
        ?entity cdf:parentOrgClassification ?traeger .
        ?entity foaf:homepage ?website .
        ?entity schema:openingHours ?zeiten .
        ?entity schema:audience ?zielgruppe .
    }
} WHERE {
    GRAPH <urn:source:dhs> {
        ?entity cdp:fromSource cdp:dhsSource .
        OPTIONAL { ?entity cdp:targetSchema ?_ts }
        FILTER(!bound(?_ts) || ?_ts = cdp:einrichtungSchema)
        OPTIONAL {
    { ?entity xyz:angebote ?angebote . FILTER(isLiteral(?angebote) && REPLACE(STR(?angebote), "\\s+", "") != "") }
    UNION
    { ?entity xyz:arbeit ?arbeit . FILTER(isLiteral(?arbeit) && REPLACE(STR(?arbeit), "\\s+", "") != "") }
    UNION
    { ?entity xyz:art ?art . FILTER(isLiteral(?art) && REPLACE(STR(?art), "\\s+", "") != "") }
    UNION
    { ?entity xyz:barrierefrei ?barrierefrei . FILTER(isLiteral(?barrierefrei) && REPLACE(STR(?barrierefrei), "\\s+", "") != "") }
    UNION
    { ?entity xyz:department ?department . FILTER(isLiteral(?department) && REPLACE(STR(?department), "\\s+", "") != "") }
    UNION
    { ?entity xyz:detailLink ?detailLink . FILTER(isLiteral(?detailLink) && REPLACE(STR(?detailLink), "\\s+", "") != "") }
    UNION
    { ?entity xyz:email ?email . FILTER(isLiteral(?email) && REPLACE(STR(?email), "\\s+", "") != "") }
    UNION
    { ?entity xyz:entryId ?entryId . FILTER(isLiteral(?entryId) && REPLACE(STR(?entryId), "\\s+", "") != "") }
    UNION
    { ?entity xyz:name ?name . FILTER(isLiteral(?name) && REPLACE(STR(?name), "\\s+", "") != "") }
    UNION
    { ?entity xyz:telefon ?telefon . FILTER(isLiteral(?telefon) && REPLACE(STR(?telefon), "\\s+", "") != "") }
    UNION
    { ?entity xyz:traeger ?traeger . FILTER(isLiteral(?traeger) && REPLACE(STR(?traeger), "\\s+", "") != "") }
    UNION
    { ?entity xyz:website ?website . FILTER(isLiteral(?website) && REPLACE(STR(?website), "\\s+", "") != "") }
    UNION
    { ?entity xyz:zeiten ?zeiten . FILTER(isLiteral(?zeiten) && REPLACE(STR(?zeiten), "\\s+", "") != "") }
    UNION
    { ?entity xyz:zielgruppe ?zielgruppe . FILTER(isLiteral(?zielgruppe) && REPLACE(STR(?zielgruppe), "\\s+", "") != "") }
  }
    }
}