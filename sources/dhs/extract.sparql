# Each compact lifted DHS page contains one entry. The canonical <link> carries
# its ID; the organisation's fields are inside <div class="entrylong">.

PREFIX rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xhtml: <http://www.w3.org/1999/xhtml#>
PREFIX html:  <https://html.spec.whatwg.org/#>
PREFIX xyz:   <http://sparql.xyz/facade-x/data/>
PREFIX cdp:   <https://civic-data.de/pipeline#>

CONSTRUCT {
    ?org cdp:fromSource   cdp:dhsSource ;
         cdp:targetSchema cdp:einrichtungSchema ;
         cdp:locatedAt    ?addr ;
         xyz:entryId      ?entryId ;
         xyz:detailLink   ?detailHref ;
         xyz:name         ?name ;
         xyz:department   ?department ;
         ?predicate       ?value .
    ?addr cdp:fromSource   cdp:dhsSource ;
          cdp:targetSchema cdp:adresseSchema ;
          cdp:matchString  ?adrNorm ;
          xyz:streetAddress   ?adrStreet ;
          xyz:postalCode      ?adrPlz ;
          xyz:addressLocality ?adrOrt .
} WHERE {
    ?link a xhtml:link ; xhtml:rel "canonical" ; xhtml:href ?detailHref .
    FILTER(CONTAINS(STR(?detailHref), "%5Bentry%5D="))
    BIND(STRBEFORE(STRAFTER(STR(?detailHref), "%5Bentry%5D="), "&") AS ?entryId)
    BIND(IRI(CONCAT(STR(cdp:), "dhs-", ?entryId)) AS ?org)

    ?entry a xhtml:div ; xhtml:class "entrylong" .

    OPTIONAL {
        ?h3 a xhtml:h3 ; html:innerText ?nameRaw .
        BIND(REPLACE(REPLACE(?nameRaw, "[\u00A0\\s]+", " "), "^ +| +$", "") AS ?name)
    }
    OPTIONAL {
        ?dep a xhtml:p ; xhtml:class "titelext" ; html:innerText ?departmentRaw .
        BIND(REPLACE(REPLACE(?departmentRaw, "[\u00A0\\s]+", " "), "^ +| +$", "") AS ?department)
    }
    {
        ?span a xhtml:span ; xhtml:class ?className ; html:innerText ?raw .
        FILTER(?className IN ("strasse", "plzort", "telefon", "email", "website"))
        BIND(IRI(CONCAT(STR(xyz:), ?className)) AS ?predicate)
        # Keep phone labels and separators for contact parsing in extract.js.
        BIND(REPLACE(REPLACE(?raw, "[\u00A0\\s]+", " "), "^ +| +$", "") AS ?clean)
        BIND(IF(?className = "telefon", ?raw,
             IF(?className = "email",   REPLACE(?clean, "\\(at\\)", "@"),
             ?clean)) AS ?value)
    }
    UNION
    {
        # Labelled <p class="…"><strong>Label</strong><br>value…</p> blocks.
        # innerText concatenates label and value with a space; strip the label.
        ?p a xhtml:p ; xhtml:class ?className ; html:innerText ?fullText .
        FILTER(?className IN ("art", "barrierefrei", "angebote", "zielgruppe", "zeiten", "traeger", "arbeit"))
        ?p rdf:_1 ?strong .
        ?strong a xhtml:strong ; html:innerText ?label .
        BIND(STRAFTER(?fullText, CONCAT(?label, " ")) AS ?value)
        FILTER(STRLEN(?value) > 0)
        BIND(IRI(CONCAT(STR(xyz:), ?className)) AS ?predicate)
    }

    # Address entity from the strasse + plzort spans — the only address extraction;
    # the org itself just links via cdp:locatedAt. Street is
    # whitespace-collapsed and Str. expanded for display, then lowercased /
    # diacritics folded / punctuation dropped onto cdp:matchString, the match
    # step's exact comparison surface. The IRI is content-addressed on
    # matchString + PLZ so formatting variants collapse onto one IRI.
    OPTIONAL {
        ?sSpan a xhtml:span ; xhtml:class "strasse" ; html:innerText ?strasseRaw .
        ?poSpan a xhtml:span ; xhtml:class "plzort" ; html:innerText ?plzort .
        FILTER(REGEX(?plzort, "^\\d{5} "))
        BIND(STRBEFORE(?plzort, " ") AS ?adrPlz)
        BIND(REPLACE(REPLACE(STRAFTER(?plzort, " "), "[\u00A0\\s]+", " "), "^ +| +$", "") AS ?adrOrt)
        BIND(REPLACE(REPLACE(REPLACE(STR(?strasseRaw), "[\u00A0\\s]+", " "), "([Ss])tr\\.\\s*", "$1traße "), "^ +| +$", "") AS ?adrStreetA)
        # Strasse → Straße (a standalone "straße" is capitalised, compounds like Bellermannstraße stay lower); house-number letter attached ("33 a" → "33a"), number
        # ranges canonicalised to hyphen ("5 - 11" → "5-11", "128/129" → "128-129") —
        # display only; matchString is invariant.
        BIND(REPLACE(REPLACE(REPLACE(REPLACE(?adrStreetA, "([Ss])trasse", "$1traße"), "(\\d+) ([a-zA-Z])$", "$1$2"), "(\\d) ?[-/] ?(\\d)", "$1-$2"), "(^|\\s)straße", "$1Straße") AS ?adrStreet0)
        BIND(IF(?adrStreet0 != "", ?adrStreet0, ?noAddr) AS ?adrStreet)
        BIND(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(LCASE(?adrStreet), "ä", "ae"), "ö", "oe"), "ü", "ue"), "ß", "ss"), "[^a-z0-9]", "") AS ?adrNorm)
        BIND(IRI(CONCAT(STR(cdp:), "dhs-addr-", SUBSTR(SHA1(CONCAT(?adrNorm, "|", ?adrPlz)), 1, 12))) AS ?addr)
    }
}
