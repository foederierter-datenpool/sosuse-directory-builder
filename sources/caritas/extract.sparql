# Keep the CariNet address GUID as the Caritas entity IRI. The API supplies
# structured address fields.

PREFIX xyz: <http://sparql.xyz/facade-x/data/>
PREFIX cdp: <https://civic-data.de/pipeline#>
PREFIX fx:  <http://sparql.xyz/facade-x/ns/>

CONSTRUCT {
    ?org ?p ?o ;
         xyz:detailUrl ?detailUrl .
    ?org cdp:fromSource   cdp:caritasSource ;
         cdp:targetSchema cdp:einrichtungSchema ;
         cdp:locatedAt    ?addr .
    ?addr cdp:fromSource   cdp:caritasSource ;
          cdp:targetSchema cdp:adresseSchema ;
          cdp:matchString  ?adrNorm ;
          xyz:streetAddress   ?adrStreet ;
          xyz:postalCode      ?adrPlz ;
          xyz:addressLocality ?adrOrt ;
          xyz:latitude        ?latitude ;
          xyz:longitude       ?longitude .
}
WHERE {
    ?orig xyz:id ?id ; ?p ?raw .
    FILTER NOT EXISTS { ?orig a fx:root }
    BIND(IF(isLiteral(?raw) && ?p IN (xyz:title, xyz:subTitle),
        REPLACE(REPLACE(STR(?raw), "[\u00A0\\s]+", " "), "^ +| +$", ""), ?raw) AS ?o)
    BIND(IRI(CONCAT(STR(cdp:), "caritas-", STR(?id))) AS ?org)
    OPTIONAL {
        ?orig xyz:number ?number .
        FILTER(REGEX(STR(?number), "^[0-9]+$"))
        BIND(CONCAT("https://www.caritas.de/adressen/", STR(?number)) AS ?detailUrl)
    }
    OPTIONAL {
        ?orig xyz:street ?street ; xyz:zipCode ?adrPlz ; xyz:city ?city .
        FILTER(STRLEN(STR(?street)) > 0 && REGEX(STR(?adrPlz), "^\\d{5}$") && STRLEN(STR(?city)) > 0)
        BIND(REPLACE(REPLACE(STR(?city), "[\u00A0\\s]+", " "), "^ +| +$", "") AS ?adrOrt)
        BIND(REPLACE(REPLACE(REPLACE(?street, "[\u00A0\\s]+", " "), "([Ss])tr\\.\\s*", "$1traße "), "^ +| +$", "") AS ?adrStreetA)
        BIND(REPLACE(REPLACE(REPLACE(REPLACE(?adrStreetA, "([Ss])trasse", "$1traße"), "(\\d+) ([a-zA-Z])$", "$1$2"), "(\\d) ?[-/] ?(\\d)", "$1-$2"), "(^|\\s)straße", "$1Straße") AS ?adrStreet)
        BIND(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(LCASE(?adrStreet), "ä", "ae"), "ö", "oe"), "ü", "ue"), "ß", "ss"), "[^a-z0-9]", "") AS ?adrNorm)
        BIND(IRI(CONCAT(STR(cdp:), "caritas-addr-", SUBSTR(SHA1(CONCAT(?adrNorm, "|", STR(?adrPlz))), 1, 12))) AS ?addr)
        OPTIONAL {
            ?orig xyz:geoCoordinate [ xyz:latitude ?latitude ; xyz:longitude ?longitude ] .
            FILTER(?latitude >= -90 && ?latitude <= 90 && ?longitude >= -180 && ?longitude <= 180 &&
                   (?latitude != 0 || ?longitude != 0))
        }
    }
}
