# Sozialplattform is an *offer-first* dataset: each row IS a counselling offer
# (→ a service) keyed by a stable xyz:offer_id, with the providing office merely
# denormalised onto the same row — the office has NO id of its own. So we split
# each row into two entities:
#   • the service  → cdp:sp-service-<offer_id>
#   • its office   → cdp:sp-org-<hash(office_title | office_address_short)>,
#     derived since the office is unidentified — identical offices across offers
#     thus collapse onto one org IRI (deduplication happens here, in extract).
# A single variable-predicate pattern routes each scalar by prefix: office_* →
# the org, offer_* → the service; the service links back via cdp:providedBy. The
# office_address sub-fields feed the address entity (cdp:locatedAt from the org
# only — an offer's place is its office's, so the service carries no address).
# Subjects are typed (cdp:targetSchema) so the map routes each to
# its schema. All string literals get NBSP/whitespace runs collapsed (the source
# has stray U+00A0, e.g. "Straße  18").

PREFIX xyz: <http://sparql.xyz/facade-x/data/>
PREFIX cdp: <https://civic-data.de/pipeline#>

CONSTRUCT {
    ?office  cdp:fromSource     cdp:sozialplattformSource ;
             cdp:targetSchema   cdp:einrichtungSchema ;
             cdp:locatedAt      ?addrEnt .
    # Raw office_address sub-fields kept on the office (unmapped, so they never
    # reach its output) purely so the preparation artifact can diff the address
    # derivation — address_line1 → streetAddress, … — against the cleaned address
    # entity it links to. The other sources emit their address origins flat like
    # this already; here they arrive via a nested path, so we surface them.
    ?office  xyz:address_line1  ?al1 ;
             xyz:postal_code    ?aplz ;
             xyz:locality       ?aloc ;
             xyz:country_code   ?acc .
    ?service cdp:fromSource     cdp:sozialplattformSource ;
             cdp:targetSchema   cdp:angebotSchema ;
             cdp:providedBy     ?office .
    ?subj ?fieldP ?fieldVal .
    ?addrEnt cdp:fromSource   cdp:sozialplattformSource ;
             cdp:targetSchema cdp:adresseSchema ;
             cdp:matchString  ?adrNorm ;
             xyz:streetAddress   ?adrStreet ;
             xyz:postalCode      ?addrPlz ;
             xyz:addressLocality ?addrLocality ;
             xyz:addressCountry  ?addrCountry .
}
WHERE {
    ?item xyz:offer_id ?offerIdRaw .
    BIND(IRI(CONCAT(STR(cdp:), "sp-service-", STR(?offerIdRaw))) AS ?service)

    # Office identity uses the whitespace-collapsed source title + short address,
    # before trimming display values. The source carries no office id.
    OPTIONAL { ?item xyz:office_title         ?otitleRaw }
    OPTIONAL { ?item xyz:office_address_short ?oaddrRaw }
    BIND(REPLACE(COALESCE(STR(?otitleRaw), ""), "[\u00A0\\s]+", " ") AS ?otitle)
    BIND(REPLACE(COALESCE(STR(?oaddrRaw), ""), "[\u00A0\\s]+", " ") AS ?oaddr)
    BIND(IRI(CONCAT(STR(cdp:), "sp-org-", SUBSTR(SHA1(CONCAT(?otitle, "|", ?oaddr)), 1, 12))) AS ?office)

    # Route each office_* / offer_* scalar to the org / service respectively. One
    # variable-predicate pattern (engines choke on several at once in a join).
    OPTIONAL {
        ?item ?fieldP ?fieldRaw .
        FILTER(isLiteral(?fieldRaw))
        BIND(STRSTARTS(STR(?fieldP), CONCAT(STR(xyz:), "office_")) AS ?isOffice)
        FILTER(?isOffice || STRSTARTS(STR(?fieldP), CONCAT(STR(xyz:), "offer_")))
        BIND(IF(?isOffice, ?office, ?service) AS ?subj)
        # office_phone \u2192 digits (keep a leading +) so separator variants of one number
        # collapse; every other scalar just gets its NBSP/whitespace runs collapsed.
        BIND(IF(?fieldP = xyz:office_phone,
                REPLACE(STR(?fieldRaw), "[^0-9+]", ""),
                STRDT(REPLACE(REPLACE(STR(?fieldRaw), "[\u00A0\\s]+", " "), "^ +| +$", ""), datatype(?fieldRaw))) AS ?fieldVal)
    }

    # office_address sub-fields, feeding the address entity below. Explicit
    # (single-valued) so they don't multiply the routing rows above.
    OPTIONAL { ?item xyz:office_address/xyz:address_line1 ?al1 . BIND(REPLACE(STR(?al1), "[\u00A0\\s]+", " ") AS ?addrLine1) }
    OPTIONAL { ?item xyz:office_address/xyz:postal_code   ?aplz . BIND(REPLACE(STR(?aplz), "[\u00A0\\s]+", " ") AS ?addrPlz) }
    OPTIONAL { ?item xyz:office_address/xyz:locality      ?aloc . BIND(REPLACE(REPLACE(STR(?aloc), "[\u00A0\\s]+", " "), "^ +| +$", "") AS ?addrLocality) }
    OPTIONAL { ?item xyz:office_address/xyz:country_code  ?acc  . BIND(REPLACE(REPLACE(STR(?acc),  "[\u00A0\\s]+", " "), "^ +| +$", "") AS ?addrCountry) }

    # Address entity: Str. expanded for display, then lowercased / diacritics folded /
    # punctuation dropped onto cdp:matchString, the match step's exact comparison
    # surface. The IRI is content-addressed on matchString + PLZ so formatting
    # variants collapse; a missing street or PLZ mints nothing (the IF picks the
    # never-bound ?noAddr / CONCAT errors on the unbound PLZ).
    BIND(REPLACE(REPLACE(?addrLine1, "([Ss])tr\\.\\s*", "$1traße "), "^ +| +$", "") AS ?adrStreetA)
    # Strasse → Straße (a standalone "straße" is capitalised, compounds like Bellermannstraße stay lower); house-number letter attached ("33 a" → "33a"), number
    # ranges canonicalised to hyphen ("5 - 11" → "5-11", "128/129" → "128-129") —
    # display only; matchString is invariant.
    BIND(REPLACE(REPLACE(REPLACE(REPLACE(?adrStreetA, "([Ss])trasse", "$1traße"), "(\\d+) ([a-zA-Z])$", "$1$2"), "(\\d) ?[-/] ?(\\d)", "$1-$2"), "(^|\\s)straße", "$1Straße") AS ?adrStreet0)
    BIND(IF(?adrStreet0 != "", ?adrStreet0, ?noAddr) AS ?adrStreet)
    BIND(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(LCASE(?adrStreet), "ä", "ae"), "ö", "oe"), "ü", "ue"), "ß", "ss"), "[^a-z0-9]", "") AS ?adrNorm)
    BIND(IRI(CONCAT(STR(cdp:), "sp-addr-", SUBSTR(SHA1(CONCAT(?adrNorm, "|", STR(?addrPlz))), 1, 12))) AS ?addrEnt)
}
