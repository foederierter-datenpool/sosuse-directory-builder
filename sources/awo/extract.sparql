# The fetcher merges AWO's source files into one document; org records carry
# xyz:type + xyz:id, so skolemizing each to cdp:awo-<id> unifies them. Copies the
# org's scalar literals (whitespace collapsed; isLiteral skips nested arrays and
# the facade-x null IRI), joins the org's address from the locations_filtered
# table on organisation_id (orgs without an assignment row of their own borrow
# their service's location instead), and links parent_id to the parent org's IRI via
# cdp:hasParent (the map step turns that into schema:parentOrganization, an
# entity link, the same way cdp:providedBy becomes schema:provider).
# Each element of the org's services[] also becomes its own entity
# (cdp:awo-service-<id>) linked back via cdp:providedBy. Extract stays in xyz:/cdp:
# vocabulary — no schema: yet; each subject instead carries cdp:targetSchema so
# the map routes it to its tier (where the schema: type is assigned): a Träger
# org → schema:Organization, an einrichtung → org:OrganizationalUnit,
# and each service → schema:Service. The org still folds in the first service's
# BAGFW category for now — that moves onto the service when the service mapping is wired.

PREFIX xyz: <http://sparql.xyz/facade-x/data/>
PREFIX cdp: <https://civic-data.de/pipeline#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

CONSTRUCT {
    ?org cdp:fromSource   cdp:awoSource ;
         cdp:targetSchema ?orgSchema ;
         ?p               ?scalar ;
         xyz:adresse      ?adresse ;
         xyz:plz          ?plz ;
         xyz:ort          ?ort ;
         xyz:ortsteil     ?ortsteil ;
         xyz:category     ?category ;
         cdp:hasParent    ?parentOrg ;
         cdp:locatedAt    ?addr, ?fbAddr .

    ?addr cdp:fromSource   cdp:awoSource ;
          cdp:targetSchema cdp:adresseSchema ;
          cdp:matchString  ?adrNorm ;
          xyz:locationId      ?locId ;
          xyz:streetAddress   ?adrStreet ;
          xyz:postalCode      ?plz ;
          xyz:addressLocality ?ort .

    ?svc cdp:fromSource     cdp:awoSource ;
         cdp:targetSchema   cdp:angebotSchema ;
         cdp:providedBy     ?org ;
         xyz:id             ?svcId ;
         xyz:bagfw_category ?svcBc ;
         xyz:areaServed     ?svcArea .
    ?svcBc xyz:nummer ?svcNum ;
           xyz:name   ?svcName .

    ?fbAddr cdp:fromSource   cdp:awoSource ;
            cdp:targetSchema cdp:adresseSchema ;
            cdp:matchString  ?fbNorm ;
            xyz:locationId      ?fbLocId ;
            xyz:streetAddress   ?fbStreet ;
            xyz:postalCode      ?fbPlz ;
            xyz:addressLocality ?fbOrt .
}
WHERE {
    ?node xyz:type ?type ; xyz:id ?id .
    BIND(IRI(CONCAT(STR(cdp:), "awo-", STR(?id))) AS ?org)
    # AWO is the one source with an explicit tree: type=traeger is the umbrella
    # org (→ schema:Organization), type=einrichtung the local facility
    # (→ org:OrganizationalUnit). Route each to its schema; services (below) hang
    # off both tiers, so their cdp:providedBy may point at either.
    BIND(IF(STR(?type) = "traeger", cdp:traegerSchema, cdp:einrichtungSchema) AS ?orgSchema)

    # The org's own scalar literals (id, name, name_zusatz, webseite, …), with
    # whitespace collapsed. isLiteral skips nested arrays and the xyz:null IRI.
    ?node ?p ?raw .
    FILTER(isLiteral(?raw))
    BIND(STRDT(REPLACE(REPLACE(STR(?raw), "[\u00A0\\s]+", " "), "^ +| +$", ""), datatype(?raw)) AS ?scalar)

    # Address from the locations_filtered table — an (org, location) assignment
    # table (the same location id recurs once per assigned org) — joined on
    # organisation_id. Orgs absent from it borrow their service's location via
    # the scoped fallback block below; services themselves never
    # carry addresses. plz+ort are always present on a location node and absent
    # on service nodes, so requiring them pins the join to a real location.
    OPTIONAL {
        ?locNode xyz:organisation_id ?id ;
                 xyz:plz              ?plz ;
                 xyz:ort              ?ortRaw .
        BIND(REPLACE(REPLACE(STR(?ortRaw), "[\u00A0\\s]+", " "), "^ +| +$", "") AS ?ort)
        OPTIONAL { ?locNode xyz:adresse  ?adresse }
        OPTIONAL { ?locNode xyz:ortsteil ?ortsteil }
        OPTIONAL { ?locNode xyz:id       ?locId }
        # Address entity: whitespace collapsed and Str. expanded for display, then
        # lowercased / diacritics folded / punctuation dropped onto cdp:matchString,
        # the match step's exact comparison surface. The IRI is content-addressed on
        # matchString + PLZ, so formatting variants collapse onto one IRI. An empty
        # street mints nothing: the IF picks the never-bound ?noAddr, erroring the
        # whole chain away.
        BIND(REPLACE(REPLACE(REPLACE(STR(?adresse), "[\u00A0\\s]+", " "), "([Ss])tr\\.\\s*", "$1traße "), "^ +| +$", "") AS ?adrStreetA)
        # Strasse → Straße (a standalone "straße" is capitalised, compounds like Bellermannstraße stay lower); house-number letter attached ("33 a" → "33a"), number
        # ranges canonicalised to hyphen ("5 - 11" → "5-11", "128/129" → "128-129") —
        # display only; matchString is invariant.
        BIND(REPLACE(REPLACE(REPLACE(REPLACE(?adrStreetA, "([Ss])trasse", "$1traße"), "(\\d+) ([a-zA-Z])$", "$1$2"), "(\\d) ?[-/] ?(\\d)", "$1-$2"), "(^|\\s)straße", "$1Straße") AS ?adrStreet0)
        BIND(IF(?adrStreet0 != "", ?adrStreet0, ?noAddr) AS ?adrStreet)
        BIND(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(LCASE(?adrStreet), "ä", "ae"), "ö", "oe"), "ü", "ue"), "ß", "ss"), "[^a-z0-9]", "") AS ?adrNorm)
        # Street-less locations (plz+ort only) still get an entity, keyed by the
        # native location id instead of a content hash — no matchString, so the
        # match step correctly never equates them with anything.
        BIND(COALESCE(
            IRI(CONCAT(STR(cdp:), "awo-addr-", SUBSTR(SHA1(CONCAT(?adrNorm, "|", STR(?plz))), 1, 12))),
            IRI(CONCAT(STR(cdp:), "awo-addr-loc", STR(?locId)))) AS ?addr)
    }

    OPTIONAL {
        ?node xyz:services/rdf:_1/xyz:bagfw_category ?cat .
        ?cat xyz:nummer ?cnum ; xyz:name ?cname .
        BIND(REPLACE(REPLACE(CONCAT(STR(?cnum), " ", STR(?cname)), "[\u00A0\\s]+", " "), "^ +| +$", "") AS ?category)
    }

    # One service entity per services[] element (rdf:_N container members): its
    # own id, the BAGFW category preserved as a nested node (nummer + name
    # subfields, not flattened), and the location resolved via location_id
    # against the locations table (its ort as area served).
    OPTIONAL {
        ?node xyz:services ?svcArr .
        ?svcArr ?svcMember ?svcNode .
        FILTER(STRSTARTS(STR(?svcMember), "http://www.w3.org/1999/02/22-rdf-syntax-ns#_"))
        ?svcNode xyz:id ?svcId .
        BIND(IRI(CONCAT(STR(cdp:), "awo-service-", STR(?svcId))) AS ?svc)
        OPTIONAL {
            ?svcNode xyz:bagfw_category ?svcBc .
            ?svcBc xyz:nummer ?svcNum ; xyz:name ?svcName .
        }
        # ort lives only on the full locations table row, not the skinny
        # location embedded in the service, so it pins to the right node.
        OPTIONAL {
            ?svcNode xyz:location_id ?svcLocId .
            ?svcLoc xyz:id ?svcLocId ; xyz:ort ?svcAreaRaw .
            BIND(REPLACE(REPLACE(STR(?svcAreaRaw), "[\u00A0\\s]+", " "), "^ +| +$", "") AS ?svcArea)
        }
    }

    # Fallback address for orgs with no assignment row of their own: borrow the
    # location their services point at (services themselves stay address-free;
    # directly-assigned orgs never bind here). A sibling block rather than one
    # nested in the services walk: ?id sits in the group, so the MINUS (sharing
    # only ?id) drops directly-assigned orgs and the left join correlates on
    # ?node/?id — a nested block loses that correlation bottom-up, and a
    # FILTER NOT EXISTS crashes Comunica's optional-hash join.
    OPTIONAL {
        ?node xyz:id ?id ;
              xyz:services ?fbArr .
        ?fbArr ?fbMember ?fbSvcNode .
        FILTER(STRSTARTS(STR(?fbMember), "http://www.w3.org/1999/02/22-rdf-syntax-ns#_"))
        ?fbSvcNode xyz:location_id ?fbLocId .
        ?fbLoc xyz:id ?fbLocId ; xyz:ort ?fbOrtRaw .
        BIND(REPLACE(REPLACE(STR(?fbOrtRaw), "[\u00A0\\s]+", " "), "^ +| +$", "") AS ?fbOrt)
        MINUS { [] xyz:organisation_id ?id ; xyz:plz [] ; xyz:ort [] }
        OPTIONAL { ?fbLoc xyz:plz     ?fbPlz     }
        OPTIONAL { ?fbLoc xyz:adresse ?fbAdresse }
        # Same address recipe as the org side — same street, same IRI.
        BIND(REPLACE(REPLACE(REPLACE(STR(?fbAdresse), "[\u00A0\\s]+", " "), "([Ss])tr\\.\\s*", "$1traße "), "^ +| +$", "") AS ?fbStreetA)
        # Strasse → Straße (a standalone "straße" is capitalised, compounds like Bellermannstraße stay lower); house-number letter attached ("33 a" → "33a"), number
        # ranges canonicalised to hyphen ("5 - 11" → "5-11", "128/129" → "128-129") —
        # display only; matchString is invariant.
        BIND(REPLACE(REPLACE(REPLACE(REPLACE(?fbStreetA, "([Ss])trasse", "$1traße"), "(\\d+) ([a-zA-Z])$", "$1$2"), "(\\d) ?[-/] ?(\\d)", "$1-$2"), "(^|\\s)straße", "$1Straße") AS ?fbStreet0)
        BIND(IF(?fbStreet0 != "", ?fbStreet0, ?noAddr) AS ?fbStreet)
        BIND(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(LCASE(?fbStreet), "ä", "ae"), "ö", "oe"), "ü", "ue"), "ß", "ss"), "[^a-z0-9]", "") AS ?fbNorm)
        BIND(COALESCE(
            IRI(CONCAT(STR(cdp:), "awo-addr-", SUBSTR(SHA1(CONCAT(?fbNorm, "|", STR(?fbPlz))), 1, 12))),
            IRI(CONCAT(STR(cdp:), "awo-addr-loc", STR(?fbLocId)))) AS ?fbAddr)
    }

    # Mint the parent's IRI straight from parent_id (same skolem as the org's
    # own ?id above), so einrichtung→Träger becomes an IRI link. The map step
    # only copies it to schema:parentOrganization when the parent is itself in
    # scope (i.e. carries cdp:targetSchema); out-of-scope parents drop there.
    OPTIONAL {
        ?node xyz:parent_id ?pid .
        BIND(IRI(CONCAT(STR(cdp:), "awo-", STR(?pid))) AS ?parentOrg)
    }
}
