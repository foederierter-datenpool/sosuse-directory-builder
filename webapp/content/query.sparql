PREFIX schema: <http://schema.org/>
PREFIX org: <http://www.w3.org/ns/org#>

# Input: a case-insensitive substring. This searches names, not service categories.
SELECT DISTINCT ?facility ?name ?postalCode ?locality WHERE {
  {
    SELECT ?facility ?name WHERE {
      VALUES ?search { "sucht" }
      ?facility a org:OrganizationalUnit ; schema:name ?name .
      FILTER(CONTAINS(LCASE(STR(?name)), LCASE(?search)))
    }
    ORDER BY LCASE(STR(?name)) ?facility
    LIMIT 20
  }
  OPTIONAL {
    ?facility schema:address ?address .
    OPTIONAL { ?address schema:postalCode ?postalCode }
    OPTIONAL { ?address schema:addressLocality ?locality }
  }
}
ORDER BY LCASE(STR(?name)) ?facility
LIMIT 20
